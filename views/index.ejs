<%- include('partials/header') %>
  <main class="main">

    <!-- Hero Section -->
    <section id="hero" class="hero section">

      <div class="hero-container">
        <div class="hero-content">
          <div class="content-wrapper" data-aos="fade-up" data-aos-delay="100">
            <h1 class="hero-title">Saúde natural com ciência e confiança</h1>
            <p class="hero-description">Conectando você ao bem-estar por meio de produtos naturais e tecnologia de ponta.</p>
            <div class="hero-actions" data-aos="fade-up" data-aos-delay="200">
                <a href="/" class="btn-primary">Compre Agora</a>
                <a href="/category" class="btn-secondary">Ver Categorias</a>
            </div>
            <div class="features-list" data-aos="fade-up" data-aos-delay="300">
              <div class="feature-item">
                <i class="bi bi-truck"></i>
                <span>Frete Grátis</span>
              </div>
              <div class="feature-item">
                <i class="bi bi-award"></i>
                <span>Garantia de Qualidade</span>
              </div>
              <div class="feature-item">
                <i class="bi bi-headset"></i>
                <span>24/7 Suporte</span>
              </div>
            </div>
          </div>
        </div>

        <div class="hero-visuals">
          <div class="product-showcase" data-aos="fade-left" data-aos-delay="200">
            <% if (hero) { %>
              <div class="product-card featured">
                <img src="<%= hero.thumb_url || hero.image_url %>" alt="<%= hero.name %>" class="img-fluid">
                <div class="product-badge"><%= hero.has_promo ? 'Em promoção' : 'Destaque' %></div>
                <div class="product-info">
                  <a href="/produtos/<%= hero.id %>"><h4><%= hero.name %></h4></a>
                  <div class="price">
                    <span class="sale-price">R$ <%= hero.promo_display || hero.price_display %></span>
                    <% if (hero.has_promo) { %>
                      <span class="original-price">R$ <%= hero.price_display %></span>
                    <% } %>
                  </div>
                </div>
              </div>
            <% } %>

            <div class="product-grid">
              <% (heroMini || []).forEach((p, idx) => { %>
                <div class="product-mini" data-aos="zoom-in" data-aos-delay="<%= 400 + (idx * 100) %>">
                  <a href="/produtos/<%= p.id %>"><img src="<%= p.thumb_url || p.image_url %>" alt="<%= p.name %>" class="img-fluid"></a>
                  <span class="mini-price">R$ <%= p.promo_display || p.price_display %></span>
                </div>
              <% }) %>
            </div>
          </div>

          <div class="floating-elements">
            <div class="floating-icon cart" data-aos="fade-up" data-aos-delay="600">
              <i class="bi bi-cart3"></i>
              <span class="notification-dot" data-cart-count><%= typeof cartItemCount !== 'undefined' ? cartItemCount : 0 %></span>
            </div>
            <div class="floating-icon wishlist" data-aos="fade-up" data-aos-delay="700">
              <i class="bi bi-heart"></i>
            </div>
            <div class="floating-icon search" data-aos="fade-up" data-aos-delay="800">
              <i class="bi bi-search"></i>
            </div>
          </div>
        </div>
      </div>

    </section><!-- /Hero Section -->

    <!-- Promo Cards Section -->
    <section id="promo-cards" class="promo-cards section">
      <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="row gy-4">

          <div class="col-lg-6">
            <div class="category-featured" data-aos="fade-right" data-aos-delay="200">
              <div class="category-image">
                <img src="<%= (featuredPromo && (featuredPromo.thumb_url || featuredPromo.image_url)) || '/assets/img/product/product-1.webp' %>" alt="<%= featuredPromo ? featuredPromo.name : 'Destaque NeoFarma' %>" class="img-fluid">
              </div>
              <div class="category-content">
                <span class="category-tag"><%= featuredPromo && featuredPromo.has_promo ? 'Oferta da Semana' : 'Tendencias Atuais' %></span>
                <h2><%= featuredPromo ? featuredPromo.name : 'Nova Linha Fitoterapica' %></h2>
                <p>
                  <% if (featuredPromo) { %>
                    <%= (featuredPromo.description || 'Produto selecionado com foco em qualidade, seguranca e bem-estar para o dia a dia.').slice(0, 180) %>
                  <% } else { %>
                    Descubra nossos produtos naturais desenvolvidos para o bem-estar e qualidade de vida.
                  <% } %>
                </p>
                <a href="<%= featuredPromo ? '/produtos/' + featuredPromo.id : '/produtos' %>" class="btn-shop">Explorar Produto <i class="bi bi-arrow-right"></i></a>
              </div>
            </div>
          </div>

          <div class="col-lg-6">

            <div class="row gy-4">

              <% (labHighlights || []).forEach((lab, idx) => { %>
                <div class="col-xl-6">
                  <div class="category-card cat-accessories" data-aos="fade-up" data-aos-delay="<%= 300 + (idx * 100) %>">
                    <div class="category-image">
                      <img src="<%= (lab.sample && (lab.sample.thumb_url || lab.sample.image_url)) || '/assets/img/product/product-1.webp' %>" alt="<%= lab.name %>" class="img-fluid">
                    </div>
                    <div class="category-content">
                      <h4><%= lab.name %></h4>
                      <p><%= lab.count %> produto<%= lab.count === 1 ? '' : 's' %></p>
                      <a href="/produtos?lab=<%= encodeURIComponent(lab.name) %>" class="card-link">Compre Agora <i class="bi bi-arrow-right"></i></a>
                    </div>
                  </div>
                </div>
              <% }) %>

            </div>
          </div>

        </div>

      </div>
    </section><!-- /Promo Cards Section -->

    <!-- Best Sellers Section -->
    <section id="best-sellers" class="best-sellers section">

      <!-- Section Title -->
      <div class="container section-title" data-aos="fade-up">
        <h2>Mais Vendidos</h2>
        <p>Descubra os produtos mais procurados para o seu bem-estar</p>
      </div><!-- End Section Title -->

      <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row g-5">
          <% (maisVendidos || []).forEach((p) => { %>
            <div class="col-lg-3 col-md-6">
              <div class="product-item">
                <div class="product-image">
                  <% if (p.has_promo) { %>
                    <div class="product-badge sale-badge">Promoção</div>
                  <% } else { %>
                    <div class="product-badge">POPULAR</div>
                  <% } %>
                  <img src="<%= p.thumb_url || p.image_url %>" alt="<%= p.name %>" class="img-fluid" loading="lazy">
                  <div class="product-actions">
                    <button class="action-btn wishlist-btn"><i class="bi bi-heart"></i></button>
                    <button class="action-btn compare-btn"><i class="bi bi-arrow-left-right"></i></button>
                    <button class="action-btn quickview-btn">
                      <a href="<%= p.image_url %>" class="glightbox"><i class="bi bi-zoom-in"></i></a>
                    </button>
                  </div>
                  <button class="cart-btn">Adicionar ao Carrinho</button>
                </div>
                <div class="product-info">
                  <div class="product-category"><%= p.laboratory_name || 'NeoFarma' %></div>
                  <h4 class="product-name"><a href="/produtos/<%= p.id %>"><%= p.name %></a></h4>
                  <div class="product-price">
                    <% if (p.has_promo) { %>
                      <span class="old-price">R$ <%= p.price_display %></span>
                      <span class="current-price">R$ <%= p.promo_display %></span>
                    <% } else { %>
                      R$ <%= p.price_display %>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>

      </div>

    </section><!-- /Best Sellers Section -->

    <!-- Cards Section -->
    <section id="cards" class="cards section">

      <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row gy-4">
          <div class="col-lg-4 col-md-6 mb-5 mb-md-0" data-aos="fade-up" data-aos-delay="200">
            <div class="product-category">
              <h3 class="category-title">
                <i class="bi bi-fire"></i> Popular
              </h3>
              <div class="product-list">
                <% (populares || []).forEach((p, idx) => { %>
                  <div class="product-card">
                    <div class="product-image">
                      <img src="<%= p.thumb_url || p.image_url %>" alt="<%= p.name %>" class="img-fluid">
                      <% if (idx === 0) { %><div class="product-badges"><span class="badge-new">Novidade</span></div><% } %>
                    </div>
                    <div class="product-info">
                      <a href="/produtos/<%= p.id %>"><h4 class="product-name"><%= p.name %></h4></a>
                      <div class="product-price"><span class="current-price">R$ <%= p.promo_display || p.price_display %></span></div>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>
          </div>

          <div class="col-lg-4 col-md-6 mb-5 mb-md-0" data-aos="fade-up" data-aos-delay="300">
            <div class="product-category">
              <h3 class="category-title">
                <i class="bi bi-award"></i> Mais Vendidos
              </h3>
              <div class="product-list">
                <% (maisVendidos || []).slice(0, 3).forEach((p) => { %>
                  <div class="product-card">
                    <div class="product-image">
                      <img src="<%= p.thumb_url || p.image_url %>" alt="<%= p.name %>" class="img-fluid">
                      <% if (p.has_promo) { %><div class="product-badges"><span class="badge-sale">Oferta</span></div><% } %>
                    </div>
                    <div class="product-info">
                      <a href="/produtos/<%= p.id %>"><h4 class="product-name"><%= p.name %></h4></a>
                      <div class="product-price">
                        <span class="current-price">R$ <%= p.promo_display || p.price_display %></span>
                        <% if (p.has_promo) { %><span class="old-price">R$ <%= p.price_display %></span><% } %>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>
          </div>

          <div class="col-lg-4 col-md-6 mb-5 mb-md-0" data-aos="fade-up" data-aos-delay="400">
            <div class="product-category">
              <h3 class="category-title">
                <i class="bi bi-star"></i> Novidades
              </h3>
              <div class="product-list">
                <% (novidades || []).forEach((p) => { %>
                  <div class="product-card">
                    <div class="product-image">
                      <img src="<%= p.thumb_url || p.image_url %>" alt="<%= p.name %>" class="img-fluid">
                    </div>
                    <div class="product-info">
                      <a href="/produtos/<%= p.id %>"><h4 class="product-name"><%= p.name %></h4></a>
                      <div class="product-price">
                        <span class="current-price">R$ <%= p.promo_display || p.price_display %></span>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>
          </div>
        </div>

      </div>

    </section><!-- /Cards Section -->

    <!-- Call To Action Section -->
    <section id="call-to-action" class="call-to-action section">

      <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row">
          <div class="col-lg-8 mx-auto">
            <div class="main-content text-center" data-aos="zoom-in" data-aos-delay="200">
              <div class="offer-badge" data-aos="fade-down" data-aos-delay="250">
                <span class="limited-time">Tempo Limitado</span>
                <span class="offer-text">50% OFF</span>
              </div>

              <h2 data-aos="fade-up" data-aos-delay="300">Promoção Flash Exclusiva</h2>

              <p class="subtitle" data-aos="fade-up" data-aos-delay="350">Não perca a nossa maior promoção do ano. Produtos de qualidade premium a preços imbatíveis, válidos apenas pelas próximas 48 horas.</p>

              <div class="countdown-wrapper" data-aos="fade-up" data-aos-delay="400">
                <div class="countdown d-flex justify-content-center" data-count="2025/12/31">
                  <div>
                    <h3 class="count-days"></h3>
                    <h4>Dias</h4>
                  </div>
                  <div>
                    <h3 class="count-hours"></h3>
                    <h4>Horas</h4>
                  </div>
                  <div>
                    <h3 class="count-minutes"></h3>
                    <h4>Minutos</h4>
                  </div>
                  <div>
                    <h3 class="count-seconds"></h3>
                    <h4>Segundos</h4>
                  </div>
                </div>
              </div>

              <div class="action-buttons" data-aos="fade-up" data-aos-delay="450">
                <a href="#" class="btn-shop-now">Comprar Agora</a>
                <a href="#" class="btn-view-deals">Ver todas as ofertas</a>
              </div>
            </div>
          </div>
        </div>

        <div class="row featured-products-row" data-aos="fade-up" data-aos-delay="500">
          <% (ofertas || []).forEach((p, idx) => { %>
            <div class="col-lg-3 col-md-6" data-aos="zoom-in" data-aos-delay="<%= 100 + (idx * 50) %>">
              <div class="product-showcase">
                <div class="product-image">
                  <img src="<%= p.thumb_url || p.image_url %>" alt="<%= p.name %>" class="img-fluid">
                  <% if (p.has_promo) { %><div class="discount-badge">Oferta</div><% } %>
                </div>
                <div class="product-details">
                  <a href="/produtos/<%= p.id %>"><h6><%= p.name %></h6></a>
                  <div class="price-section">
                    <% if (p.has_promo) { %>
                      <span class="original-price">R$ <%= p.price_display %></span>
                    <% } %>
                    <span class="sale-price">R$ <%= p.promo_display || p.price_display %></span>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>

      </div>

    </section><!-- /Call To Action Section -->

  </main>

<%- include('partials/footer') %>
