<%- include('partials/header') %>
<main class="main">
  <div class="page-title light-background">
    <div class="container d-lg-flex justify-content-between align-items-center">
      <h1 class="mb-2 mb-lg-0">Meus Agendamentos</h1>
      <nav class="breadcrumbs">
        <ol>
          <li><a href="/">Início</a></li>
          <li><a href="/account">Conta</a></li>
          <li class="current">Agendamentos</li>
        </ol>
      </nav>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Novo agendamento online</h4>
        <a href="/account" class="btn btn-outline-secondary btn-sm">Voltar à conta</a>
      </div>
      <div class="card p-3 mb-4">
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label">Modalidade</label>
            <select class="form-select" id="bk_modality">
              <option value="IN_STORE">Na farmácia</option>
              <option value="HOME">Em domicílio</option>
            </select>
          </div>
          <div class="col-md-8">
            <label class="form-label">Serviço</label>
            <select class="form-select" id="bk_service_id">
              <% (services || []).forEach(function(s){
                if (!s.in_store_available && !s.home_available) return;
              %>
                <option value="<%= s.id %>" data-in-store="<%= s.in_store_available ? 1 : 0 %>" data-home="<%= s.home_available ? 1 : 0 %>"><%= s.name %> - R$ <%= Number(s.price || 0).toFixed(2).replace('.', ',') %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label">Profissional</label>
            <select class="form-select" id="bk_professional_id">
              <% (professionals || []).forEach(function(p){ %>
                <option value="<%= p.id %>"><%= p.full_name %> - <%= p.role_name %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label">Pagamento</label>
            <select class="form-select" id="bk_payment_method">
              <option value="PIX">PIX</option>
              <option value="CREDIT_CARD">Cartão de crédito</option>
              <option value="DEBIT_CARD">Cartão de débito</option>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label">Data</label>
            <input id="bk_scheduled_date" type="date" class="form-control" min="<%= minBookingDate %>" max="<%= maxBookingDate %>">
          </div>
          <div class="col-md-8">
            <label class="form-label">Horário disponível</label>
            <div id="bk_slot_buttons" class="d-flex flex-wrap gap-1"></div>
            <div id="bk_slot_hint" class="small text-muted mt-1">Selecione serviço, profissional e data para ver os horários.</div>
            <input type="hidden" id="bk_scheduled_start">
          </div>

          <div id="bk_home_fields" class="col-12" style="display:none;">
            <div class="border rounded p-3 bg-light">
              <div class="fw-semibold mb-2">Endereço para atendimento em domicílio</div>
              <div class="row g-2">
                <div class="col-md-3">
                  <label class="form-label">CEP</label>
                  <input class="form-control" id="bk_zip_code" placeholder="00000-000" maxlength="9">
                </div>
                <div class="col-md-6">
                  <label class="form-label">Rua</label>
                  <input class="form-control" id="bk_street">
                </div>
                <div class="col-md-3">
                  <label class="form-label">Número</label>
                  <input class="form-control" id="bk_number">
                </div>
                <div class="col-md-4">
                  <label class="form-label">Complemento</label>
                  <input class="form-control" id="bk_complement">
                </div>
                <div class="col-md-4">
                  <label class="form-label">Bairro</label>
                  <input class="form-control" id="bk_district">
                </div>
                <div class="col-md-3">
                  <label class="form-label">Cidade</label>
                  <input class="form-control" id="bk_city">
                </div>
                <div class="col-md-1">
                  <label class="form-label">UF</label>
                  <input class="form-control text-uppercase" id="bk_state" maxlength="2">
                </div>
              </div>
            </div>
          </div>

          <div class="col-12">
            <button type="button" class="btn btn-primary" id="btnCriarAgendamento">Solicitar agendamento</button>
          </div>
        </div>
      </div>

      <h5 class="mb-2">Minhas solicitações</h5>
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead><tr><th>#</th><th>Serviço</th><th>Profissional</th><th>Quando</th><th>Pagamento</th><th>Status</th><th class="text-end">Ações</th></tr></thead>
          <tbody>
            <% (bookings || []).forEach(function(b){ %>
              <tr>
                <td><%= b.id %></td>
                <td><%= b.service_name %></td>
                <td><%= b.professional_name || '-' %></td>
                <td><%= fmtDateTime(b.scheduled_start) %></td>
                <td>
                  <%= t('paymentMethod', b.payment_method) %> /
                  <span class="badge <%= String(b.payment_status || '').toUpperCase() === 'PAID' ? 'bg-success' : (String(b.payment_status || '').toUpperCase() === 'FAILED' ? 'bg-danger' : 'bg-warning') %>">
                    <%= t('paymentStatus', b.payment_status) %>
                  </span>
                </td>
                <td><span class="badge bg-primary"><%= t('appointmentStatus', b.status) %></span></td>
                <td class="text-end">
                  <% const canPay = (String(b.status || '').toUpperCase() === 'RESERVED' || String(b.status || '').toUpperCase() === 'PAYMENT_FAILED') && String(b.payment_status || '').toUpperCase() !== 'PAID' && String(b.payment_method || '').toUpperCase() !== 'CASH'; %>
                  <% const canReceipt = (String(b.payment_status || '').toUpperCase() === 'PAID' || String(b.payment_status || '').toUpperCase() === 'REFUNDED_PARTIAL'); %>
                  <% if (canPay) { %>
                    <a class="btn btn-sm btn-success" href="/account/agendamentos/pagar/<%= b.id %>">Pagar</a>
                  <% } else if (canReceipt) { %>
                    <a class="btn btn-sm btn-outline-primary" href="/account/agendamentos/recibo/<%= b.id %>">Ver recibo</a>
                  <% } else { %>
                    <span class="text-muted small">-</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
            <% if (!bookings || !bookings.length) { %>
              <tr><td colspan="7" class="text-muted">Nenhum agendamento ainda.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</main>
<script src="/assets/js/appointment-scheduling.js"></script>
<script>
  function toast(msg, type) {
    const message = (msg == null ? '' : String(msg));
    const level = String(type || 'info').toLowerCase();
    try {
      if (typeof window.neofarmaToast === 'function') {
        window.neofarmaToast(message, level);
        return;
      }
    } catch (_) {}
    try {
      var host = document.getElementById('local_booking_feedback');
      if (!host) {
        host = document.createElement('div');
        host.id = 'local_booking_feedback';
        host.style.position = 'fixed';
        host.style.right = '16px';
        host.style.bottom = '16px';
        host.style.zIndex = '2000';
        host.style.display = 'flex';
        host.style.flexDirection = 'column';
        host.style.gap = '8px';
        document.body.appendChild(host);
      }
      var cssClass = 'alert-info';
      if (level === 'success') cssClass = 'alert-success';
      if (level === 'danger' || level === 'error') cssClass = 'alert-danger';
      if (level === 'warning') cssClass = 'alert-warning';
      var item = document.createElement('div');
      item.className = 'alert ' + cssClass;
      item.style.margin = '0';
      item.style.minWidth = '260px';
      item.style.maxWidth = '420px';
      item.textContent = message;
      host.appendChild(item);
      setTimeout(function () {
        if (item && item.parentNode) item.parentNode.removeChild(item);
      }, 4000);
    } catch (e) {
      console.log(level + ': ' + message);
      try { alert(message); } catch (_) {}
    }
  }

  function updateHomeFieldsVisibility() {
    var mod = document.getElementById('bk_modality');
    var wrap = document.getElementById('bk_home_fields');
    if (!mod || !wrap) return;
    wrap.style.display = String(mod.value || '').toUpperCase() === 'HOME' ? '' : 'none';
  }

  document.getElementById('bk_modality').addEventListener('change', updateHomeFieldsVisibility);
  updateHomeFieldsVisibility();

  var customerSlotPicker = null;
  if (window.NeofarmaAppointmentSlots) {
    customerSlotPicker = new window.NeofarmaAppointmentSlots.AppointmentSlotPicker({
      prefix: 'bk',
      slotsUrl: '/api/service-appointments/availability/slots',
      daysUrl: '/api/service-appointments/availability/days',
      servicesCatalog: <%- JSON.stringify(servicesCatalog || []) %>,
      minDate: '<%= minBookingDate %>',
      maxDate: '<%= maxBookingDate %>',
      holidayDates: <%- JSON.stringify((holidays || []).map(function(h){ return String(h.holiday_date).slice(0,10); })) %>,
      onToast: toast
    });
  }

  document.getElementById('btnCriarAgendamento').addEventListener('click', async function () {
    try {
      if (customerSlotPicker && !customerSlotPicker.validateBeforeSubmit()) return;

      const when = document.getElementById('bk_scheduled_start').value;
      const modality = document.getElementById('bk_modality').value;

      const payload = {
        service_id: document.getElementById('bk_service_id').value,
        professional_id: document.getElementById('bk_professional_id').value,
        modality: modality,
        payment_method: document.getElementById('bk_payment_method').value,
        scheduled_start: when
      };

      if (String(modality).toUpperCase() === 'HOME') {
        payload.zip_code = document.getElementById('bk_zip_code').value;
        payload.street = document.getElementById('bk_street').value;
        payload.number = document.getElementById('bk_number').value;
        payload.complement = document.getElementById('bk_complement').value;
        payload.district = document.getElementById('bk_district').value;
        payload.city = document.getElementById('bk_city').value;
        payload.state = document.getElementById('bk_state').value;
        const required = [payload.zip_code, payload.street, payload.number, payload.district, payload.city, payload.state];
        if (required.some(function (v) { return !String(v || '').trim(); })) {
          return toast('Preencha o endereço completo para atendimento em domicílio.', 'danger');
        }
      }

      const resp = await fetch('/api/service-appointments', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const raw = await resp.text();
      let data = {};
      try { data = raw ? JSON.parse(raw) : {}; } catch (_) { data = {}; }
      if (data.ok) {
        toast(data.message || 'Agendamento solicitado.', 'success');
        setTimeout(function(){ location.reload(); }, 800);
        return;
      }
      const code = data && data.code ? String(data.code) : '';
      const msg = (data && data.message) ? String(data.message) : ('Falha ao solicitar agendamento. (HTTP ' + resp.status + ')');
      toast(code ? ('[' + code + '] ' + msg) : msg, 'danger');
    } catch (e) {
      console.error('Falha ao criar agendamento:', e);
      toast('Erro de comunicação ao solicitar agendamento. Tente novamente.', 'danger');
    }
  });
</script>
<%- include('partials/footer') %>
