<%- include('partials/header') %>

<main class="main">

  <!-- Page Title -->
  <div class="page-title light-background">
    <div class="container d-lg-flex justify-content-between align-items-center">
      <h1 class="mb-2 mb-lg-0">Perguntas frequentes</h1>
      <nav class="breadcrumbs">
        <ol>
          <li><a href="/">Início</a></li>
          <li class="current">Perguntas frequentes</li>
        </ol>
      </nav>
    </div>
  </div><!-- End Page Title -->

  <!-- Faq Section -->
  <section id="faq" class="faq section">

    <div class="container" data-aos="fade-up" data-aos-delay="100">

      <div class="row gy-4 justify-content-between">
        <div class="col-lg-8">

          <div class="faq-list">
            <div class="faq-item faq-active" data-aos="fade-up" data-aos-delay="100">
              <h3>É seguro tomar este medicamento junto com outros?</h3>
              <div class="faq-content">
                <p>
                  Sim, mas sempre consulte o seu médico ou farmacêutico antes de combinar tratamentos.
                </p>
              </div>
              <i class="bi bi-plus faq-toggle"></i>
            </div><!-- End FAQ Item-->

            <div class="faq-item" data-aos="fade-up" data-aos-delay="200">
              <h3>Preciso de receita médica para comprar este remédio?</h3>
              <div class="faq-content">
                <p>
                 Alguns medicamentos exigem receita, outros não. A Neofarma informa no ato da compra se há necessidade.
                </p>
              </div>
              <i class="bi bi-plus faq-toggle"></i>
            </div><!-- End FAQ Item-->

            <div class="faq-item" data-aos="fade-up" data-aos-delay="300">
              <h3>Quais são as formas de pagamento aceitas?</h3>
              <div class="faq-content">
                <p>
                  Aceitamos cartão de crédito, débito, Pix e boleto bancário.
                </p>
              </div>
              <i class="bi bi-plus faq-toggle"></i>
            </div><!-- End FAQ Item-->

            <div class="faq-item" data-aos="fade-up" data-aos-delay="400">
              <h3>Vocês fazem entrega em domicílio?</h3>
              <div class="faq-content">
                <p>
                  Sim, realizamos entregas rápidas e seguras. Consulte a disponibilidade para sua região.
                </p>
              </div>
              <i class="bi bi-plus faq-toggle"></i>
            </div><!-- End FAQ Item-->

            <div class="faq-item" data-aos="fade-up" data-aos-delay="500">
              <h3>Como acompanho meu pedido?</h3>
              <div class="faq-content">
                <p>
                  Após a confirmação da compra, você receberá um código de rastreio para acompanhar sua entrega em tempo real.
                </p>
              </div>
              <i class="bi bi-plus faq-toggle"></i>
            </div><!-- End FAQ Item-->

          </div>

        </div>

        <div class="col-lg-4" data-aos="fade-up" data-aos-delay="200">
          <div class="faq-card">
            <i class="bi bi-chat-dots-fill"></i>
            <h3>Não encontrou a resposta para sua pergunta?</h3>
            <p>Nosso time de atendimento terá prazer em ajudar.</p>
            <a href="/contact" class="btn btn-primary">Entre em contato conosco!</a>
          </div>
        </div>
      </div>

    </div>

  </section><!-- /Faq Section -->

</main>

<%- include('partials/footer') %>
