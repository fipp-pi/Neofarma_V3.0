<%- include('partials/header') %>
<main class="main">
  <div class="page-title light-background">
    <div class="container d-lg-flex justify-content-between align-items-center">
      <h1 class="mb-2 mb-lg-0">Checkout</h1>
      <nav class="breadcrumbs"><ol><li><a href="/">Início</a></li><li class="current">Checkout</li></ol></nav>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="row g-4">
        <div class="col-lg-7">
          <form id="checkoutForm" class="border rounded p-3">
            <h5 class="mb-3">1. Endereço de entrega</h5>
            <div class="mb-3">
              <label class="form-label">Selecione um endereço cadastrado</label>
              <select class="form-select" name="address_id" required>
                <option value="">Selecione</option>
                <% addresses.forEach((a) => { %>
                  <option value="<%= a.address_id %>" <%= a.is_default ? 'selected' : '' %>>
                    <%= a.label || 'Endereço' %> - <%= a.street %>, <%= a.number %> - <%= a.city %>/<%= a.state %> - <%= a.zip_code %>
                  </option>
                <% }) %>
              </select>
              <% if (!addresses.length) { %>
                <div class="form-text text-danger">Nenhum endereço encontrado no perfil. Cadastre em Minha Conta antes de finalizar.</div>
              <% } %>
            </div>

            <div class="mb-3">
              <label class="form-label">CEP de entrega</label>
              <input class="form-control" name="cep" id="checkoutCep" value="<%= (cart.shipping && cart.shipping.cep) || '' %>" required>
              <div class="form-text">Usado para validar frete e prazo antes de finalizar.</div>
            </div>

            <div class="mb-4">
              <label class="form-label">Serviço de frete</label>
              <div id="shippingServices" class="small border rounded p-2">Clique em "Calcular frete" para carregar opções.</div>
              <button type="button" id="btnCalcShipping" class="btn btn-sm btn-outline-primary mt-2">Calcular frete</button>
            </div>

            <h5 class="mb-3">2. Pagamento</h5>
            <div class="mb-3">
              <label class="form-label">Método</label>
              <select class="form-select" name="payment_method" id="paymentMethod" required>
                <option value="PIX">Pix</option>
                <option value="CREDIT_CARD">Cartão de Crédito</option>
                <option value="BOLETO">Boleto Bancário</option>
              </select>
            </div>

            <div class="border rounded p-3 mb-3" id="paymentPreviewBox">
              <div class="small text-muted">
                A prévia do pagamento aparecerá aqui quando você selecionar <strong>Pix</strong> ou <strong>Boleto</strong>.
              </div>
            </div>

            <div id="creditFields" class="border rounded p-2 mb-3 d-none">
              <div class="mb-2">
                <label class="form-label">Número do cartão</label>
                <input class="form-control" name="card_number" id="cardNumber" placeholder="0000 0000 0000 0000">
              </div>
              <div class="mb-2">
                <label class="form-label">Parcelamento</label>
                <select class="form-select" name="installments">
                  <% installmentPlans.forEach((p) => { %>
                    <option value="<%= p.installments %>">
                      <%= p.installments %>x de R$ <%= p.installment_value.toFixed(2).replace('.', ',') %>
                      (total R$ <%= p.total_value.toFixed(2).replace('.', ',') %> | juros <%= p.interest_rate.toFixed(2).replace('.', ',') %>%)
                    </option>
                  <% }) %>
                </select>
              </div>
            </div>

            <h5 class="mb-3">3. Revisão</h5>
            <div class="form-check mb-3">
              <input class="form-check-input" type="checkbox" id="acceptTerms" required>
              <label class="form-check-label" for="acceptTerms">Confirmo os dados do pedido e termos.</label>
            </div>

            <button class="btn btn-primary w-100" type="submit">Finalizar pedido</button>
            <div id="checkoutMsg" class="small mt-2 text-muted"></div>
          </form>
        </div>

        <div class="col-lg-5">
          <div class="border rounded p-3">
            <h5>Resumo do pedido</h5>
            <div class="small text-muted mb-2"><%= cart.items.length %> item(ns)</div>
            <% cart.items.forEach((i) => { %>
              <div class="d-flex justify-content-between border-bottom py-2">
                <div><strong><%= i.name %></strong><br><small><%= i.quantity %> x R$ <%= i.unit_price.toFixed(2).replace('.', ',') %></small></div>
                <div>R$ <%= i.line_total.toFixed(2).replace('.', ',') %></div>
              </div>
            <% }) %>
            <div class="d-flex justify-content-between mt-3"><span>Subtotal</span><strong>R$ <%= cart.subtotal.toFixed(2).replace('.', ',') %></strong></div>
            <div class="d-flex justify-content-between"><span>Frete</span><strong id="shippingCostTxt">R$ <%= (cart.shipping ? Number(cart.shipping.price) : 0).toFixed(2).replace('.', ',') %></strong></div>
            <hr>
            <div class="d-flex justify-content-between"><span>Total</span><strong id="checkoutTotalTxt">R$ <%= cart.total.toFixed(2).replace('.', ',') %></strong></div>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>
<script>
  const paymentMethod = document.getElementById('paymentMethod');
  const creditFields = document.getElementById('creditFields');
  const shippingServicesEl = document.getElementById('shippingServices');
  const checkoutMsg = document.getElementById('checkoutMsg');
  const shippingCostTxt = document.getElementById('shippingCostTxt');
  const checkoutTotalTxt = document.getElementById('checkoutTotalTxt');
  const paymentPreviewBox = document.getElementById('paymentPreviewBox');
  const checkoutSubtotal = <%= Number(cart.subtotal || 0) %>;
  const initialShippingCode = '<%= (cart.shipping && cart.shipping.code) || '' %>';
  const initialShippingPrice = <%= Number((cart.shipping && cart.shipping.price) || 0) %>;
  let selectedShippingCode = initialShippingCode;
  let selectedShippingPrice = initialShippingPrice;

  function toBrl(value) {
    return `R$ ${Number(value || 0).toFixed(2).replace('.', ',')}`;
  }

  function refreshCheckoutTotals() {
    shippingCostTxt.textContent = toBrl(selectedShippingPrice);
    checkoutTotalTxt.textContent = toBrl(checkoutSubtotal + selectedShippingPrice);
  }

  async function copyToClipboard(text) {
    const str = String(text == null ? '' : text);
    try {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        await navigator.clipboard.writeText(str);
      } else {
        var ta = document.createElement('textarea');
        ta.value = str;
        ta.style.position = 'fixed';
        ta.style.left = '-9999px';
        ta.style.top = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      if (window.neofarmaToast) window.neofarmaToast('Copiado com sucesso.', 'success');
    } catch (_) {
      if (window.neofarmaToast) window.neofarmaToast('Não foi possível copiar.', 'danger');
    }
  }

  function setPaymentPreviewEmpty() {
    if (!paymentPreviewBox) return;
    paymentPreviewBox.innerHTML = '<div class="small text-muted">Selecione Pix ou Boleto para ver a prévia.</div>';
  }

  function renderPixPreview(payment) {
    if (!paymentPreviewBox) return;
    const qr = payment && payment.pix_qr_code ? String(payment.pix_qr_code) : '';
    const copyPaste = payment && payment.pix_copy_paste ? String(payment.pix_copy_paste) : '';
    paymentPreviewBox.innerHTML = `
      <div class="border rounded p-3 bg-light">
        <div class="small text-muted">
          O Pix será exibido na página de <strong>Pedido confirmado</strong>.
        </div>
      </div>
    `;
  }

  function calcLinhaDigitavelSimulada(boletoBarcode) {
    const raw = String(boletoBarcode || '');
    const digits = raw.replace(/\\D/g, '');
    const slice5 = (start) => digits.slice(start, start + 5);
    return [slice5(0), slice5(5), slice5(10), slice5(15), slice5(20), slice5(25), slice5(30), slice5(35)]
      .filter(Boolean)
      .join('.');
  }

  function renderBoletoPreview(payment) {
    if (!paymentPreviewBox) return;
    const barcode = payment && payment.boleto_barcode ? String(payment.boleto_barcode) : '';
    const dueDate = payment && payment.boleto_due_date ? String(payment.boleto_due_date) : '';
    const linha = calcLinhaDigitavelSimulada(barcode);

    paymentPreviewBox.innerHTML = `
      <div class="border rounded p-3 bg-light">
        <div class="small text-muted">
          O boleto será exibido na página de <strong>Pedido confirmado</strong>.
        </div>
      </div>
    `;
  }

  async function loadPaymentPreview() {
    try {
      if (!paymentPreviewBox) return;
      const method = paymentMethod.value;
      if (method !== 'PIX' && method !== 'BOLETO') {
        setPaymentPreviewEmpty();
        return;
      }

      const amount = checkoutSubtotal + selectedShippingPrice;
      if (!selectedShippingCode) {
        paymentPreviewBox.innerHTML = '<div class="small text-muted">Calcule o frete para gerar a prévia.</div>';
        return;
      }
      if (!amount || amount <= 0) {
        paymentPreviewBox.innerHTML = '<div class="small text-muted">Valor inválido para gerar a prévia.</div>';
        return;
      }

      paymentPreviewBox.innerHTML = '<div class="small text-muted">Gerando prévia do pagamento...</div>';

      const resp = await fetch('/api/checkout/payment-preview', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ payment_method: method, amount })
      });
      const data = await resp.json();

      if (!data || !data.ok || !data.payment) {
        paymentPreviewBox.innerHTML = '<div class="small text-danger">Não foi possível gerar a prévia.</div>';
        return;
      }

      if (method === 'PIX') renderPixPreview(data.payment);
      else renderBoletoPreview(data.payment);
    } catch (_) {
      setPaymentPreviewEmpty();
    }
  }

  async function persistShippingSelection(cep, serviceCode) {
    const resp = await fetch('/api/shipping/select', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ cep, service_code: serviceCode })
    });
    const data = await resp.json();
    return data;
  }

  function bindShippingRadioEvents(cep) {
    shippingServicesEl.querySelectorAll('input[name="shipping_service"]').forEach((radio) => {
      radio.addEventListener('change', async function () {
        selectedShippingCode = this.value;
        selectedShippingPrice = Number(this.dataset.price || 0);
        refreshCheckoutTotals();
        loadPaymentPreview();
        const data = await persistShippingSelection(cep, selectedShippingCode);
        if (!data.ok) {
          checkoutMsg.textContent = data.message || 'Falha ao salvar frete selecionado.';
        } else {
          checkoutMsg.textContent = '';
        }
      });
    });
  }

  function updatePaymentFields() {
    const isCredit = paymentMethod.value === 'CREDIT_CARD';
    creditFields.classList.toggle('d-none', !isCredit);
    const cardInput = document.getElementById('cardNumber');
    if (isCredit) cardInput.setAttribute('required', 'required');
    else cardInput.removeAttribute('required');
  }
  paymentMethod.addEventListener('change', function () {
    updatePaymentFields();
    loadPaymentPreview();
  });
  updatePaymentFields();
  refreshCheckoutTotals();
  loadPaymentPreview();

  document.addEventListener('click', function (ev) {
    var btn = ev.target && ev.target.closest ? ev.target.closest('.btn-copy-pix') : null;
    if (btn) {
      var box = btn.closest('#paymentPreviewBox');
      var codeEl = box ? box.querySelector('.pix-copy-paste-code') : null;
      if (!codeEl) return;
      copyToClipboard(codeEl.textContent || '');
      return;
    }

    btn = ev.target && ev.target.closest ? ev.target.closest('.btn-copy-boleto-linha') : null;
    if (btn) {
      var box2 = btn.closest('#paymentPreviewBox');
      var linhaEl = box2 ? box2.querySelector('.boleto-linha-digitavel-code') : null;
      if (!linhaEl) return;
      copyToClipboard(linhaEl.textContent || '');
    }
  });

  document.getElementById('btnCalcShipping').addEventListener('click', async () => {
    const cep = document.getElementById('checkoutCep').value.trim();
    const resp = await fetch('/api/shipping/quote', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ cep })
    });
    const data = await resp.json();
    if (!data.ok) {
      shippingServicesEl.textContent = data.message || 'Não foi possível calcular o frete.';
      return;
    }
    shippingServicesEl.innerHTML = data.quote.services.map((s) => {
      const checked = (selectedShippingCode && String(selectedShippingCode) === String(s.code)) ? 'checked' : '';
      return `<label class="d-block">
        <input type="radio" name="shipping_service" value="${s.code}" data-price="${s.price}" required ${checked}> ${s.label} - R$ ${s.price.toFixed(2).replace('.', ',')} (${s.deadlineDays} dias)
      </label>`;
    }).join('');
    bindShippingRadioEvents(cep);
    const selected = shippingServicesEl.querySelector('input[name="shipping_service"]:checked');
    if (selected) {
      selectedShippingCode = selected.value;
      selectedShippingPrice = Number(selected.dataset.price || 0);
      refreshCheckoutTotals();
      loadPaymentPreview();
    }
  });

  document.getElementById('checkoutForm').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const form = ev.currentTarget;
    const fd = new FormData(form);
    const payload = Object.fromEntries(fd.entries());
    const selectedShip = form.querySelector('input[name="shipping_service"]:checked');
    if (!selectedShip) {
      checkoutMsg.textContent = 'Selecione um serviço de frete.';
      return;
    }
    payload.shipping_service = selectedShip.value;
    checkoutMsg.textContent = 'Finalizando pedido...';
    const resp = await fetch('/api/checkout/finalize', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await resp.json();
    if (!data.ok) {
      checkoutMsg.textContent = data.message || 'Falha ao finalizar checkout.';
      return;
    }
    window.location.href = data.redirect;
  });
</script>
<%- include('partials/footer') %>
