<%- include(typeof useAdminLayout !== 'undefined' && useAdminLayout ? 'admin/partials/header' : 'partials/header') %>
<% if (typeof useAdminLayout === 'undefined' || !useAdminLayout) { %><main class="main main-container"><% } %>
  <div class="container">
    
    <div class="list-header">
      <div>
        <h2 class="neo-heading">Base de Clientes</h2>
        <p class="text-muted mb-0">Gerencie seus registros com facilidade.</p>
      </div>
      
      <div class="d-flex align-items-center gap-3">
        <button id="btnExcluirMassa" class="btn btn-danger d-none animate-fade" onclick="abrirModalExclusaoMassa()">
          <i class="bi bi-trash-fill me-2"></i>Excluir Selecionados (<span id="contadorSelecao">0</span>)
        </button>

        <div class="search-box">
          <i class="bi bi-search"></i>
          <input type="text" class="form-control" id="buscaInput" placeholder="Buscar..." onkeyup="filtrarTabela()">
        </div>
        
        <a href="/admin/clientes/novo" class="btn btn-success d-flex align-items-center">
          <i class="bi bi-plus-lg me-2"></i> Novo
        </a>
      </div>
    </div>

    <div class="table-container">
      <div class="table-responsive">
        <table class="table table-hover table-custom align-middle">
          <thead>
            <tr>
              <th style="width: 40px;">
                  <input type="checkbox" class="form-check-input" id="checkAll" onclick="alternarTodos(this)">
              </th>
              <th>Nome</th>
              <th>Email</th>
              <th>Telefone</th>
              <th>Cidade/UF</th>
              <th class="text-end">Ações</th>
            </tr>
          </thead>
          <tbody id="tabelaClientesBody">
            <% if (typeof clients !== 'undefined' && clients && clients.length) { %>
              <% clients.forEach(function(c) { %>
                <tr>
                  <td>
                    <input type="checkbox" class="form-check-input check-item" value="<%= c.customer_id %>" onclick="verificarSelecao()">
                  </td>
                  <td class="fw-bold"><%= c.full_name %></td>
                  <td><%= c.email %></td>
                  <td><%= c.phone || '-' %></td>
                  <td><%= (c.city || '-') + '/' + (c.state || '-') %></td>
                  <td class="text-end">
                    <button class="btn-action btn-view" onclick="verDetalhes(<%= c.customer_id %>)" title="Ver Detalhes"><i class="bi bi-eye"></i></button>
                    <button class="btn-action btn-edit" onclick="prepararEdicao(<%= c.customer_id %>)" title="Editar"><i class="bi bi-pencil"></i></button>
                  </td>
                </tr>
              <% }); %>
            <% } %>
            </tbody>
        </table>
      </div>
      
      <div id="mensagemVazia" class="text-center py-5" style="display: <%= (typeof clients !== 'undefined' && clients && clients.length === 0) ? 'block' : 'none' %>;">
        <i class="bi bi-folder2-open text-muted" style="font-size: 3rem;"></i>
        <p class="text-muted mt-2">Nenhum cliente encontrado.</p>
        <a href="/admin/clientes/novo" class="btn btn-outline-success btn-sm mt-2">Cadastrar Primeiro Cliente</a>
      </div>
    </div>

  </div>

  <style>
    /* Modais Cliente - Visualizar e Editar */
    .modal-clientes .modal-content { border: none; border-radius: 12px; box-shadow: 0 12px 40px rgba(0,0,0,0.15); overflow: hidden; }
    .modal-clientes .modal-header { background: var(--accent-color); color: var(--contrast-color); padding: 1rem 1.25rem; border-bottom: none; }
    .modal-clientes .modal-header .modal-title { font-weight: 600; font-size: 1.1rem; }
    .modal-clientes .modal-header .btn-close { filter: brightness(0) invert(1); opacity: 0.9; }
    .modal-clientes .modal-body { padding: 0; }
    .modal-clientes .modal-footer { padding: 1rem 1.25rem; border-top: 1px solid rgba(0,0,0,0.06); background: #fafafa; }
    /* Visualizar: conteúdo */
    .cliente-view { padding: 1.5rem 1.5rem 1.25rem; }
    .cliente-view-avatar { width: 56px; height: 56px; border-radius: 50%; background: color-mix(in srgb, var(--accent-color), transparent 88%); color: var(--accent-color); font-size: 1.4rem; font-weight: 700; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem; }
    .cliente-view-nome { font-size: 1.25rem; font-weight: 600; color: var(--heading-color); margin-bottom: 1.25rem; }
    .cliente-view-section { margin-bottom: 1.25rem; }
    .cliente-view-section:last-child { margin-bottom: 0; }
    .cliente-view-section-title { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--accent-color); margin-bottom: 0.6rem; }
    .cliente-view-row { display: flex; padding: 0.5rem 0; border-bottom: 1px solid rgba(0,0,0,0.06); align-items: baseline; gap: 0.75rem; }
    .cliente-view-row:last-child { border-bottom: none; }
    .cliente-view-label { font-size: 0.85rem; color: #6c757d; min-width: 110px; flex-shrink: 0; }
    .cliente-view-value { font-size: 0.95rem; color: #212529; font-weight: 500; }
    .cliente-view-value i { color: var(--accent-color); margin-right: 0.35rem; width: 1.1em; }
    /* Editar: formulário */
    .cliente-edit { padding: 1.5rem 1.5rem 1.25rem; }
    .cliente-edit-section { margin-bottom: 1.5rem; }
    .cliente-edit-section:last-of-type { margin-bottom: 0; }
    .cliente-edit-section-title { font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.03em; color: var(--accent-color); margin-bottom: 0.75rem; padding-bottom: 0.4rem; border-bottom: 2px solid color-mix(in srgb, var(--accent-color), transparent 85%); }
    .cliente-edit .form-label { font-size: 0.875rem; font-weight: 500; color: #495057; margin-bottom: 0.25rem; }
    .cliente-edit .form-control, .cliente-edit .form-select { border-radius: 8px; border-color: #dee2e6; font-size: 0.9rem; }
    .cliente-edit .form-control:focus, .cliente-edit .form-select:focus { border-color: var(--accent-color); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-color), transparent 88%); }
    .modal-clientes .btn-save { background: var(--accent-color); border-color: var(--accent-color); color: var(--contrast-color); font-weight: 500; padding: 0.5rem 1.25rem; border-radius: 8px; }
    .modal-clientes .btn-save:hover { background: color-mix(in srgb, var(--accent-color), black 12%); border-color: color-mix(in srgb, var(--accent-color), black 12%); color: var(--contrast-color); }
  </style>

  <div class="modal fade modal-clientes" id="modalVisualizar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-person-badge me-2"></i>Dados do cliente</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body" id="conteudoVisualizacao">
          <div class="cliente-view"><div class="text-center text-muted py-4"><span class="spinner-border spinner-border-sm me-2"></span>Carregando...</div></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade modal-clientes" id="modalEditar" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Editar cliente</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <form id="formEdicao" class="cliente-edit">
            <input type="hidden" id="edit-id">
            <div class="cliente-edit-section">
              <div class="cliente-edit-section-title">Dados pessoais</div>
              <div class="row g-3">
                <div class="col-12">
                  <label class="form-label" for="edit-nome">Nome completo</label>
                  <input type="text" class="form-control" id="edit-nome" placeholder="Nome do cliente">
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="edit-email">E-mail</label>
                  <input type="email" class="form-control" id="edit-email" placeholder="email@exemplo.com">
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="edit-telefone">Telefone</label>
                  <input type="tel" class="form-control" id="edit-telefone" placeholder="(00) 00000-0000" maxlength="16" oninput="aplicarMascaraTelefone(this)">
                </div>
              </div>
            </div>
            <div class="cliente-edit-section">
              <div class="cliente-edit-section-title">Endereço</div>
              <div class="row g-3">
                <div class="col-md-3">
                  <label class="form-label" for="edit-cep">CEP</label>
                  <input type="text" class="form-control" id="edit-cep" maxlength="9" placeholder="00000-000" oninput="aplicarMascaraCep(this); buscarCep(this.value, 'edicao')">
                </div>
                <div class="col-md-9">
                  <label class="form-label" for="edit-rua">Rua / Logradouro</label>
                  <input type="text" class="form-control" id="edit-rua" placeholder="Preenchido pelo CEP">
                </div>
                <div class="col-md-2">
                  <label class="form-label" for="edit-numero">Número</label>
                  <input type="text" class="form-control" id="edit-numero" placeholder="Nº">
                </div>
                <div class="col-md-4">
                  <label class="form-label" for="edit-complement">Complemento</label>
                  <input type="text" class="form-control" id="edit-complement" placeholder="Apto, bloco...">
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="edit-bairro">Bairro</label>
                  <input type="text" class="form-control" id="edit-bairro">
                </div>
                <div class="col-md-5">
                  <label class="form-label" for="edit-cidade">Cidade</label>
                  <input type="text" class="form-control" id="edit-cidade">
                </div>
                <div class="col-md-2">
                  <label class="form-label" for="edit-estado">UF</label>
                  <input type="text" class="form-control" id="edit-estado" placeholder="UF" maxlength="2">
                </div>
                <div class="col-md-5">
                  <label class="form-label" for="edit-pais">País</label>
                  <select class="form-select" id="edit-pais">
                    <option value="Brasil">Brasil</option>
                    <option value="Portugal">Portugal</option>
                    <option value="Outro">Outro</option>
                  </select>
                </div>
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-save" id="btnSalvarEdicao" onclick="salvarEdicao()"><i class="bi bi-check-lg me-1"></i> Salvar alterações</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="modalExclusaoMassa" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header modal-header-danger">
          <h5 class="modal-title"><i class="bi bi-trash-fill me-2"></i>Exclusão Múltipla</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p class="mb-0">Tem certeza que deseja remover <strong>todos os itens selecionados</strong>? <br>Essa ação não pode ser desfeita.</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-danger" onclick="executarExclusaoMassa()">Sim, Excluir Todos</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="modalSucesso" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content text-center">
            <div class="modal-body p-4">
                <i class="bi bi-check-circle text-success" style="font-size: 3rem;"></i>
                <h5 class="mt-2" id="msgSucesso">Sucesso!</h5>
            </div>
        </div>
    </div>
  </div>

<% if (typeof useAdminLayout === 'undefined' || !useAdminLayout) { %></main><% } %>
<% if (typeof useAdminLayout !== 'undefined' && useAdminLayout) { %>
  <script src="/assets/js/main.js"></script>
  <script src="/assets/js/script.js"></script>
<% } %>
<!-- Override Ver/Editar para usar API (dados reais do banco) -->
<script>
(function() {
  var apiBase = '/api/clientes';
  function formatCep(v) {
    if (!v) return '-';
    var s = String(v).replace(/\D/g, '');
    return s.length === 8 ? s.slice(0,5) + '-' + s.slice(5) : v;
  }
  window.verDetalhes = function(customerId) {
    var container = document.getElementById('conteudoVisualizacao');
    container.innerHTML = '<div class="cliente-view"><div class="text-center text-muted py-4"><span class="spinner-border spinner-border-sm me-2"></span>Carregando...</div></div>';
    var modal = new bootstrap.Modal(document.getElementById('modalVisualizar'));
    modal.show();
    fetch(apiBase + '/' + customerId, { headers: { 'Accept': 'application/json' } })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        if (!res.ok || !res.data) {
          container.innerHTML = '<div class="cliente-view"><div class="alert alert-warning mb-0">' + (res.message || 'Cliente não encontrado.') + '</div></div>';
          return;
        }
        var c = res.data;
        var nome = c.full_name || '-';
        var inicial = nome !== '-' ? nome.charAt(0).toUpperCase() : '?';
        var enderecoLinha = [c.rua || c.street, c.number, c.complement].filter(Boolean).join(', ') || '-';
        var bairro = c.bairro || c.district || '-';
        var cidadeUf = [c.cidade || c.city, c.estado || c.state].filter(Boolean).join(' / ') || '-';
        var cep = formatCep(c.cep || c.zip_code);
        var pais = c.pais || c.country || 'Brasil';
        var html = '<div class="cliente-view">' +
          '<div class="cliente-view-avatar">' + inicial + '</div>' +
          '<div class="cliente-view-nome">' + nome + '</div>' +
          '<div class="cliente-view-section">' +
            '<div class="cliente-view-section-title">Dados pessoais</div>' +
            '<div class="cliente-view-row"><span class="cliente-view-label">E-mail</span><span class="cliente-view-value"><i class="bi bi-envelope"></i>' + (c.email || '-') + '</span></div>' +
            '<div class="cliente-view-row"><span class="cliente-view-label">Telefone</span><span class="cliente-view-value"><i class="bi bi-telephone"></i>' + (c.phone || '-') + '</span></div>' +
            (c.document ? '<div class="cliente-view-row"><span class="cliente-view-label">CPF</span><span class="cliente-view-value">' + c.document + '</span></div>' : '') +
            (c.birth_date ? '<div class="cliente-view-row"><span class="cliente-view-label">Data nasc.</span><span class="cliente-view-value">' + c.birth_date + '</span></div>' : '') +
          '</div>' +
          '<div class="cliente-view-section">' +
            '<div class="cliente-view-section-title">Endereço</div>' +
            '<div class="cliente-view-row"><span class="cliente-view-label">Logradouro</span><span class="cliente-view-value"><i class="bi bi-geo-alt"></i>' + enderecoLinha + '</span></div>' +
            '<div class="cliente-view-row"><span class="cliente-view-label">Bairro</span><span class="cliente-view-value">' + bairro + '</span></div>' +
            '<div class="cliente-view-row"><span class="cliente-view-label">Cidade / UF</span><span class="cliente-view-value"><i class="bi bi-building"></i>' + cidadeUf + '</span></div>' +
            '<div class="cliente-view-row"><span class="cliente-view-label">CEP</span><span class="cliente-view-value"><i class="bi bi-mailbox"></i>' + cep + '</span></div>' +
            '<div class="cliente-view-row"><span class="cliente-view-label">País</span><span class="cliente-view-value">' + pais + '</span></div>' +
          '</div></div>';
        container.innerHTML = html;
      })
      .catch(function() {
        container.innerHTML = '<div class="cliente-view"><div class="alert alert-danger mb-0">Erro ao carregar dados do cliente.</div></div>';
      });
  };
  window.prepararEdicao = function(customerId) {
    fetch(apiBase + '/' + customerId, { headers: { 'Accept': 'application/json' } })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        if (!res.ok || !res.data) {
          window.neofarmaToast(res.message || 'Cliente não encontrado.', 'danger');
          return;
        }
        var c = res.data;
        document.getElementById('edit-id').value = c.customer_id;
        document.getElementById('edit-nome').value = c.full_name || '';
        document.getElementById('edit-email').value = c.email || '';
        document.getElementById('edit-telefone').value = c.phone || '';
        document.getElementById('edit-cep').value = formatCep(c.cep || c.zip_code) || '';
        document.getElementById('edit-rua').value = c.rua || c.street || '';
        document.getElementById('edit-numero').value = c.number || '';
        document.getElementById('edit-complement').value = c.complement || '';
        document.getElementById('edit-bairro').value = c.bairro || c.district || '';
        document.getElementById('edit-cidade').value = c.cidade || c.city || '';
        document.getElementById('edit-estado').value = c.estado || c.state || '';
        document.getElementById('edit-pais').value = c.pais || c.country || 'Brasil';
        new bootstrap.Modal(document.getElementById('modalEditar')).show();
      })
      .catch(function() { window.neofarmaToast('Erro ao carregar dados do cliente.', 'danger'); });
  };
  window.executarExclusaoMassa = function() {
    var checkboxes = document.querySelectorAll('.check-item:checked');
    var ids = Array.from(checkboxes).map(function(cb) { return parseInt(cb.value, 10); }).filter(function(n) { return !isNaN(n); });
    if (ids.length === 0) {
      window.neofarmaToast('Nenhum cliente selecionado.', 'danger');
      return;
    }
    var modalEl = document.getElementById('modalExclusaoMassa');
    var modal = bootstrap.Modal.getInstance(modalEl);
    if (modal) modal.hide();
    fetch(apiBase + '/excluir-massa', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ ids: ids })
    })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        if (res.ok) {
          if (typeof mostrarMensagemSucesso === 'function') mostrarMensagemSucesso(res.message || 'Cliente(s) removido(s) com sucesso.');
          else window.neofarmaToast(res.message || 'Cliente(s) removido(s) com sucesso.', 'success');
          window.location.reload();
        } else {
          window.neofarmaToast(res.message || 'Erro ao excluir.', 'danger');
        }
      })
      .catch(function() { window.neofarmaToast('Erro de conexão. Tente novamente.', 'danger'); });
  };
  window.salvarEdicao = function() {
    var id = document.getElementById('edit-id').value;
    if (!id) return;
    var body = {
      nome: document.getElementById('edit-nome').value.trim(),
      email: document.getElementById('edit-email').value.trim(),
      telefone: document.getElementById('edit-telefone').value.trim(),
      rua: document.getElementById('edit-rua').value.trim(),
      numero: document.getElementById('edit-numero').value.trim(),
      complement: (document.getElementById('edit-complement').value || '').trim() || null,
      bairro: document.getElementById('edit-bairro').value.trim(),
      cidade: document.getElementById('edit-cidade').value.trim(),
      estado: document.getElementById('edit-estado').value.trim(),
      pais: document.getElementById('edit-pais').value || 'Brasil',
      cep: (document.getElementById('edit-cep').value || '').replace(/\D/g, '') || null
    };
    if (!body.nome) { window.neofarmaToast('Nome é obrigatório.', 'danger'); return; }
    if (!body.email) { window.neofarmaToast('E-mail é obrigatório.', 'danger'); return; }
    var btn = document.getElementById('btnSalvarEdicao');
    if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Salvando...'; }
    fetch(apiBase + '/' + id, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(body)
    })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-check-lg me-1"></i> Salvar alterações'; }
        if (res.ok) {
          bootstrap.Modal.getInstance(document.getElementById('modalEditar')).hide();
          if (typeof mostrarMensagemSucesso === 'function') mostrarMensagemSucesso('Dados atualizados com sucesso!');
          else window.neofarmaToast('Dados atualizados com sucesso!', 'success');
          window.location.reload();
        } else {
          window.neofarmaToast(res.message || 'Erro ao atualizar.', 'danger');
        }
      })
      .catch(function() {
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-check-lg me-1"></i> Salvar alterações'; }
        window.neofarmaToast('Erro de conexão. Tente novamente.', 'danger');
      });
  };
})();
</script>
<%- include(typeof useAdminLayout !== 'undefined' && useAdminLayout ? 'admin/partials/footer' : 'partials/footer') %>
