<%- include('partials/header') %>

<main class="main">

  <div class="page-title light-background">
    <div class="container d-lg-flex justify-content-between align-items-center">
      <h1>Recuperar Senha</h1>
      <nav class="breadcrumbs">
        <ol>
          <li><a href="/login">Voltar para o Login</a></li>
          <li class="current">Recuperar Senha</li>
        </ol>
      </nav>
    </div>
  </div>

  <section class="login section">
    <div class="container" data-aos="fade-up">

      <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">

          <div class="auth-container">

            <div id="stepEmail" class="auth-form active">

              <div class="form-header">
                <h3>Esqueceu sua senha?</h3>
                <p>Digite seu email para enviarmos um link de redefinição. Após a mensagem de confirmação, retorne ao login no link acima.</p>
              </div>

              <form class="auth-form-content">
              <div class="input-group mb-3">
                <span class="input-icon">
                  <i class="bi bi-envelope"></i>
                </span>
                <input type="email" id="emailInput" class="form-control" placeholder="Seu email" required>
              </div>
              <button type="button" class="auth-btn primary-btn w-100" onclick="enviarRecuperacao()">
                Enviar Email <i class="bi bi-send"></i>
              </button>
            </form>
            <div id="successMsg" class="alert alert-success mt-3 d-none">
              O email foi enviado! Verifique sua caixa de entrada e também o spam.
            </div>
            </div>

          </div>

        </div>
      </div>

    </div>
  </section>

</main>

<%- include('partials/footer') %>
