<%- include('partials/header') %>

<main class="main">

  <!-- Page Title -->
  <div class="page-title light-background">
    <div class="container d-lg-flex justify-content-between align-items-center">
      <h1 class="mb-2 mb-lg-0">Política de devolução</h1>
      <nav class="breadcrumbs">
        <ol>
          <li><a href="/">Home</a></li>
          <li class="current">Política de devolução</li>
        </ol>
      </nav>
    </div>
  </div><!-- End Page Title -->

  <!-- Retun Policy Section -->
  <section id="retun-policy" class="retun-policy section">

    <div class="container" data-aos="fade-up">
      <!-- Hero Section -->
      <div class="return-hero" data-aos="fade-up">
        <div class="hero-content">
          <h2>Devoluções simplificadas</h2>
          <p>Não está satisfeito com sua compra? Nosso processo de devolução descomplicado garante uma experiência tranquila.</p>
        </div>
        <div class="return-period-box">
          <div class="box-content">
            <span class="days">30</span>
            <span class="text">Retornos diários</span>
          </div>
        </div>
      </div>

      <!-- Return Policy Overview -->
      <div class="policy-overview" data-aos="fade-up" data-aos-delay="100">
        <div class="row">
          <div class="col-lg-4" data-aos="fade-up" data-aos-delay="100">
            <div class="feature-card">
              <div class="card-content">
                <i class="bi bi-shield-check"></i>
                <h4>Devoluções Gratuitas</h4>
                <p>Cobrimos os custos de envio de devolução para todos os itens qualificados</p>
                <a href="#" class="learn-more">Learn More <i class="bi bi-arrow-right"></i></a>
              </div>
            </div>
          </div>

          <div class="col-lg-4" data-aos="fade-up" data-aos-delay="200">
            <div class="feature-card">
              <div class="card-content">
                <i class="bi bi-clock-history"></i>
                <h4>Reembolsos rápidos</h4>
                <p>Receba seu dinheiro de volta em 5 a 7 dias úteis</p>
                <a href="#" class="learn-more">Learn More <i class="bi bi-arrow-right"></i></a>
              </div>
            </div>
          </div>

          <div class="col-lg-4" data-aos="fade-up" data-aos-delay="300">
            <div class="feature-card">
              <div class="card-content">
                <i class="bi bi-arrow-repeat"></i>
                <h4>Troca fácil</h4>
                <p>Processo simples para trocar itens por tamanhos diferentes</p>
                <a href="#" class="learn-more">Learn More <i class="bi bi-arrow-right"></i></a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Return Requirements -->
      <div class="return-requirements" data-aos="fade-up" data-aos-delay="200">
        <div class="row align-items-center">
          <div class="col-lg-6">
            <div class="requirements-content">
              <h3>Requisitos de devolução</h3>
              <p class="subtitle">Para ser elegível para devolução, seu item deve ser:</p>
              <ul class="checks-list">
                <li>
                  <i class="bi bi-check-lg"></i>
                  <div class="requirement-text">
                    <h5>Não Usado &amp; Não Comsumido</h5>
                    <p>Os itens devem estar em condições originais</p>
                  </div>
                </li>
                <li>
                  <i class="bi bi-check-lg"></i>
                  <div class="requirement-text">
                    <h5>Embalagem original</h5>
                    <p>Incluir todas as etiquetas e embalagens</p>
                  </div>
                </li>
                <li>
                  <i class="bi bi-check-lg"></i>
                  <div class="requirement-text">
                    <h5>Dentro de 30 dias</h5>
                    <p>A partir da data de entrega</p>
                  </div>
                </li>
                <li>
                  <i class="bi bi-check-lg"></i>
                  <div class="requirement-text">
                    <h5>Comprovante de compra</h5>
                    <p>Número do pedido ou recibo</p>
                  </div>
                </li>
              </ul>
            </div>
          </div>
          <div class="col-lg-6">
            <div class="exceptions-box" data-aos="fade-left">
              <div class="box-header">
                <i class="bi bi-exclamation-circle"></i>
                <h4>Exceções de retorno</h4>
              </div>
              <div class="exceptions-grid">
                <div class="exception-item">
                  <i class="bi bi-gift"></i>
                  <span>Cartões-presente</span>
                </div>
                <div class="exception-item">
                  <i class="bi bi-bag"></i>
                  <span>Medicamentos (controlados ou não)</span>
                </div>
                <div class="exception-item">
                  <i class="bi bi-box-seam"></i>
                  <span>Produtos de uso pessoal e higiene íntima</span>
                </div>
                <div class="exception-item">
                  <i class="bi bi-tag"></i>
                  <span>Itens em promoção</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Return Process Steps -->
      <div class="return-steps" data-aos="fade-up" data-aos-delay="300">
        <h3>Como retornar</h3>
        <div class="steps-timeline">
          <div class="step-item active">
            <div class="step-number">1</div>
            <div class="step-content">
              <h5>Iniciar retorno</h5>
              <p>Entre na sua conta e selecione os itens a serem devolvidos</p>
            </div>
          </div>

          <div class="step-item">
            <div class="step-number">2</div>
            <div class="step-content">
              <h5>Itens do pacote ou em embalagem delicada</h5>
              <p>Embale os itens com segurança na embalagem original ou similar</p>
            </div>
          </div>

          <div class="step-item">
            <div class="step-number">3</div>
            <div class="step-content">
              <h5>Retorno Envio</h5>
              <p>Utilize nossa etiqueta pré-paga para enviar sua devolução</p>
            </div>
          </div>

          <div class="step-item">
            <div class="step-number">4</div>
            <div class="step-content">
              <h5>Obter reembolso</h5>
              <p>Reembolso emitido para o método de pagamento original</p>
            </div>
          </div>
        </div>
      </div>

      <!-- FAQs -->
      <div class="return-faqs" data-aos="fade-up" data-aos-delay="400">
        <div class="row">
          <div class="col-lg-4">
            <div class="faq-header">
              <h3>Perguntas comuns</h3>
              <p>Encontre respostas para perguntas frequentes sobre nossa política de devolução</p>
              <a href="#" class="contact-support">
                <i class="bi bi-headset"></i>
               Precisa de mais ajuda?
              </a>
            </div>
          </div>
          <div class="col-lg-8">
            <div class="faq-list">
              <div class="faq-item">
                <h3>
                  Posso devolver parte do meu pedido?
                  <i class="bi bi-plus-lg faq-toggle"></i>
                </h3>
                <div class="faq-answer">
                  <p>Sim, é possível devolver parte do pedido, desde que os produtos estejam dentro das condições de devolução (lacrados, sem uso e dentro do prazo informado).</p>
                </div>
              </div>

              <div class="faq-item">
                <h3>
                  Quanto tempo demora o processo de reembolso?
                  <i class="bi bi-plus-lg faq-toggle"></i>
                </h3>
                <div class="faq-answer">
                  <p>O reembolso é realizado após a confirmação da devolução do produto e pode levar até 7 dias úteis, dependendo da forma de pagamento.</p>
                </div>
              </div>

              <div class="faq-item">
                <h3>
                  Posso trocar um medicamento por outro diferente?
                  <i class="bi bi-plus-lg faq-toggle"></i>
                </h3>
                <div class="faq-answer">
                  <p>Por questões de segurança e normas da Anvisa, não é permitido trocar medicamentos por outros diferentes. A troca só é realizada em caso de erro no envio ou produto com defeito.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom CTA -->
      <div class="return-cta" data-aos="fade-up" data-aos-delay="500">
        <div class="cta-content">
          <h4>Pronto para iniciar sua declaração?</h4>
          <p>Entre na sua conta para iniciar o processo de devolução</p>
          <div class="cta-buttons">
            <a href="/order-confirmation" class="btn-primary">Iniciar retorno</a>
            <a href="/account" class="btn-secondary">Acompanhar retorno</a>
          </div>
        </div>
      </div>

    </div>

  </section><!-- /Retun Policy Section -->

</main>

<%- include('partials/footer') %>
