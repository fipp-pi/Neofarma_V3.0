<%- include('partials/header') %>

<main class="main">

  <!-- Page Title -->
  <div class="page-title light-background">
    <div class="container d-lg-flex justify-content-between align-items-center">
      <h1 class="mb-2 mb-lg-0">Privacidade</h1>
      <nav class="breadcrumbs">
        <ol>
          <li><a href="/">Início</a></li>
          <li class="current">Privacidade</li>
        </ol>
      </nav>
    </div>
  </div><!-- End Page Title -->

  <!-- Privacy Section -->
  <section id="privacy" class="privacy section">

    <div class="container" data-aos="fade-up">
      <!-- Header -->
      <div class="privacy-header" data-aos="fade-up">
        <div class="header-content">
          <span class="update-badge">Última vez atualizado em: Agosto 20, 2025</span>
          <h2>Política de Privacidade</h2>
          <p>Respeitamos a sua privacidade e estamos comprometidos em proteger os seus dados pessoais. Esta política de privacidade explica como lidamos com as suas informações.</p>
          <div class="privacy-badges">
            <div class="badge-item">
              <i class="bi bi-shield-check"></i>
              <span>Proteção de Dados</span>
            </div>
            <div class="badge-item">
              <i class="bi bi-lock"></i>
              <span>Armazenamento seguro</span>
            </div>
            <div class="badge-item">
              <i class="bi bi-person-lock"></i>
              <span>Privacidade em primeiro lugar</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Information Collection -->
      <div class="info-section" data-aos="fade-up">
        <div class="section-grid">
          <div class="info-card">
            <div class="card-header">
              <i class="bi bi-collection"></i>
              <h3>Informações que coletamos</h3>
            </div>
            <div class="card-content">
              <ul class="info-list">
                <li>Nome e informações de contato</li>
                <li>Credenciais da conta</li>
                <li>Detalhes de pagamento</li>
                <li>Informações do dispositivo</li>
                <li>Dados de uso e preferências</li>
                <li>Registros de comunicação</li>
              </ul>
            </div>
          </div>

          <div class="info-card">
            <div class="card-header">
              <i class="bi bi-graph-up"></i>
              <h3>Como usamos os dados</h3>
            </div>
            <div class="card-content">
              <ul class="info-list">
                <li>Fornecer e melhorar serviços</li>
                <li>Processar transações</li>
                <li>Envie atualizações e notificações</li>
                <li>Personalize a experiência do usuário</li>
                <li>Analise o uso do serviço</li>
                <li>Garanta a segurança</li>
              </ul>
            </div>
          </div>

          <div class="info-card">
            <div class="card-header">
              <i class="bi bi-share"></i>
              <h3>Compartilhamento de informações</h3>
            </div>
            <div class="card-content">
              <ul class="info-list">
                <li>Prestadores de serviços</li>
                <li>Parceiros de negócios</li>
                <li>Requisitos legais</li>
                <li>Com consentimento do usuário</li>
                <li>Transações comerciais</li>
                <li>Parceiros analíticos</li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Security Measures -->
      <div class="security-section" data-aos="fade-up">
        <div class="section-header">
          <h3>Medidas de segurança de dados</h3>
          <p>Implementamos medidas de segurança adequadas para proteger seus dados</p>
        </div>
        <div class="measures-grid">
          <div class="measure-item">
            <i class="bi bi-shield-lock"></i>
            <h4>Criptografia</h4>
            <p>Todos os dados são criptografados durante a transmissão e o armazenamento usando protocolos padrão da indústria</p>
          </div>
          <div class="measure-item">
            <i class="bi bi-fingerprint"></i>
            <h4>Controle de acesso</h4>
            <p>Controles de acesso rigorosos e medidas de autenticação protegem suas informações</p>
          </div>
          <div class="measure-item">
            <i class="bi bi-eye-slash"></i>
            <h4>Privacidade de dados</h4>
            <p>Avaliações regulares de privacidade e práticas de minimização de dados</p>
          </div>
          <div class="measure-item">
            <i class="bi bi-patch-check"></i>
            <h4>Conformidade</h4>
            <p>Adesão às regulamentações internacionais de proteção de dados</p>
          </div>
        </div>
      </div>

      <!-- User Rights -->
      <div class="rights-section" data-aos="fade-up">
        <div class="rights-content">
          <h3>Seus direitos de privacidade</h3>
          <p>Você tem vários direitos em relação aos seus dados pessoais:</p>
          <div class="rights-grid">
            <div class="right-item">
              <i class="bi bi-eye"></i>
              <h4>Direito de acesso</h4>
              <p>Você pode solicitar uma cópia dos seus dados pessoais</p>
            </div>
            <div class="right-item">
              <i class="bi bi-pencil-square"></i>
              <h4>Direito de Retificação</h4>
              <p>Você pode atualizar ou corrigir suas informações</p>
            </div>
            <div class="right-item">
              <i class="bi bi-trash"></i>
              <h4>Direito ao apagamento</h4>
              <p>Solicitar a eliminação dos seus dados pessoais</p>
            </div>
            <div class="right-item">
              <i class="bi bi-download"></i>
              <h4>Direito à Portabilidade de Dados</h4>
              <p>Transfira seus dados para outro serviço</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Additional Information -->
      <div class="additional-info" data-aos="fade-up">
        <div class="info-grid">
          <div class="info-item">
            <h4>Política de Cookies</h4>
            <p>Utilizamos cookies para melhorar sua experiência de navegação. Você pode controlar as preferências de cookies nas configurações do seu navegador.</p>
          </div>
          <div class="info-item">
            <h4>Privacidade infantil</h4>
            <p>Nossos serviços não são destinados a crianças menores de 13 anos. Não coletamos intencionalmente dados de crianças.</p>
          </div>
          <div class="info-item">
            <h4>Atualizações de políticas</h4>
            <p>Podemos atualizar esta política periodicamente. Notificaremos você sobre quaisquer alterações relevantes.</p>
          </div>
        </div>
      </div>

      <!-- Contact Section -->
      <div class="privacy-contact" data-aos="fade-up">
        <div class="contact-box">
          <div class="contact-icon">
            <i class="bi bi-envelope-open"></i>
          </div>
          <div class="contact-content">
            <h4>Perguntas sobre privacidade?</h4>
            <p>Se você tiver alguma dúvida sobre esta Política de Privacidade, entre em contato com nosso Diretor de Proteção de Dados</p>
            <a href="/contact" class="contact-button">Nos contate</a>
          </div>
        </div>
      </div>

    </div>

  </section><!-- /Privacy Section -->

</main>

<%- include('partials/footer') %>
