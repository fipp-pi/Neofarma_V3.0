  <script>
    (function () {
      function setCartCount(count) {
        document.querySelectorAll('[data-cart-count]').forEach(function (el) {
          el.textContent = String(count);
        });
      }

      async function refreshCartBadges() {
        try {
          const resp = await fetch('/api/cart', { headers: { Accept: 'application/json' } });
          const data = await resp.json();
          if (!data || !data.ok || !data.cart || !Array.isArray(data.cart.items)) return;
          const count = data.cart.items.reduce(function (acc, item) {
            return acc + (parseInt(item.quantity, 10) || 0);
          }, 0);
          setCartCount(count);
        } catch (_) {
          // silencioso: não bloquear render da página
        }
      }

      window.refreshCartBadges = refreshCartBadges;
      document.addEventListener('DOMContentLoaded', refreshCartBadges);
      window.addEventListener('cart:changed', refreshCartBadges);
    })();
  </script>

