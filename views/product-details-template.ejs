<%- include('partials/header') %>

<main class="main">
  <div class="page-title light-background">
    <div class="container d-lg-flex justify-content-between align-items-center">
      <h1 class="mb-2 mb-lg-0">Detalhes do Produto</h1>
      <nav class="breadcrumbs">
        <ol>
          <li><a href="/">Início</a></li>
          <li><a href="/category">Categoria</a></li>
          <li class="current">Produto <%= productId %></li>
        </ol>
      </nav>
    </div>
  </div>

  <section class="product-details section">
    <div class="container" data-aos="fade-up">
      <div class="row gy-4">
        <div class="col-lg-6">
          <div class="product-gallery">
            <div class="product-main-image">
              <img src="/assets/img/product/product-details-<%= productId %>.webp" alt="Produto <%= productId %>" class="img-fluid">
            </div>
          </div>
        </div>

        <div class="col-lg-6">
          <div class="product-info">
            <h2>Produto <%= productId %></h2>
            <p class="text-muted">Descrição detalhada do produto <%= productId %>. Aqui você poderá depois substituir pelo conteúdo específico de cada produto, se quiser.</p>

            <div class="product-price mb-3">
              <span class="price h4 mb-0">R$ 0,00</span>
            </div>

            <div class="d-flex align-items-center gap-3 mb-4">
              <button class="btn btn-primary">
                <i class="bi bi-cart-plus me-1"></i> Adicionar ao Carrinho
              </button>
              <a href="/cart" class="btn btn-outline-primary">
                Ver Carrinho
              </a>
            </div>

            <ul class="list-unstyled small text-muted">
              <li><strong>Código:</strong> PROD-<%= productId %></li>
              <li><strong>Categoria:</strong> Fitoterápicos</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
