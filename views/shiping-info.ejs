<%- include('partials/header') %>

<main class="main">

  <!-- Page Title -->
  <div class="page-title light-background">
    <div class="container d-lg-flex justify-content-between align-items-center">
      <h1 class="mb-2 mb-lg-0">Informações de Envio</h1>
      <nav class="breadcrumbs">
        <ol>
          <li><a href="/">Home</a></li>
          <li class="current">Informações de Envio</li>
        </ol>
      </nav>
    </div>
  </div><!-- End Page Title -->

  <!-- Shipping Info Section -->
  <section id="shipping-info" class="shipping-info section">

    <div class="container" data-aos="fade-up">

      <div class="content-wrapper">
        <!-- Delivery Options -->
        <div class="content-block" data-aos="fade-up" data-aos-delay="100">
          <div class="section-heading">
            <i class="bi bi-truck"></i>
            <h3>Opções de Entrega</h3>
            <p>Escolha uma opção de entrega que melhor lhe agrada</p>
          </div>

          <div class="row gy-4 gx-lg-5">
            <div class="col-md-6 col-lg-4">
              <div class="delivery-card">
                <div class="card-icon">
                  <i class="bi bi-lightning-charge"></i>
                </div>
                <h4>Expresso Delivery</h4>
                <p>Entrega em 1-2 dias úteis.</p>
                <div class="delivery-time">
                  <i class="bi bi-clock"></i>
                  <span>Em até 1-2 dia(s)</span>
                </div>
              </div>
            </div>

            <div class="col-md-6 col-lg-4">
              <div class="delivery-card">
                <div class="card-icon">
                  <i class="bi bi-box-seam"></i>
                </div>
                <h4>Standard Delivery</h4>
                <p>Entrega em 3-5 dias úteis.</p>
                <div class="delivery-time">
                  <i class="bi bi-clock"></i>
                  <span>Em até 3-5 dia(s)</span>
                </div>
              </div>
            </div>
            <div class="col-md-6 col-lg-4">
              <div class="delivery-card">
                <div class="card-icon">
                  <i class="bi bi-pin-map"></i>
                </div>
                <h4>OS Shipping</h4>
                <p>Em até 2-3 dias úteis.</p>
                <div class="delivery-time">
                  <i class="bi bi-clock"></i>
                  <span>Em até 2-3 dia(s)</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Shipping Costs -->
        <div class="content-block" data-aos="fade-up" data-aos-delay="200">
          <div class="section-heading">
            <i class="bi bi-cash-coin"></i>
            <h3>Custos de Envio</h3>
            <p>Preços transparentes para todas as opções de envio</p>
          </div>

          <div class="shipping-rates">
            <div class="rate-item">
              <div class="rate-type">Standard Delivery</div>
              <div class="rate-cost">R$5.99</div>
              <div class="rate-info">Para pedidos abaixo R$50</div>
            </div>
            <div class="rate-item highlight">
              <div class="rate-type">OS Shipping</div>
              <div class="rate-cost">R$0.00</div>
              <div class="rate-info">Para pedidos abaixo R$50</div>
            </div>
            <div class="rate-item">
              <div class="rate-type">Expresso Delivery</div>
              <div class="rate-cost">R$12.99</div>
              <div class="rate-info">1-2 dia(s) para entrega</div>
            </div>
          </div>
        </div>

        <!-- International Shipping -->
        <div class="content-block" data-aos="fade-up" data-aos-delay="300">
          <div class="section-heading">
            <i class="bi bi-globe"></i>
            <h3>Envio Internacional</h3>
            <p>Nós entregamos em todo o mundo com transportadoras confiáveis</p>
          </div>

          <div class="international-info">
            <div class="info-item">
              <i class="bi bi-clock-history"></i>
              <h5>Tempo de Entrega</h5>
              <p>5 a 10 dias úteis para a maioria dos destinos internacionais</p>
            </div>
            <div class="info-item">
              <i class="bi bi-currency-dollar"></i>
              <h5>Taxas &amp; Adicionais</h5>
              <p>Impostos e taxas de importação não estão incluídos no custo de envio</p>
            </div>
            <div class="info-item">
              <i class="bi bi-shield-check"></i>
              <h5>Serviço Seguro</h5>
              <p>Envio rastreado com as principais transportadoras internacionais</p>
            </div>
          </div>
        </div>

        <!-- FAQ Section -->
        <div class="content-block" data-aos="fade-up" data-aos-delay="400">
          <div class="section-heading">
            <i class="bi bi-question-circle"></i>
            <h3>Perguntas frequentes sobre envio</h3>
            <p>Perguntas frequentes sobre nossos serviços de remessa</p>
          </div>

          <div class="faq-list">
            <div class="faq-item">
              <h3>
                <i class="bi bi-question-circle"></i>
               Como posso rastrear meu pedido?
                <i class="bi bi-chevron-down faq-toggle"></i>
              </h3>
              <div class="faq-answer">
                <p>Você pode rastrear seu pedido acessando a área 'Meus Pedidos' no site e clicando em 'Rastrear'. Também enviamos o código de rastreio por e-mail assim que seu pedido é enviado.</p>
              </div>
            </div>

            <div class="faq-item">
              <h3>
                <i class="bi bi-question-circle"></i>
                E se eu não estiver em casa para a entrega?
                <i class="bi bi-chevron-down faq-toggle"></i>
              </h3>
              <div class="faq-answer">
                <p>Caso não esteja em casa no momento da entrega, a transportadora realizará novas tentativas ou o pedido poderá ficar disponível para retirada no ponto indicado pela empresa de entrega.</p>
              </div>
            </div>

            <div class="faq-item">
              <h3>
                <i class="bi bi-question-circle"></i>
                Vocês oferecem entrega nos fins de semana?
                <i class="bi bi-chevron-down faq-toggle"></i>
              </h3>
              <div class="faq-answer">
                <p>As entregas são realizadas de segunda a sexta-feira. Em algumas regiões, também oferecemos entregas aos sábados.</p>
              </div>
            </div>
          </div>
        </div>

      </div>

    </div>

  </section><!-- /Shipping Info Section -->

</main>

<%- include('partials/footer') %>
