  function bindProfessionalTableTools() {
    var searchEl = document.getElementById('pro_search');
    var pageSizeEl = document.getElementById('pro_page_size');
    var tbody = document.getElementById('pro_tbody');
    var infoEl = document.getElementById('pro_pagination_info');
    var controlsEl = document.getElementById('pro_pagination_controls');
    if (!searchEl || !pageSizeEl || !tbody || !infoEl || !controlsEl) return;

    var currentPage = 1;
    function render() {
      var q = String(searchEl.value || '').trim().toLowerCase();
      var pageSize = Math.max(1, Number(pageSizeEl.value || 10));
      var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
      var filtered = rows.filter(function(row) {
        if (!row || row.cells.length <= 1) return false;
        var hay = (row.getAttribute('data-search') || '').toLowerCase();
        return !q || hay.indexOf(q) >= 0;
      });
      var total = filtered.length;
      var pages = Math.max(1, Math.ceil(total / pageSize));
      if (currentPage > pages) currentPage = pages;
      var start = (currentPage - 1) * pageSize;
      var end = start + pageSize;

      rows.forEach(function(r){ r.style.display = 'none'; });
      filtered.slice(start, end).forEach(function(r){ r.style.display = ''; });

      infoEl.textContent = total + ' profissional(is) - página ' + currentPage + ' de ' + pages;
      controlsEl.innerHTML = '';

      function addBtn(label, page, disabled, active) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn ' + (active ? 'btn-primary' : 'btn-outline-primary');
        btn.textContent = label;
        btn.disabled = !!disabled;
        btn.addEventListener('click', function(){ currentPage = page; render(); });
        controlsEl.appendChild(btn);
      }

      addBtn('«', 1, currentPage === 1, false);
      addBtn('‹', Math.max(1, currentPage - 1), currentPage === 1, false);
      var from = Math.max(1, currentPage - 2);
      var to = Math.min(pages, currentPage + 2);
      for (var p = from; p <= to; p++) addBtn(String(p), p, false, p === currentPage);
      addBtn('›', Math.min(pages, currentPage + 1), currentPage === pages, false);
      addBtn('»', pages, currentPage === pages, false);
    }

    searchEl.addEventListener('input', function(){ currentPage = 1; render(); });
    pageSizeEl.addEventListener('change', function(){ currentPage = 1; render(); });
    render();
  }
  bindProfessionalTableTools();

