  (function initAdminSlotPicker() {
    if (!window.NeofarmaAppointmentSlots) return;
    var holidayDates = <%- JSON.stringify((holidays || []).map(function(h){ return String(h.holiday_date).slice(0,10); })) %>;
    window.adminSlotPicker = new window.NeofarmaAppointmentSlots.AppointmentSlotPicker({
      prefix: 'res',
      slotsUrl: '/admin/agendamentos-servicos/disponibilidade/slots',
      daysUrl: '/admin/agendamentos-servicos/disponibilidade/dias',
      servicesCatalog: <%- JSON.stringify(servicesCatalog || []) %>,
      minDate: '<%= minBookingDate %>',
      maxDate: '<%= maxBookingDate %>',
      holidayDates: holidayDates,
      onToast: safeToast
    });
    var reserveModal = document.getElementById('modalReserve');
    if (reserveModal) {
      reserveModal.addEventListener('shown.bs.modal', function () {
        if (window.adminSlotPicker) {
          window.adminSlotPicker.filterServicesByModality();
          window.adminSlotPicker.refreshAvailableDays();
        }
      });
    }
  })();

  (function initAptActionDropdowns() {
    var table = document.getElementById('table_appointments');
    if (!table) return;

    table.addEventListener('show.bs.dropdown', function (e) {
      var dropdown = e.target.closest('.apt-actions-dropdown');
      if (!dropdown || !table.contains(dropdown)) return;
      var menu = dropdown.querySelector('.dropdown-menu');
      if (!menu || dropdown._aptMenu === menu) return;
      dropdown._aptMenu = menu;
      document.body.appendChild(menu);
      menu.classList.add('apt-actions-menu--floating');
    }, true);

    table.addEventListener('hidden.bs.dropdown', function (e) {
      var dropdown = e.target.closest('.apt-actions-dropdown');
      if (!dropdown || !dropdown._aptMenu) return;
      dropdown.appendChild(dropdown._aptMenu);
      dropdown._aptMenu.classList.remove('apt-actions-menu--floating');
      dropdown._aptMenu = null;
    });
  })();
