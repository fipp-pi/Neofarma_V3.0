    var refundPercent = Number(document.getElementById('incomplete_refund_percent').value);
    var paymentStatus = String(document.getElementById('incomplete_payment_status').value || '').toUpperCase();

    if (!reason || reason.length < 5) errors.incomplete_reason = 'Informe o motivo com pelo menos 5 caracteres.';
    if (paymentStatus === 'PAID' && (!Number.isFinite(refundPercent) || refundPercent < 0 || refundPercent > 100)) {
      errors.incomplete_refund_percent = 'Informe um percentual entre 0 e 100.';
    }

