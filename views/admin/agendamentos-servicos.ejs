  function parseAddressTextClient(text) {
    if (!text || !String(text).trim()) return {};
    var parts = String(text).split(' - ').map(function (s) { return s.trim(); }).filter(Boolean);
    if (parts.length < 3) return { street: String(text).trim() };
    var cityState = parts[parts.length - 1];
    var district = parts[parts.length - 2];
    var head = parts.slice(0, -2).join(' - ');
    var slash = cityState.lastIndexOf('/');
    var city = slash >= 0 ? cityState.slice(0, slash).trim() : cityState;
    var state = slash >= 0 ? cityState.slice(slash + 1).trim() : '';
    var comma = head.lastIndexOf(',');
    if (comma < 0) return { street: head, district: district, city: city, state: state };
    var street = head.slice(0, comma).trim();
    var numPart = head.slice(comma + 1).trim();
    var innerDash = numPart.indexOf(' - ');
    if (innerDash >= 0) {
      return {
        street: street,
        number: numPart.slice(0, innerDash).trim(),
        complement: numPart.slice(innerDash + 3).trim(),
        district: district,
        city: city,
        state: state
      };
    }
    return { street: street, number: numPart, district: district, city: city, state: state };
  }

