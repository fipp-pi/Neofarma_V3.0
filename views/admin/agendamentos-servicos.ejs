<script src="/assets/js/appointment-scheduling.js"></script>
<script>
  var AGENDAMENTOS_VIEW = '<%= currentView %>';
  var AGENDAMENTOS_STATUS = '<%= statusFilter %>';

  function buildAgendamentosUrl(nextView) {
    var url = '/admin/agendamentos-servicos?view=' + encodeURIComponent(nextView);
    if (nextView === 'agenda') url += '&status=' + encodeURIComponent(AGENDAMENTOS_STATUS);
    return url;
  }

  function reloadAgendamentosPage() {
    location.href = buildAgendamentosUrl(AGENDAMENTOS_VIEW);
  }

  function switchAgendamentosView(nextView, updateHistory) {
    if (!nextView) return;
    AGENDAMENTOS_VIEW = nextView;

    document.querySelectorAll('[data-view-panel]').forEach(function (panel) {
      panel.hidden = panel.getAttribute('data-view-panel') !== nextView;
    });

    document.querySelectorAll('[data-view-tab]').forEach(function (tab) {
      tab.classList.toggle('is-active', tab.getAttribute('data-view-tab') === nextView);
    });

    document.querySelectorAll('[data-header-for]').forEach(function (wrap) {
      wrap.hidden = wrap.getAttribute('data-header-for') !== nextView;
    });

    if (updateHistory !== false && window.history && window.history.pushState) {
      window.history.pushState({ agView: nextView }, '', buildAgendamentosUrl(nextView));
    }
  }

  document.querySelectorAll('[data-view-tab]').forEach(function (tab) {
    tab.addEventListener('click', function (e) {
      e.preventDefault();
      switchAgendamentosView(tab.getAttribute('data-view-tab'), true);
    });
  });

  window.addEventListener('popstate', function () {
    var params = new URLSearchParams(window.location.search);
    var v = params.get('view') || 'agenda';
    if (['agenda', 'servicos', 'profissionais', 'config'].indexOf(v) >= 0) {
      switchAgendamentosView(v, false);
    }
  });

  function safeToast(message, type) {
    if (typeof window.neofarmaToast === 'function') {
      window.neofarmaToast(message, type);
      return;
    }
    var host = document.getElementById('local_toast_fallback');
    if (!host) {
      host = document.createElement('div');
      host.id = 'local_toast_fallback';
      host.style.position = 'fixed';
      host.style.right = '16px';
      host.style.bottom = '16px';
      host.style.zIndex = '2000';
      host.style.display = 'flex';
      host.style.flexDirection = 'column';
      host.style.gap = '8px';
      document.body.appendChild(host);
    }
    var level = String(type || 'info').toLowerCase();
    var cssClass = 'alert-info';
    if (level === 'success') cssClass = 'alert-success';
    if (level === 'danger' || level === 'error') cssClass = 'alert-danger';
    if (level === 'warning') cssClass = 'alert-warning';
    var item = document.createElement('div');
    item.className = 'alert ' + cssClass;
    item.style.margin = '0';
    item.style.minWidth = '260px';
    item.style.maxWidth = '420px';
    item.textContent = String(message || '');
    host.appendChild(item);
    setTimeout(function () {
      if (item && item.parentNode) item.parentNode.removeChild(item);
    }, 3500);
  }

  function showPageFlash(message, type) {
    var wrap = document.getElementById('pageFlash');
    var alertEl = document.getElementById('pageFlashAlert');
    var textEl = document.getElementById('pageFlashText');
    if (!wrap || !alertEl || !textEl) return;
    alertEl.className = 'alert alert-dismissible fade show mb-0 alert-' + (type === 'danger' ? 'danger' : (type === 'warning' ? 'warning' : 'success'));
    textEl.textContent = message;
    wrap.style.display = 'block';
  }

  (function initPageFlash() {
    try {
      var raw = sessionStorage.getItem('agendamentosAdminFlash');
      if (!raw) return;
      sessionStorage.removeItem('agendamentosAdminFlash');
      var data = JSON.parse(raw);
      if (data && data.view && data.view !== AGENDAMENTOS_VIEW) {
        switchAgendamentosView(data.view, true);
      }
      if (data && data.message) showPageFlash(data.message, data.type || 'success');
    } catch (e) { /* ignore */ }
  })();

  function setAgFlashAndReload(message, type) {
    try {
      sessionStorage.setItem('agendamentosAdminFlash', JSON.stringify({
        type: type || 'success',
        message: message,
        view: AGENDAMENTOS_VIEW
      }));
    } catch (e) { /* ignore */ }
    reloadAgendamentosPage();
  }

  function setFormAlert(alertId, message) {
    var el = document.getElementById(alertId);
    if (!el) return;
    if (!message) { el.style.display = 'none'; el.textContent = ''; return; }
    el.style.display = 'block';
    el.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> ' + message;
  }

  function clearFieldError(fieldId) {
    var input = document.getElementById(fieldId);
    var err = document.getElementById(fieldId + '_error');
    if (input) input.classList.remove('is-invalid');
    if (err) err.style.display = 'none';
  }

  function setFieldError(fieldId, message) {
    var input = document.getElementById(fieldId);
    var err = document.getElementById(fieldId + '_error');
    if (input) input.classList.add('is-invalid');
    if (err && message) { err.textContent = message; err.style.display = 'block'; }
  }

  function isValidEmail(value) {
    if (!value) return true;
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(value).trim());
  }

  function isValidTimeHHMM(value) {
    return /^([01]\d|2[0-3]):[0-5]\d$/.test(String(value || '').trim());
  }

  function bindFieldClear(fieldIds, alertId) {
    fieldIds.forEach(function (id) {
      var el = document.getElementById(id);
      if (!el) return;
      el.addEventListener('input', function () { clearFieldError(id); if (alertId) setFormAlert(alertId, ''); });
      el.addEventListener('change', function () { clearFieldError(id); if (alertId) setFormAlert(alertId, ''); });
    });
  }

  bindFieldClear(['svc_name', 'svc_price', 'svc_duration', 'svc_min_age', 'svc_max_age', 'svc_obs_minutes'], 'svcFormAlert');
  bindFieldClear(['pro_name', 'pro_email', 'pro_phone', 'pro_council_uf', 'pro_council_number'], 'proFormAlert');
  for (var dBind = 1; dBind <= 6; dBind++) {
    bindFieldClear(['pro_' + dBind + '_start', 'pro_' + dBind + '_end'], 'proFormAlert');
  }
  bindFieldClear([
    'res_service_id', 'res_professional_id', 'res_customer_name', 'res_customer_email', 'res_customer_phone',
    'res_scheduled_date', 'res_zip_code', 'res_street', 'res_number', 'res_district', 'res_city', 'res_state'
  ], 'reserveFormAlert');
  bindFieldClear(['finish_clinical', 'finish_batch', 'finish_batch_exp'], 'finishFormAlert');
  bindFieldClear(['incomplete_reason', 'incomplete_refund_percent'], 'incompleteFormAlert');
  bindFieldClear(['hol_date', 'hol_name'], 'holFormAlert');

  function clearSvcValidation() {
    setFormAlert('svcFormAlert', '');
    ['svc_name', 'svc_price', 'svc_duration', 'svc_min_age', 'svc_max_age', 'svc_obs_minutes'].forEach(clearFieldError);
  }

  function validateSvcForm() {
    clearSvcValidation();
    var errors = {};
    var name = (document.getElementById('svc_name').value || '').trim();
    var price = Number(document.getElementById('svc_price').value);
    var duration = Number(document.getElementById('svc_duration').value);
    var minAgeRaw = document.getElementById('svc_min_age').value;
    var maxAgeRaw = document.getElementById('svc_max_age').value;
    var obs = Number(document.getElementById('svc_obs_minutes').value || 0);

    if (!name || name.length < 2) errors.svc_name = 'Informe o nome do serviço (mín. 2 caracteres).';
    if (!Number.isFinite(price) || price < 0) errors.svc_price = 'Informe um preço válido (zero ou maior).';
    if (!Number.isFinite(duration) || duration <= 0) errors.svc_duration = 'Informe a duração em minutos (maior que zero).';
    if (minAgeRaw !== '' && (!Number.isFinite(Number(minAgeRaw)) || Number(minAgeRaw) < 0 || Number(minAgeRaw) > 120)) {
      errors.svc_min_age = 'Idade mínima deve estar entre 0 e 120.';
    }
    if (maxAgeRaw !== '' && (!Number.isFinite(Number(maxAgeRaw)) || Number(maxAgeRaw) < 0 || Number(maxAgeRaw) > 120)) {
      errors.svc_max_age = 'Idade máxima deve estar entre 0 e 120.';
    }
    if (minAgeRaw !== '' && maxAgeRaw !== '' && Number(maxAgeRaw) < Number(minAgeRaw)) {
      errors.svc_max_age = 'Idade máxima não pode ser menor que a mínima.';
    }
    if (!Number.isFinite(obs) || obs < 0 || obs > 240) errors.svc_obs_minutes = 'Tempo de observação deve estar entre 0 e 240 min.';

    var keys = Object.keys(errors);
    if (keys.length) {
      keys.forEach(function (k) { setFieldError(k, errors[k]); });
      setFormAlert('svcFormAlert', 'Revise os campos destacados antes de salvar.');
      return false;
    }
    return true;
  }

  function clearProValidation() {
    setFormAlert('proFormAlert', '');
    ['pro_name', 'pro_email', 'pro_phone', 'pro_council_uf', 'pro_council_number'].forEach(clearFieldError);
    var avErr = document.getElementById('pro_availability_error');
    if (avErr) avErr.style.display = 'none';
  }

  function validateProForm() {
    clearProValidation();
    var errors = {};
    var name = (document.getElementById('pro_name').value || '').trim();
    var email = (document.getElementById('pro_email').value || '').trim();
    var phone = onlyDigits(document.getElementById('pro_phone').value);
    var uf = (document.getElementById('pro_council_uf').value || '').trim().toUpperCase();
    var council = (document.getElementById('pro_council_number').value || '').trim();

    if (!name || name.length < 3) errors.pro_name = 'Informe o nome completo do profissional.';
    if (email && !isValidEmail(email)) errors.pro_email = 'Informe um e-mail válido.';
    if (phone && phone.length < 10) errors.pro_phone = 'Informe um telefone com DDD (mín. 10 dígitos).';
    if (!/^[A-Z]{2}$/.test(uf)) errors.pro_council_uf = 'Informe a UF com 2 letras (ex.: SP).';
    if (!council || council.length < 3) errors.pro_council_number = 'Informe o número de registro profissional.';

    var availability = [];
    for (var d = 1; d <= 6; d++) {
      var start = (document.getElementById('pro_' + d + '_start').value || '').trim();
      var end = (document.getElementById('pro_' + d + '_end').value || '').trim();
      if (start || end) {
        if (!isValidTimeHHMM(start) || !isValidTimeHHMM(end)) {
          errors['pro_' + d + '_start'] = 'Horário inválido. Use HH:MM.';
          break;
        }
        if (start >= end) {
          errors['pro_' + d + '_end'] = 'Horário final deve ser após o inicial.';
          break;
        }
        availability.push({ day_of_week: d, start_time: start, end_time: end });
      }
    }
    if (!availability.length) {
      var avErr = document.getElementById('pro_availability_error');
      if (avErr) avErr.style.display = 'block';
    }

    var keys = Object.keys(errors);
    if (keys.length || !availability.length) {
      keys.forEach(function (k) { setFieldError(k, errors[k]); });
      setFormAlert('proFormAlert', !availability.length
        ? 'Cadastre ao menos um dia com horário de início e fim válidos.'
        : 'Revise os campos destacados antes de salvar.');
      return false;
    }
    return true;
  }

  function clearReserveValidation() {
    setFormAlert('reserveFormAlert', '');
    [
      'res_service_id', 'res_professional_id', 'res_customer_name', 'res_customer_email', 'res_customer_phone',
      'res_scheduled_date', 'res_zip_code', 'res_street', 'res_number', 'res_district', 'res_city', 'res_state'
    ].forEach(clearFieldError);
    var slotErr = document.getElementById('res_scheduled_start_error');
    if (slotErr) slotErr.style.display = 'none';
  }

  function validateReserveForm() {
    clearReserveValidation();
    var errors = {};
    var serviceId = document.getElementById('res_service_id').value;
    var professionalId = document.getElementById('res_professional_id').value;
    var customerName = (document.getElementById('res_customer_name').value || '').trim();
    var customerEmail = (document.getElementById('res_customer_email').value || '').trim();
    var customerPhone = onlyDigits(document.getElementById('res_customer_phone').value);
    var scheduledDate = document.getElementById('res_scheduled_date').value;
    var whenStr = document.getElementById('res_scheduled_start').value;
    var modality = document.getElementById('res_modality').value;

    if (!serviceId) errors.res_service_id = 'Selecione o serviço.';
    if (!professionalId) errors.res_professional_id = 'Selecione o profissional.';
    if (!customerName || customerName.length < 2) errors.res_customer_name = 'Informe o nome do cliente.';
    if (customerEmail && !isValidEmail(customerEmail)) errors.res_customer_email = 'Informe um e-mail válido.';
    if (!customerPhone || customerPhone.length < 10) errors.res_customer_phone = 'Informe um telefone com DDD.';
    if (!scheduledDate) errors.res_scheduled_date = 'Selecione a data do agendamento.';
    if (!whenStr) {
      var slotErr = document.getElementById('res_scheduled_start_error');
      if (slotErr) slotErr.style.display = 'block';
    }

    if (modality === 'HOME') {
      var zip = onlyDigits(document.getElementById('res_zip_code').value);
      if (zip.length !== 8) errors.res_zip_code = 'Informe um CEP válido com 8 dígitos.';
      if (!(document.getElementById('res_street').value || '').trim()) errors.res_street = 'Informe a rua.';
      if (!(document.getElementById('res_number').value || '').trim()) errors.res_number = 'Informe o número.';
      if (!(document.getElementById('res_district').value || '').trim()) errors.res_district = 'Informe o bairro.';
      if (!(document.getElementById('res_city').value || '').trim()) errors.res_city = 'Informe a cidade.';
      if (!/^[A-Za-z]{2}$/.test((document.getElementById('res_state').value || '').trim())) errors.res_state = 'Informe a UF com 2 letras.';
    }

    var keys = Object.keys(errors);
    if (keys.length || !whenStr) {
      keys.forEach(function (k) { setFieldError(k, errors[k]); });
      setFormAlert('reserveFormAlert', 'Revise os campos destacados antes de reservar.');
      return false;
    }
    return true;
  }

