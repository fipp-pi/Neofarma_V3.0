  async function postAct(url, body, opts) {
    opts = opts || {};
    const method = opts.method || 'POST';
    try {
      const resp = await fetch(url, { method: method, headers: { 'Content-Type': 'application/json' }, body: method === 'DELETE' ? undefined : JSON.stringify(body || {}) });
      const text = await resp.text();
      let data = {};
      try { data = text ? JSON.parse(text) : {}; } catch (e) { data = {}; }
      if (!resp.ok && !data.message) data.message = 'Erro na operação (HTTP ' + resp.status + ').';
      if (data.ok) {
        if (opts.reload !== false) {
          setAgFlashAndReload(data.message || 'Operação realizada.', 'success');
        } else {
          safeToast(data.message || 'Operação realizada.', 'success');
        }
      } else {
        safeToast(data.message || 'Erro na operação.', 'danger');
      }
      return data;
    } catch (err) {
      safeToast('Erro de conexão. Tente novamente.', 'danger');
      return { ok: false };
    }
  }

