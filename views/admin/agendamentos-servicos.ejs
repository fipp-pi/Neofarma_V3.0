<%- include('partials/header') %>

<%
  const currentView = typeof activeView !== 'undefined' ? String(activeView) : 'agenda';
  const servicesList = Array.isArray(services) ? services : [];
  const professionalsList = Array.isArray(professionals) ? professionals : [];
  const servicesTotalCount = servicesList.length;
  const professionalsTotalCount = professionalsList.length;
  const statsData = {
    servicesCount: servicesTotalCount,
    professionalsCount: professionalsTotalCount,
    holidaysCount: Array.isArray(holidays) ? holidays.length : 0,
    filteredAppointments: Array.isArray(appointments) ? appointments.length : 0,
  };
  function agUrl(v, extra) {
    var target = v || currentView;
    var q = 'view=' + encodeURIComponent(target);
    if (target === 'agenda') {
      q += '&status=' + encodeURIComponent((extra && extra.status) ? extra.status : statusFilter);
    }
    return '/admin/agendamentos-servicos?' + q;
  }
  const mainTabs = [
    { v: 'agenda', l: 'Agenda', icon: 'bi-calendar2-check' },
    { v: 'servicos', l: 'Serviços', icon: 'bi-heart-pulse' },
    { v: 'profissionais', l: 'Profissionais', icon: 'bi-person-badge' },
    { v: 'config', l: 'Configurações', icon: 'bi-gear' },
  ];
  const aptStatusTabs = [
    { v: 'ALL', l: 'Todos', icon: 'bi-grid' },
    { v: 'RESERVED', l: 'Reservados', icon: 'bi-hourglass' },
    { v: 'PAYMENT_FAILED', l: 'Pag. falhou', icon: 'bi-x-circle' },
    { v: 'CONFIRMED', l: 'Confirmados', icon: 'bi-check-circle' },
    { v: 'IN_PROGRESS', l: 'Em atendimento', icon: 'bi-play-circle' },
    { v: 'COMPLETED', l: 'Concluídos', icon: 'bi-flag' },
    { v: 'CANCELLED', l: 'Cancelados', icon: 'bi-slash-circle' },
    { v: 'NO_SHOW', l: 'Ausentes', icon: 'bi-person-x' },
    { v: 'INCOMPLETE', l: 'Não finalizados', icon: 'bi-exclamation-square' },
  ];
  const APT_STATUS_LABELS = {
    RESERVED: 'Reservado',
    PAYMENT_FAILED: 'Pag. falhou',
    CONFIRMED: 'Confirmado',
    IN_PROGRESS: 'Em atendimento',
    COMPLETED: 'Concluído',
    CANCELLED: 'Cancelado',
    NO_SHOW: 'Ausente',
    INCOMPLETE: 'Não finalizado',
  };
  const APT_STATUS_BADGE = {
    RESERVED: 'warning',
    PAYMENT_FAILED: 'danger',
    CONFIRMED: 'info',
    IN_PROGRESS: 'primary',
    COMPLETED: 'success',
    CANCELLED: 'muted',
    NO_SHOW: 'muted',
    INCOMPLETE: 'warning',
  };
  const PAY_STATUS_LABELS_PT = { PENDING: 'Pendente', PAID: 'Pago', FAILED: 'Falhou', REFUNDED_PARTIAL: 'Estorno parcial' };
  const PAY_STATUS_BADGE = { PENDING: 'warning', PAID: 'success', FAILED: 'danger', REFUNDED_PARTIAL: 'info' };
  const PAY_METHOD_LABELS = { CASH: 'Dinheiro', PIX: 'PIX', CREDIT_CARD: 'Cartão crédito', DEBIT_CARD: 'Cartão débito' };
  const PAY_METHOD_ICONS = { CASH: 'bi-cash-coin', PIX: 'bi-qr-code-scan', CREDIT_CARD: 'bi-credit-card-2-front', DEBIT_CARD: 'bi-credit-card' };
%>

<div class="container admin-agendamentos">
  <div id="pageFlash" class="mb-3" style="display:none;">
    <div class="alert alert-dismissible fade show mb-0" id="pageFlashAlert" role="alert">
      <span id="pageFlashText"></span>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
  </div>

  <div class="list-header">
    <div>
      <h2 class="neo-heading">Agendamentos de serviços</h2>
      <p class="text-muted mb-0">Gerencie agendamentos de serviços de saúde, do registro e pagamento até a execução e conclusão do atendimento.</p>
    </div>
    <div class="d-flex flex-wrap gap-2" id="agendamentos_header_actions">
      <div class="admin-agendamentos__header-actions" data-header-for="agenda" <%= currentView !== 'agenda' ? 'hidden' : '' %>>
        <a href="/admin/agendamentos-servicos/caixa" class="btn btn-outline-primary btn-sm"><i class="bi bi-cash-coin me-1"></i> Caixa</a>
        <button type="button" class="btn btn-save btn-sm" data-bs-toggle="modal" data-bs-target="#modalReserve" onclick="novoAgendamento()">
          <i class="bi bi-calendar-plus me-1"></i> Novo agendamento
        </button>
      </div>
      <div class="admin-agendamentos__header-actions" data-header-for="servicos" <%= currentView !== 'servicos' ? 'hidden' : '' %>>
        <button type="button" class="btn btn-save btn-sm" data-bs-toggle="modal" data-bs-target="#modalService" onclick="novoServico()">
          <i class="bi bi-plus-lg me-1"></i> Novo serviço
        </button>
      </div>
      <div class="admin-agendamentos__header-actions" data-header-for="profissionais" <%= currentView !== 'profissionais' ? 'hidden' : '' %>>
        <button type="button" class="btn btn-save btn-sm" data-bs-toggle="modal" data-bs-target="#modalProfessional" onclick="novoProfissional()">
          <i class="bi bi-person-plus me-1"></i> Novo profissional
        </button>
      </div>
    </div>
  </div>

  <nav class="admin-agendamentos__main-tabs mb-4" aria-label="Seções de agendamentos">
    <% mainTabs.forEach(function (t) { %>
      <a href="<%= agUrl(t.v) %>" class="admin-agendamentos__main-tab <%= currentView === t.v ? 'is-active' : '' %>" data-view-tab="<%= t.v %>">
        <i class="bi <%= t.icon %> me-1"></i><%= t.l %>
      </a>
    <% }); %>
  </nav>

  <div class="admin-agendamentos-view" data-view-panel="agenda" <%= currentView !== 'agenda' ? 'hidden' : '' %>>
  <div class="admin-agendamentos__stats row g-3 mb-4">
    <div class="col-6 col-lg-3">
      <a href="<%= agUrl('agenda', { status: 'RESERVED' }) %>" class="admin-agendamentos__stat admin-agendamentos__stat--warning text-decoration-none">
        <span class="admin-agendamentos__stat-icon"><i class="bi bi-hourglass"></i></span>
        <div><div class="admin-agendamentos__stat-value"><%= summary.reserved %></div><div class="admin-agendamentos__stat-label">Reservados / pendências</div></div>
      </a>
    </div>
    <div class="col-6 col-lg-3">
      <a href="<%= agUrl('agenda', { status: 'CONFIRMED' }) %>" class="admin-agendamentos__stat admin-agendamentos__stat--info text-decoration-none">
        <span class="admin-agendamentos__stat-icon"><i class="bi bi-check-circle"></i></span>
        <div><div class="admin-agendamentos__stat-value"><%= summary.confirmed %></div><div class="admin-agendamentos__stat-label">Confirmados</div></div>
      </a>
    </div>
    <div class="col-6 col-lg-3">
      <a href="<%= agUrl('agenda', { status: 'IN_PROGRESS' }) %>" class="admin-agendamentos__stat admin-agendamentos__stat--primary text-decoration-none">
        <span class="admin-agendamentos__stat-icon"><i class="bi bi-play-circle"></i></span>
        <div><div class="admin-agendamentos__stat-value"><%= summary.inProgress %></div><div class="admin-agendamentos__stat-label">Em atendimento</div></div>
      </a>
    </div>
    <div class="col-6 col-lg-3">
      <a href="<%= agUrl('agenda', { status: 'COMPLETED' }) %>" class="admin-agendamentos__stat admin-agendamentos__stat--success text-decoration-none">
        <span class="admin-agendamentos__stat-icon"><i class="bi bi-flag"></i></span>
        <div><div class="admin-agendamentos__stat-value"><%= summary.completed %></div><div class="admin-agendamentos__stat-label">Concluídos</div></div>
      </a>
    </div>
  </div>

  <% if ((summary.reserved || 0) > 0) { %>
  <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
      <strong><i class="bi bi-exclamation-triangle me-1"></i> Pendências:</strong>
      existem <strong><%= summary.reserved %></strong> agendamento(s) aguardando pagamento ou confirmação. Revise antes que a reserva expire.
    </div>
    <a class="btn btn-sm btn-warning" href="<%= agUrl('agenda', { status: 'RESERVED' }) %>">Ver pendências</a>
  </div>
  <% } %>

  <% if ((summary.inProgress || 0) > 0) { %>
  <div class="alert alert-primary d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
      <strong><i class="bi bi-play-circle me-1"></i> Em andamento:</strong>
      <%= summary.inProgress %> atendimento(s) em execução no momento.
    </div>
    <a class="btn btn-sm btn-primary" href="<%= agUrl('agenda', { status: 'IN_PROGRESS' }) %>">Ver em atendimento</a>
  </div>
  <% } %>

  <% if (servicesTotalCount === 0) { %>
  <div class="alert alert-info d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
      <strong><i class="bi bi-heart-pulse me-1"></i> Catálogo vazio:</strong>
      cadastre ao menos um serviço de saúde antes de receber agendamentos.
    </div>
    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modalService" onclick="novoServico()">Cadastrar serviço</button>
  </div>
  <% } else if (professionalsTotalCount === 0) { %>
  <div class="alert alert-info d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
      <strong><i class="bi bi-person-badge me-1"></i> Sem profissionais:</strong>
      cadastre profissionais com disponibilidade semanal para liberar horários na agenda.
    </div>
    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modalProfessional" onclick="novoProfissional()">Cadastrar profissional</button>
  </div>
  <% } %>

  <div class="admin-agendamentos__tabs mb-3">
    <% aptStatusTabs.forEach(function (t) { %>
      <a href="<%= agUrl('agenda', { status: t.v }) %>" class="admin-agendamentos__tab <%= statusFilter === t.v ? 'is-active' : '' %>">
        <i class="bi <%= t.icon %> me-1"></i><%= t.l %>
      </a>
    <% }); %>
  </div>

  <section class="admin-agendamentos__panel admin-agendamentos__panel--table">
    <div class="admin-agendamentos__panel-head admin-agendamentos__panel-head--table">
      <h3 class="admin-agendamentos__panel-title"><i class="bi bi-calendar-week me-2"></i>Agenda e atendimentos</h3>
      <div class="d-flex flex-wrap gap-2 align-items-center">
        <div class="search-box admin-agendamentos__search">
          <i class="bi bi-search"></i>
          <input class="form-control form-control-sm" id="apt_search" placeholder="Buscar cliente, serviço, profissional...">
        </div>
        <select class="form-select form-select-sm admin-agendamentos__page-size" id="apt_page_size">
          <option value="10" selected>10 / pág.</option>
          <option value="20">20 / pág.</option>
          <option value="50">50 / pág.</option>
        </select>
      </div>
    </div>

    <% if (!appointments || !appointments.length) { %>
      <div class="admin-agendamentos__empty">
        <i class="bi bi-calendar-x d-block mb-2"></i>
        Nenhum agendamento neste filtro.
        <div class="mt-2">
          <button type="button" class="btn btn-sm btn-save" data-bs-toggle="modal" data-bs-target="#modalReserve" onclick="novoAgendamento()">
            <i class="bi bi-calendar-plus me-1"></i> Criar agendamento
          </button>
        </div>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover table-custom align-middle mb-0" id="table_appointments">
          <thead>
            <tr>
              <th class="col-id">#</th>
              <th>Cliente</th>
              <th>Serviço</th>
              <th>Profissional</th>
              <th>Horário</th>
              <th>Pagamento</th>
              <th class="col-status">Status</th>
              <th class="col-actions text-end">Ações</th>
            </tr>
          </thead>
          <tbody id="apt_tbody">
            <% (appointments || []).forEach(function (a) {
              var st = a.status || 'RESERVED';
              var stBadge = APT_STATUS_BADGE[st] || 'muted';
              var stLabel = t('appointmentStatus', st);
              var paySt = String(a.payment_status || 'PENDING').toUpperCase();
              var payLabel = t('paymentStatus', paySt);
              var payBadge = tPayBadge(paySt);
              var payMethodKey = String(a.payment_method || 'CASH').toUpperCase();
              var payMethodLabel = t('paymentMethod', payMethodKey);
              var payMethodIcon = PAY_METHOD_ICONS[payMethodKey] || 'bi-wallet2';
              var bookingCh = String(a.booking_channel || 'ADMIN').toUpperCase();
              var awaitingOnlinePay = (st === 'RESERVED' || st === 'PAYMENT_FAILED') && bookingCh === 'CUSTOMER_ONLINE';
              var legacyAdminReserve = (st === 'RESERVED' || st === 'PAYMENT_FAILED') && bookingCh === 'ADMIN';
              var awaitingPresencialPay = st === 'CONFIRMED' && paySt === 'PENDING';
              var canStartAttendance = st === 'CONFIRMED' && !awaitingOnlinePay;
              var canFinishAttendance = (st === 'CONFIRMED' || st === 'IN_PROGRESS') && !awaitingOnlinePay;
            %>
              <tr data-search="<%= [a.id, a.customer_name, a.customer_email, a.booking_channel, a.service_name, a.professional_name, a.professional_role, a.modality, a.payment_method, a.payment_status, a.status].filter(Boolean).join(' ').toLowerCase() %>">
                <td class="col-id fw-semibold">#<%= a.id %></td>
                <td>
                  <div class="fw-semibold cell-truncate-wide" title="<%= a.customer_name %>"><%= a.customer_name %></div>
                  <div class="small text-muted"><%= a.customer_email || '—' %></div>
                  <span class="admin-agendamentos__badge admin-agendamentos__badge--muted mt-1"><%= t('bookingChannel', a.booking_channel) %> · <%= t('modality', a.modality) %></span>
                </td>
                <td><span class="cell-truncate-wide" title="<%= a.service_name %>"><%= a.service_name %></span></td>
                <td>
                  <div><%= a.professional_name || '—' %></div>
                  <div class="small text-muted"><%= a.professional_role || '' %></div>
                </td>
                <td class="text-nowrap small"><%= fmtDateTime(a.scheduled_start) %></td>
                <td>
                  <div class="fw-semibold small">R$ <%= toMoney(a.total_amount) %></div>
                  <div class="small text-muted mt-1"><i class="bi <%= payMethodIcon %> me-1"></i><%= payMethodLabel %></div>
                  <span class="admin-agendamentos__badge admin-agendamentos__badge--<%= payBadge %> mt-1"><%= payLabel %></span>
                  <% if (paySt === 'REFUNDED_PARTIAL' && Number(a.refund_amount || 0) > 0) { %>
                    <div class="small text-muted mt-1">Estorno R$ <%= toMoney(a.refund_amount) %></div>
                  <% } %>
                </td>
                <td class="col-status"><span class="admin-agendamentos__badge admin-agendamentos__badge--<%= stBadge %>"><%= stLabel %></span></td>
                <td class="col-actions text-end">
                  <div class="table-actions table-actions--4 justify-content-end">
                    <button type="button" class="btn-action btn-view" title="Ver informações" onclick='verAgendamento(<%- JSON.stringify(a) %>)'><i class="bi bi-info-circle"></i></button>
                    <button type="button" class="btn-action btn-edit" title="Editar" onclick='editarAgendamento(<%- JSON.stringify(a) %>)'><i class="bi bi-pencil"></i></button>
                    <button type="button" class="btn-action btn-delete" title="Excluir" onclick="excluirAgendamento(<%= a.id %>)"><i class="bi bi-trash"></i></button>
                    <div class="dropdown apt-actions-dropdown">
                      <button type="button" class="btn-action btn-view dropdown-toggle" data-bs-toggle="dropdown" data-bs-auto-close="true" data-bs-popper-config='{"strategy":"fixed","modifiers":[{"name":"preventOverflow","options":{"boundary":"viewport","padding":12}},{"name":"flip","options":{"fallbackPlacements":["top-end","bottom-end","top-start","bottom-start"]}}]}' title="Mais ações" aria-label="Mais ações"><i class="bi bi-three-dots-vertical"></i></button>
                      <ul class="dropdown-menu dropdown-menu-end apt-actions-menu shadow">
                        <li><h6 class="dropdown-header px-3 py-2 mb-0">Agendamento #<%= a.id %></h6></li>
                        <li><span class="dropdown-item-text small text-muted px-3 pb-2"><%= stLabel %> · <%= payLabel %> · <%= payMethodLabel %></span></li>
                        <% if (awaitingOnlinePay) { %>
                          <li><h6 class="dropdown-header">Pagamento online</h6></li>
                          <li><button class="dropdown-item" type="button" onclick="confirmarPagamento(<%= a.id %>, true)"><i class="bi bi-check-circle me-2"></i>Confirmar pagamento online</button></li>
                          <li><button class="dropdown-item" type="button" onclick="confirmarPagamento(<%= a.id %>, false)"><i class="bi bi-x-circle me-2"></i>Recusar pagamento</button></li>
                        <% } %>
                        <% if (legacyAdminReserve) { %>
                          <li><h6 class="dropdown-header">Regularizar agendamento</h6></li>
                          <li><button class="dropdown-item" type="button" onclick="confirmarPagamento(<%= a.id %>, true)"><i class="bi bi-check-circle me-2"></i>Efetivar agendamento</button></li>
                          <li><button class="dropdown-item" type="button" onclick="confirmarPagamento(<%= a.id %>, false)"><i class="bi bi-x-circle me-2"></i>Cancelar reserva</button></li>
                        <% } %>
                        <% if (awaitingPresencialPay) { %>
                          <li><h6 class="dropdown-header">Pagamento no caixa</h6></li>
                          <li><button class="dropdown-item" type="button" onclick="confirmarRecebimento(<%= a.id %>, '<%= payMethodKey %>')"><i class="bi <%= payMethodIcon %> me-2"></i>Registrar recebimento (<%= payMethodLabel %>)</button></li>
                        <% } %>
                        <% if (canStartAttendance) { %>
                          <li><h6 class="dropdown-header">Atendimento</h6></li>
                          <li><button class="dropdown-item" type="button" onclick="iniciarAtendimento(<%= a.id %>)"><i class="bi bi-play-circle me-2"></i>Iniciar atendimento</button></li>
                        <% } %>
                        <% if (canFinishAttendance) { %>
                          <% if (!canStartAttendance && !awaitingPresencialPay && !awaitingOnlinePay) { %><li><h6 class="dropdown-header">Atendimento</h6></li><% } %>
                          <li><button class="dropdown-item" type="button" onclick='abrirConcluir(<%- JSON.stringify(a) %>)'><i class="bi bi-check2-square me-2"></i>Concluir</button></li>
                          <li><button class="dropdown-item" type="button" onclick='abrirIncompleto(<%- JSON.stringify(a) %>)'><i class="bi bi-exclamation-square me-2"></i>Não finalizado</button></li>
                          <li><button class="dropdown-item" type="button" onclick="marcarAusente(<%= a.id %>)"><i class="bi bi-person-x me-2"></i>Marcar ausente</button></li>
                        <% } %>
                        <% if (!awaitingOnlinePay && !legacyAdminReserve && !awaitingPresencialPay && !canStartAttendance && !canFinishAttendance) { %>
                          <li><span class="dropdown-item-text small text-muted px-3">Nenhuma ação disponível neste status.</span></li>
                        <% } %>
                      </ul>
                    </div>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="admin-agendamentos__pagination-bar">
        <div class="small text-muted" id="apt_pagination_info">0 agendamento(s)</div>
        <div class="btn-group btn-group-sm" id="apt_pagination_controls"></div>
      </div>
    <% } %>
  </section>
  </div>

  <div class="admin-agendamentos-view" data-view-panel="servicos" <%= currentView !== 'servicos' ? 'hidden' : '' %>>
  <section class="admin-agendamentos__panel">
    <div class="admin-agendamentos__panel-head admin-agendamentos__panel-head--table">
      <h3 class="admin-agendamentos__panel-title"><i class="bi bi-heart-pulse me-2"></i>Catálogo de serviços</h3>
      <span class="admin-agendamentos__panel-meta"><%= servicesTotalCount %> serviço(s) cadastrado(s)</span>
    </div>
    <% if (!services || !services.length) { %>
      <div class="admin-agendamentos__empty">
        <i class="bi bi-heart d-block mb-2"></i>
        Nenhum serviço cadastrado.
        <div class="mt-2"><button type="button" class="btn btn-sm btn-save" data-bs-toggle="modal" data-bs-target="#modalService" onclick="novoServico()">Cadastrar serviço</button></div>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover table-custom align-middle mb-0">
          <thead>
            <tr><th>Serviço</th><th>Preço</th><th>Duração</th><th>Domicílio</th><th>Receita</th><th class="col-status">Status</th><th class="col-actions text-end">Ações</th></tr>
          </thead>
          <tbody>
            <% (services || []).forEach(function (s) { %>
              <tr>
                <td class="fw-semibold"><span class="cell-truncate-wide" title="<%= s.name %>"><%= s.name %></span></td>
                <td>R$ <%= toMoney(s.price) %></td>
                <td><%= s.duration_minutes %> min</td>
                <td><span class="admin-agendamentos__badge admin-agendamentos__badge--<%= s.home_available ? 'success' : 'muted' %>"><%= s.home_available ? 'Sim' : 'Não' %></span></td>
                <td><span class="admin-agendamentos__badge admin-agendamentos__badge--<%= s.requires_prescription ? 'warning' : 'info' %>"><%= s.requires_prescription ? 'Obrigatória' : 'Não' %></span></td>
                <td class="col-status"><span class="admin-agendamentos__badge admin-agendamentos__badge--<%= s.is_active ? 'success' : 'muted' %>"><%= s.is_active ? 'Ativo' : 'Inativo' %></span></td>
                <td class="col-actions text-end">
                  <div class="table-actions table-actions--3 justify-content-end">
                    <button type="button" class="btn-action btn-view" title="Ver informações" onclick='verServico(<%- JSON.stringify(s) %>)'><i class="bi bi-info-circle"></i></button>
                    <button type="button" class="btn-action btn-edit" title="Editar" onclick='editarServico(<%- JSON.stringify(s) %>)'><i class="bi bi-pencil"></i></button>
                    <button type="button" class="btn-action btn-delete" title="Excluir" onclick="excluirServico(<%= s.id %>)"><i class="bi bi-trash"></i></button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
  </div>

  <div class="admin-agendamentos-view" data-view-panel="profissionais" <%= currentView !== 'profissionais' ? 'hidden' : '' %>>
  <section class="admin-agendamentos__panel">
    <div class="admin-agendamentos__panel-head admin-agendamentos__panel-head--table">
      <h3 class="admin-agendamentos__panel-title"><i class="bi bi-person-badge me-2"></i>Profissionais de saúde</h3>
      <div class="d-flex flex-wrap gap-2 align-items-center">
        <div class="search-box admin-agendamentos__search">
          <i class="bi bi-search"></i>
          <input class="form-control form-control-sm" id="pro_search" placeholder="Buscar profissional...">
        </div>
        <select class="form-select form-select-sm admin-agendamentos__page-size" id="pro_page_size">
          <option value="10" selected>10 / pág.</option>
          <option value="20">20 / pág.</option>
          <option value="50">50 / pág.</option>
        </select>
      </div>
    </div>
    <% if (!professionals || !professionals.length) { %>
      <div class="admin-agendamentos__empty">
        <i class="bi bi-person-x d-block mb-2"></i>
        Nenhum profissional cadastrado.
        <div class="mt-2"><button type="button" class="btn btn-sm btn-save" data-bs-toggle="modal" data-bs-target="#modalProfessional" onclick="novoProfissional()">Cadastrar profissional</button></div>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover table-custom align-middle mb-0" id="table_professionals">
          <thead>
            <tr><th>Nome</th><th>Cargo</th><th>Registro</th><th>Contato</th><th class="col-status">Status</th><th class="col-actions text-end">Ações</th></tr>
          </thead>
          <tbody id="pro_tbody">
            <% (professionals || []).forEach(function (p) { %>
              <tr data-search="<%= [p.full_name, p.role_name, p.council_type, p.council_uf, p.council_number, p.email, p.phone].filter(Boolean).join(' ').toLowerCase() %>">
                <td class="fw-semibold"><%= p.full_name %></td>
                <td><%= p.role_name %></td>
                <td class="small"><%= p.council_type %>/<%= p.council_uf %> <%= p.council_number %></td>
                <td>
                  <div class="small"><%= p.email || '—' %></div>
                  <div class="small text-muted"><%= p.phone || '—' %></div>
                </td>
                <td class="col-status"><span class="admin-agendamentos__badge admin-agendamentos__badge--<%= p.is_active ? 'success' : 'muted' %>"><%= p.is_active ? 'Ativo' : 'Inativo' %></span></td>
                <td class="col-actions text-end">
                  <div class="table-actions table-actions--3 justify-content-end">
                    <button type="button" class="btn-action btn-view" title="Ver informações" onclick='verProfissional(<%- JSON.stringify(p) %>)'><i class="bi bi-info-circle"></i></button>
                    <button type="button" class="btn-action btn-edit" title="Editar" onclick='editarProfissional(<%- JSON.stringify(p) %>)'><i class="bi bi-pencil"></i></button>
                    <button type="button" class="btn-action btn-delete" title="Excluir" onclick="excluirProfissional(<%= p.id %>)"><i class="bi bi-trash"></i></button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="admin-agendamentos__pagination-bar">
        <div class="small text-muted" id="pro_pagination_info">0 profissional(is)</div>
        <div class="btn-group btn-group-sm" id="pro_pagination_controls"></div>
      </div>
    <% } %>
  </section>
  </div>

  <div class="admin-agendamentos-view" data-view-panel="config" <%= currentView !== 'config' ? 'hidden' : '' %>>
  <section class="admin-agendamentos__panel">
    <div class="admin-agendamentos__panel-head">
      <h3 class="admin-agendamentos__panel-title"><i class="bi bi-calendar-x me-2"></i>Feriados e bloqueios de agenda</h3>
    </div>
    <div class="admin-agendamentos__panel-body">
      <p class="text-muted small mb-3">Datas cadastradas aqui impedem novos agendamentos. Use para feriados nacionais, recessos ou indisponibilidades da unidade.</p>
      <div id="holFormAlert" class="alert alert-danger py-2 px-3 small mb-3" role="alert" style="display:none;"></div>
      <div class="row g-2 mb-3 align-items-end">
        <div class="col-md-3">
          <label for="hol_date" class="form-label field-required">Data</label>
          <input class="form-control" id="hol_date" type="date">
          <div class="invalid-feedback" id="hol_date_error">Selecione a data do feriado.</div>
        </div>
        <div class="col-md-5">
          <label for="hol_name" class="form-label field-required">Nome do feriado</label>
          <input class="form-control" id="hol_name" maxlength="120" placeholder="Ex.: Natal, Ano Novo">
          <div class="invalid-feedback" id="hol_name_error">Informe o nome do feriado.</div>
        </div>
        <div class="col-md-4 d-grid">
          <button type="button" class="btn btn-save" id="btnSalvarFeriado" onclick="salvarFeriado()"><i class="bi bi-plus-lg me-1"></i> Adicionar feriado</button>
        </div>
      </div>
      <% if (!holidays || !holidays.length) { %>
        <div class="admin-agendamentos__empty py-4">
          <i class="bi bi-calendar-check d-block mb-2"></i>
          Nenhum feriado cadastrado.
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover table-custom align-middle mb-0">
            <thead><tr><th>Data</th><th>Nome</th><th class="text-end col-actions">Ação</th></tr></thead>
            <tbody>
              <% (holidays || []).forEach(function (h) { %>
                <tr>
                  <td class="text-nowrap"><%= fmtDate(h.holiday_date) %></td>
                  <td><%= h.name %></td>
                  <td class="text-end">
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removerFeriado(<%= h.id %>)"><i class="bi bi-trash me-1"></i> Remover</button>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </section>
  </div>
</div>

<style>
  .admin-agendamentos__header-actions { display: inline-flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }

  .admin-agendamentos__main-tabs { display: flex; flex-wrap: wrap; gap: 0.5rem; border-bottom: 1px solid rgba(0,0,0,0.08); padding-bottom: 0.75rem; }
  .admin-agendamentos__main-tab { display: inline-flex; align-items: center; padding: 0.55rem 1rem; border-radius: 10px 10px 0 0; border: 1px solid transparent; border-bottom: none; color: #495057; font-size: 0.9rem; font-weight: 600; text-decoration: none; margin-bottom: -1px; transition: color 0.16s ease, background 0.16s ease; }
  .admin-agendamentos__main-tab:hover { color: var(--accent-color); background: color-mix(in srgb, var(--accent-color), transparent 94%); }
  .admin-agendamentos__main-tab.is-active { color: var(--accent-color); background: #fff; border-color: rgba(0,0,0,0.08); border-bottom-color: #fff; box-shadow: 0 -2px 0 var(--accent-color) inset; }

  .admin-agendamentos__stats { margin-top: 0.25rem; }
  .admin-agendamentos__stat { display: flex; align-items: center; gap: 0.85rem; padding: 1rem 1.1rem; border-radius: 14px; border: 1px solid rgba(0,0,0,0.06); background: #fff; box-shadow: 0 4px 18px rgba(0,0,0,0.04); min-height: 88px; color: inherit; transition: transform 0.16s ease, box-shadow 0.16s ease; }
  a.admin-agendamentos__stat:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(0,0,0,0.08); }
  .admin-agendamentos__stat-icon { width: 44px; height: 44px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; font-size: 1.15rem; flex-shrink: 0; }
  .admin-agendamentos__stat--warning .admin-agendamentos__stat-icon { background: #fff8e6; color: #997404; }
  .admin-agendamentos__stat--info .admin-agendamentos__stat-icon { background: #e7f1ff; color: #0d6efd; }
  .admin-agendamentos__stat--primary .admin-agendamentos__stat-icon { background: color-mix(in srgb, var(--accent-color), transparent 88%); color: var(--accent-color); }
  .admin-agendamentos__stat--success .admin-agendamentos__stat-icon { background: #e8f6ee; color: #198754; }
  .admin-agendamentos__stat-value { font-size: 1.45rem; font-weight: 700; color: var(--heading-color); line-height: 1.1; }
  .admin-agendamentos__stat-label { font-size: 0.8rem; color: #6c757d; margin-top: 0.15rem; }

  .admin-agendamentos__tabs { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .admin-agendamentos__tab { display: inline-flex; align-items: center; padding: 0.4rem 0.75rem; border-radius: 999px; border: 1px solid rgba(0,0,0,0.08); background: #fff; color: #495057; font-size: 0.8rem; font-weight: 600; text-decoration: none; }
  .admin-agendamentos__tab:hover { border-color: color-mix(in srgb, var(--accent-color), transparent 70%); color: var(--accent-color); }
  .admin-agendamentos__tab.is-active { background: var(--accent-color); border-color: var(--accent-color); color: var(--contrast-color); }

  .admin-agendamentos__panel { background: #fff; border: 1px solid rgba(0,0,0,0.06); border-radius: 14px; box-shadow: 0 4px 18px rgba(0,0,0,0.04); overflow: hidden; }
  .admin-agendamentos__panel.admin-agendamentos__panel--table { overflow: visible; }
  .admin-agendamentos__panel-head { padding: 0.95rem 1.15rem; border-bottom: 1px solid rgba(0,0,0,0.06); background: linear-gradient(135deg, color-mix(in srgb, var(--accent-color), #fff 92%) 0%, #fff 100%); }
  .admin-agendamentos__panel-head--table { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; }
  .admin-agendamentos__panel-title { margin: 0; font-size: 0.98rem; font-weight: 700; color: var(--heading-color); }
  .admin-agendamentos__panel-meta { font-size: 0.8rem; color: #6c757d; }
  .admin-agendamentos__panel-body { padding: 1.15rem; }
  .admin-agendamentos__panel-body .form-label { font-size: 0.875rem; font-weight: 500; color: #495057; }

  .admin-agendamentos__search { min-width: min(100%, 240px); }
  .admin-agendamentos__search .form-control { padding-left: 2rem; border-radius: 8px; }
  .admin-agendamentos__page-size { width: 110px; border-radius: 8px; }

  .admin-agendamentos__panel .table-custom th { font-size: 0.72rem; padding: 0.85rem 1rem; }
  .admin-agendamentos__panel .table-custom td { padding: 0.85rem 1rem; font-size: 0.88rem; }

  .admin-agendamentos__badge { display: inline-block; font-size: 0.72rem; font-weight: 700; border-radius: 999px; padding: 0.22rem 0.55rem; white-space: nowrap; }
  .admin-agendamentos__badge--success { background: #d1e7dd; color: #0f5132; }
  .admin-agendamentos__badge--warning { background: #fff3cd; color: #664d03; }
  .admin-agendamentos__badge--info { background: #dbeafe; color: #0a58ca; }
  .admin-agendamentos__badge--primary { background: color-mix(in srgb, var(--accent-color), transparent 86%); color: var(--accent-color); }
  .admin-agendamentos__badge--danger { background: #f8d7da; color: #842029; }
  .admin-agendamentos__badge--muted { background: #e9ecef; color: #495057; }

  .admin-agendamentos__empty { padding: 3rem 1.5rem; text-align: center; color: #868e96; font-size: 0.92rem; }
  .admin-agendamentos__empty i { font-size: 2.2rem; opacity: 0.65; }

  .field-required::after { content: ' *'; color: #dc3545; font-weight: 600; }
  .admin-agendamentos .invalid-feedback { display: none; }
  .admin-agendamentos .form-control.is-invalid ~ .invalid-feedback,
  .admin-agendamentos .form-select.is-invalid ~ .invalid-feedback { display: block; }

  .admin-agendamentos__pagination-bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.75rem; padding: 0.85rem 1.15rem; border-top: 1px solid rgba(0,0,0,0.06); background: #fafbfc; }

  .btn-save { background: var(--accent-color); border-color: var(--accent-color); color: var(--contrast-color); font-weight: 600; border-radius: 8px; }
  .btn-save:hover { background: color-mix(in srgb, var(--accent-color), black 12%); border-color: color-mix(in srgb, var(--accent-color), black 12%); color: var(--contrast-color); }

  .admin-agendamentos .table-actions .dropdown .btn-action.dropdown-toggle::after { display: none; }

  .admin-agendamentos__panel .table-responsive { overflow-x: auto; overflow-y: visible; }

  .apt-actions-menu { min-width: 15rem; border: 1px solid rgba(0,0,0,0.08); border-radius: 12px; padding: 0.35rem 0; }
  .apt-actions-menu .dropdown-header { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: #868e96; padding-top: 0.5rem; }
  .apt-actions-menu .dropdown-item-text { white-space: normal; line-height: 1.35; }
  .apt-actions-menu .dropdown-item { font-size: 0.88rem; padding: 0.55rem 1rem; border-radius: 8px; margin: 0 0.35rem; width: calc(100% - 0.7rem); }
  .apt-actions-menu .dropdown-item:hover,
  .apt-actions-menu .dropdown-item:focus { background: color-mix(in srgb, var(--accent-color), transparent 92%); color: var(--heading-color); }
  .apt-actions-menu .dropdown-item i { opacity: 0.85; }
  .apt-actions-menu.apt-actions-menu--floating { z-index: 1085; max-height: min(70vh, 420px); overflow-y: auto; }

  .modal-cadastro .modal-content { border: none; border-radius: 12px; box-shadow: 0 12px 40px rgba(0,0,0,0.15); overflow: hidden; }
  .modal-cadastro .modal-header { background: var(--accent-color); color: var(--contrast-color); padding: 1rem 1.25rem; border-bottom: none; }
  .modal-cadastro .modal-header .modal-title { font-weight: 600; font-size: 1.1rem; }
  .modal-cadastro .modal-header .btn-close { filter: brightness(0) invert(1); opacity: 0.9; }
  .modal-cadastro .modal-footer { padding: 1rem 1.25rem; border-top: 1px solid rgba(0,0,0,0.06); background: #fafafa; }

  @media (max-width: 767.98px) {
    .admin-agendamentos__panel-head--table { flex-direction: column; align-items: stretch; }
    .admin-agendamentos__search, .admin-agendamentos__page-size { width: 100%; }
  }
</style>

<div class="modal fade modal-cadastro" id="modalService" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">Novo serviço</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div id="svcFormAlert" class="alert alert-danger py-2 px-3 small mb-3" role="alert" style="display:none;"></div>
        <input type="hidden" id="svc_id">
        <div class="mb-2">
          <label class="form-label field-required" for="svc_name">Nome</label>
          <input class="form-control" id="svc_name" maxlength="120" placeholder="Ex.: Vacina contra gripe">
          <div class="invalid-feedback" id="svc_name_error">Informe o nome do serviço.</div>
        </div>
        <div class="mb-2">
          <label class="form-label" for="svc_group">Grupo do serviço</label>
          <select class="form-select" id="svc_group">
            <option value="VACINACAO">Vacinação</option>
            <option value="PROCEDIMENTO">Procedimento</option>
            <option value="TESTE_RAPIDO">Teste rápido</option>
            <option value="ACOMPANHAMENTO">Acompanhamento</option>
            <option value="ORIENTACAO">Orientação</option>
            <option value="OUTRO" selected>Outro</option>
          </select>
        </div>
        <div class="row g-2">
          <div class="col">
            <label class="form-label field-required" for="svc_price">Preço (R$)</label>
            <input class="form-control" id="svc_price" type="number" step="0.01" min="0" placeholder="0,00">
            <div class="invalid-feedback" id="svc_price_error">Informe um preço válido.</div>
          </div>
          <div class="col">
            <label class="form-label field-required" for="svc_duration">Duração (min)</label>
            <input class="form-control" id="svc_duration" type="number" min="1" max="480" value="30">
            <div class="invalid-feedback" id="svc_duration_error">Informe a duração em minutos.</div>
          </div>
        </div>
        <div class="row g-2 mt-1">
          <div class="col">
            <label class="form-label" for="svc_min_age">Idade mínima</label>
            <input class="form-control" id="svc_min_age" type="number" min="0" max="120" placeholder="Opcional">
            <div class="invalid-feedback" id="svc_min_age_error">Idade mínima inválida.</div>
          </div>
          <div class="col">
            <label class="form-label" for="svc_max_age">Idade máxima</label>
            <input class="form-control" id="svc_max_age" type="number" min="0" max="120" placeholder="Opcional">
            <div class="invalid-feedback" id="svc_max_age_error">Idade máxima inválida.</div>
          </div>
          <div class="col">
            <label class="form-label" for="svc_obs_minutes">Observação pós-atendimento (min)</label>
            <input class="form-control" id="svc_obs_minutes" type="number" min="0" max="240" value="0">
            <div class="invalid-feedback" id="svc_obs_minutes_error">Tempo de observação inválido.</div>
          </div>
        </div>
        <div class="form-check mt-2"><input class="form-check-input" id="svc_store" type="checkbox" checked><label class="form-check-label" for="svc_store">Disponível na farmácia</label></div>
        <div class="form-check mt-2"><input class="form-check-input" id="svc_home" type="checkbox" checked><label class="form-check-label" for="svc_home">Disponível em domicílio</label></div>
        <div class="form-check"><input class="form-check-input" id="svc_rx" type="checkbox"><label class="form-check-label" for="svc_rx">Exige receita</label></div>
        <div class="mt-2"><label class="form-label">Instruções de preparo</label><textarea class="form-control" id="svc_prep" rows="2" placeholder="Orientações prévias ao cliente"></textarea></div>
        <div class="mt-2"><label class="form-label">Contraindicações</label><textarea class="form-control" id="svc_contra" rows="2" placeholder="Restrições importantes"></textarea></div>
        <div class="mt-2"><label class="form-label">Insumos necessários</label><textarea class="form-control" id="svc_supplies" rows="2" placeholder="Ex.: seringa, gaze, EPI"></textarea></div>
        <div class="mt-2"><label class="form-label">Observações internas</label><textarea class="form-control" id="svc_notes" rows="2"></textarea></div>
      </div>
      <div class="modal-footer"><button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><button type="button" class="btn btn-primary" id="btnSalvarServico" onclick="salvarServico()"><i class="bi bi-check-lg me-1"></i> Salvar</button></div>
    </div>
  </div>
</div>

<div class="modal fade modal-cadastro" id="modalProfessional" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">Novo profissional</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div id="proFormAlert" class="alert alert-danger py-2 px-3 small mb-3" role="alert" style="display:none;"></div>
        <input type="hidden" id="pro_id">
        <div class="mb-2">
          <label class="form-label field-required" for="pro_name">Nome</label>
          <input class="form-control" id="pro_name" maxlength="120" placeholder="Nome completo">
          <div class="invalid-feedback" id="pro_name_error">Informe o nome do profissional.</div>
        </div>
        <div class="mb-2">
          <label class="form-label field-required" for="pro_role">Cargo</label>
          <select class="form-select" id="pro_role">
            <option value="FARMACEUTICO">Farmacêutico</option>
            <option value="ENFERMEIRO">Enfermeiro</option>
          </select>
        </div>
        <div class="mb-2">
          <label class="form-label" for="pro_email">E-mail</label>
          <input class="form-control" id="pro_email" type="email" placeholder="contato@email.com">
          <div class="invalid-feedback" id="pro_email_error">Informe um e-mail válido.</div>
        </div>
        <div class="mb-2">
          <label class="form-label" for="pro_phone">Telefone</label>
          <input class="form-control" id="pro_phone" placeholder="(11) 99999-9999">
          <div class="invalid-feedback" id="pro_phone_error">Informe um telefone válido.</div>
        </div>
        <div class="row g-2">
          <div class="col-md-4">
            <label class="form-label" for="pro_council_type">Conselho</label>
            <input class="form-control" id="pro_council_type" readonly value="CRF">
          </div>
          <div class="col-md-3">
            <label class="form-label field-required" for="pro_council_uf">UF</label>
            <input class="form-control text-uppercase" id="pro_council_uf" maxlength="2" placeholder="SP">
            <div class="invalid-feedback" id="pro_council_uf_error">Informe a UF com 2 letras.</div>
          </div>
          <div class="col-md-5">
            <label class="form-label field-required" for="pro_council_number">Registro</label>
            <input class="form-control text-uppercase" id="pro_council_number" placeholder="Ex.: 12345 ou 12345-F">
            <div class="invalid-feedback" id="pro_council_number_error">Informe o número de registro.</div>
          </div>
        </div>
        <div class="small text-muted mt-1">Farmacêutico usa CRF e Enfermeiro usa COREN.</div>
        <label class="form-label mt-2 field-required">Disponibilidade semanal</label>
        <div class="small text-muted mb-2">Segunda a sábado (HH:MM). Informe ao menos um dia com horário de início e fim.</div>
        <div id="pro_availability_error" class="invalid-feedback d-block mb-2" style="display:none !important;">Cadastre ao menos um dia com horário válido.</div>
        <% const weekDays = [{ d: 1, l: 'Seg' }, { d: 2, l: 'Ter' }, { d: 3, l: 'Qua' }, { d: 4, l: 'Qui' }, { d: 5, l: 'Sex' }, { d: 6, l: 'Sáb' }]; %>
        <% weekDays.forEach(function(day) { %>
          <div class="row g-1 mb-1">
            <div class="col-3 small pt-1"><%= day.l %></div>
            <div class="col"><input class="form-control form-control-sm" id="pro_<%= day.d %>_start" placeholder="08:00"></div>
            <div class="col"><input class="form-control form-control-sm" id="pro_<%= day.d %>_end" placeholder="18:00"></div>
          </div>
        <% }) %>
      </div>
      <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><button type="button" class="btn btn-primary" id="btnSalvarProfissional" onclick="salvarProfissional()"><i class="bi bi-check-lg me-1"></i> Salvar</button></div>
    </div>
  </div>
</div>

<div class="modal fade modal-cadastro" id="modalReserve" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">Novo agendamento</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div id="reserveFormAlert" class="alert alert-danger py-2 px-3 small mb-3" role="alert" style="display:none;"></div>
        <input type="hidden" id="res_id">
        <div class="row g-2">
          <div class="col-md-6">
            <label class="form-label field-required" for="res_service_id">Serviço</label>
            <select class="form-select" id="res_service_id">
              <% (services || []).filter(function(s){ return s.is_active; }).forEach(function(s){ %>
                <option value="<%= s.id %>"><%= s.name %> - R$ <%= toMoney(s.price) %></option>
              <% }) %>
            </select>
            <div class="invalid-feedback" id="res_service_id_error">Selecione o serviço.</div>
          </div>
          <div class="col-md-6">
            <label class="form-label field-required" for="res_modality">Modalidade</label>
            <select class="form-select" id="res_modality">
              <option value="IN_STORE">Na farmácia</option>
              <option value="HOME">Em domicílio</option>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label field-required" for="res_payment_method">Forma de pagamento prevista</label>
            <select class="form-select" id="res_payment_method">
              <option value="CASH">Dinheiro — receber no atendimento</option>
              <option value="PIX">PIX — receber no caixa ou atendimento</option>
              <option value="CREDIT_CARD">Cartão de crédito — receber no caixa ou atendimento</option>
              <option value="DEBIT_CARD">Cartão de débito — receber no caixa ou atendimento</option>
            </select>
            <div id="res_payment_hint" class="form-text mt-1">O horário é confirmado na hora. Registre o recebimento depois, no menu de ações do agendamento.</div>
          </div>
          <div class="col-md-6">
            <label class="form-label field-required" for="res_professional_id">Profissional</label>
            <select class="form-select" id="res_professional_id">
              <% (professionals || []).filter(function(p){ return p.is_active; }).forEach(function(p){ %>
                <option value="<%= p.id %>"><%= p.full_name %> - <%= p.role_name %></option>
              <% }) %>
            </select>
            <div class="invalid-feedback" id="res_professional_id_error">Selecione o profissional.</div>
          </div>
          <div class="col-md-6">
            <label class="form-label field-required" for="res_customer_name">Cliente</label>
            <input class="form-control" id="res_customer_name" maxlength="120" placeholder="Nome completo">
            <div class="invalid-feedback" id="res_customer_name_error">Informe o nome do cliente.</div>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="res_customer_email">E-mail</label>
            <input class="form-control" id="res_customer_email" type="email" placeholder="cliente@email.com">
            <div class="invalid-feedback" id="res_customer_email_error">Informe um e-mail válido.</div>
          </div>
          <div class="col-md-6">
            <label class="form-label field-required" for="res_customer_phone">Telefone</label>
            <input class="form-control" id="res_customer_phone" placeholder="(11) 99999-9999">
            <div class="invalid-feedback" id="res_customer_phone_error">Informe um telefone com DDD.</div>
          </div>
          <div class="col-md-4">
            <label class="form-label field-required" for="res_scheduled_date">Data</label>
            <input class="form-control" id="res_scheduled_date" type="date" min="<%= minBookingDate %>" max="<%= maxBookingDate %>">
            <div class="invalid-feedback" id="res_scheduled_date_error">Selecione a data do agendamento.</div>
          </div>
          <div class="col-md-8">
            <label class="form-label field-required">Horário disponível</label>
            <div id="res_slot_buttons" class="d-flex flex-wrap gap-1"></div>
            <div id="res_slot_hint" class="small text-muted mt-1">Selecione serviço, profissional e data para ver os horários.</div>
            <div class="invalid-feedback d-block" id="res_scheduled_start_error" style="display:none;">Selecione um horário disponível.</div>
            <input type="hidden" id="res_scheduled_start">
          </div>
          <div class="col-md-3" id="home_zip_wrap" style="display:none;">
            <label class="form-label field-required" for="res_zip_code">CEP</label>
            <input class="form-control" id="res_zip_code" placeholder="00000-000">
            <div class="invalid-feedback" id="res_zip_code_error">Informe um CEP válido.</div>
          </div>
          <div class="col-md-6" id="home_street_wrap" style="display:none;">
            <label class="form-label field-required" for="res_street">Rua</label>
            <input class="form-control" id="res_street">
            <div class="invalid-feedback" id="res_street_error">Informe a rua.</div>
          </div>
          <div class="col-md-3" id="home_number_wrap" style="display:none;">
            <label class="form-label field-required" for="res_number">Número</label>
            <input class="form-control" id="res_number">
            <div class="invalid-feedback" id="res_number_error">Informe o número.</div>
          </div>
          <div class="col-md-4" id="home_complement_wrap" style="display:none;"><label class="form-label" for="res_complement">Complemento</label><input class="form-control" id="res_complement"></div>
          <div class="col-md-4" id="home_district_wrap" style="display:none;">
            <label class="form-label field-required" for="res_district">Bairro</label>
            <input class="form-control" id="res_district">
            <div class="invalid-feedback" id="res_district_error">Informe o bairro.</div>
          </div>
          <div class="col-md-3" id="home_city_wrap" style="display:none;">
            <label class="form-label field-required" for="res_city">Cidade</label>
            <input class="form-control" id="res_city">
            <div class="invalid-feedback" id="res_city_error">Informe a cidade.</div>
          </div>
          <div class="col-md-1" id="home_state_wrap" style="display:none;">
            <label class="form-label field-required" for="res_state">UF</label>
            <input class="form-control text-uppercase" id="res_state" maxlength="2">
            <div class="invalid-feedback" id="res_state_error">Informe a UF.</div>
          </div>
        </div>
      </div>
      <div class="modal-footer"><button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><button type="button" class="btn btn-primary" id="btnReservarAgendamento" onclick="salvarAgendamento()"><i class="bi bi-calendar-check me-1"></i> Reservar e gerar pagamento</button></div>
    </div>
  </div>
</div>

