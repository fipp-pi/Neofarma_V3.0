  a.admin-lotes__stat:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
    border-color: color-mix(in srgb, var(--accent-color), transparent 70%);
  }

  .admin-lotes__stat-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
