  .admin-lotes__panel {
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 14px;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
    overflow: hidden;
  }

  .admin-lotes__panel-head {
    padding: 0.95rem 1.15rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent-color), #fff 92%) 0%, #fff 100%);
  }

  .admin-lotes__panel-head--table {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .admin-lotes__panel-title {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--heading-color);
  }

  .admin-lotes__panel-meta {
    font-size: 0.8rem;
    color: #6c757d;
  }

  .admin-lotes__panel-body {
    padding: 1.15rem 1.15rem 1.25rem;
  }

  .admin-lotes__panel-body .form-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: #495057;
    margin-bottom: 0.3rem;
  }

  .admin-lotes__panel-body .form-control,
  .admin-lotes__panel-body .form-select {
    border-radius: 8px;
    border-color: #dee2e6;
    font-size: 0.9rem;
  }

  .admin-lotes__panel-body .form-control:focus,
  .admin-lotes__panel-body .form-select:focus {
    border-color: var(--accent-color);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-color), transparent 88%);
  }

  .admin-lotes__panel-body .search-box .form-control {
    padding-left: 2rem;
  }

  .btn-save {
    background: var(--accent-color);
    border-color: var(--accent-color);
    color: var(--contrast-color);
    font-weight: 600;
    border-radius: 8px;
  }

  .btn-save:hover {
    background: color-mix(in srgb, var(--accent-color), black 12%);
    border-color: color-mix(in srgb, var(--accent-color), black 12%);
    color: var(--contrast-color);
  }

  .admin-lotes__panel--table .table-custom th {
    font-size: 0.72rem;
    padding: 0.85rem 1rem;
    white-space: nowrap;
  }

  .admin-lotes__panel--table .table-custom td {
    padding: 0.85rem 1rem;
    font-size: 0.88rem;
  }

  .admin-lotes__panel--table .col-check {
    width: 42px;
  }

  .admin-lotes__sort-link {
    color: inherit;
    text-decoration: none;
    font-weight: inherit;
  }

  .admin-lotes__sort-link:hover {
    color: var(--accent-color);
  }

  .admin-lotes__batch-code {
    font-size: 0.78rem;
    color: var(--accent-color);
    background: color-mix(in srgb, var(--accent-color), transparent 92%);
    padding: 0.15rem 0.4rem;
    border-radius: 6px;
  }

  .admin-lotes__badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    border-radius: 999px;
    padding: 0.22rem 0.55rem;
    white-space: nowrap;
  }

  .admin-lotes__badge--success { background: #d1e7dd; color: #0f5132; }
  .admin-lotes__badge--warning { background: #fff3cd; color: #664d03; }
  .admin-lotes__badge--danger { background: #f8d7da; color: #842029; }
  .admin-lotes__badge--info { background: #dbeafe; color: #0a58ca; }
  .admin-lotes__badge--muted { background: #e9ecef; color: #495057; }

  .admin-lotes__qty-badge {
    display: inline-block;
    min-width: 2rem;
    font-weight: 700;
    font-size: 0.82rem;
    color: var(--accent-color);
    background: color-mix(in srgb, var(--accent-color), transparent 86%);
    border-radius: 999px;
    padding: 0.2rem 0.5rem;
  }

  .admin-lotes__days {
    font-weight: 600;
    font-size: 0.88rem;
    color: #495057;
  }

  .admin-lotes__days--warning { color: #997404; }
  .admin-lotes__days--danger { color: #b02a37; }

  .admin-lotes__row--expired { background: color-mix(in srgb, #dc3545, transparent 94%); }
  .admin-lotes__row--disposed { background: #f8f9fa; }

  .admin-lotes__empty {
    padding: 3rem 1.5rem;
    text-align: center;
    color: #868e96;
    font-size: 0.92rem;
  }

  .admin-lotes__empty i {
    font-size: 2.2rem;
    opacity: 0.65;
  }

  .admin-lotes__pagination {
    display: flex;
    justify-content: center;
    padding: 1rem 1.15rem 1.15rem;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    background: #fafbfc;
  }

  .admin-lotes__pagination .page-item.active .page-link {
    background: var(--accent-color);
    border-color: var(--accent-color);
  }

  .admin-lotes__pagination .page-link {
    color: var(--accent-color);
  }

  @media (max-width: 767.98px) {
    .admin-lotes__panel-head--table {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>

<%- include('partials/footer') %>

<script>
(function () {
  function lotesToast(msg, type) {
    if (typeof window.neofarmaToast === 'function') return window.neofarmaToast(msg, type);
    alert(msg);
  }

  function parseRowData(tr) {
    try {
      var raw = tr.getAttribute('data-batch');
      if (!raw) return null;
      return JSON.parse(raw.replace(/&quot;/g, '"'));
    } catch (_) { return null; }
  }

  function escapeHtml(v) {
    return String(v == null ? '' : v)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function fmtDate(v) {
    if (!v) return '—';
    return window.NeoDates ? NeoDates.formatDate(v) : String(v).slice(0, 10);
  }

  function fmtDateTime(v) {
    if (!v) return '—';
    return window.NeoDates ? NeoDates.formatDateTime(v) : String(v);
  }

  function validityLabel(v) {
    if (v === 'EXPIRED') return 'Vencido';
    if (v === 'EXPIRING') return 'A vencer';
    return 'Válido';
  }

  async function openDetail(batchId) {
    var modalEl = document.getElementById('modalLoteDetail');
    var bodyEl = document.getElementById('loteDetailBody');
    var titleEl = document.getElementById('loteDetailTitle');
    var footerEl = document.getElementById('loteDetailFooter');
    if (!modalEl || !bodyEl) return;
    titleEl.innerHTML = '<i class="bi bi-info-circle me-2"></i>Lote #' + escapeHtml(batchId);
    bodyEl.innerHTML = '<div class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm me-2"></span> Carregando...</div>';
    footerEl.innerHTML = '<button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>';
    bootstrap.Modal.getOrCreateInstance(modalEl).show();

    try {
      var res = await fetch('/admin/lotes/' + encodeURIComponent(batchId));
      var data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.message || 'Erro ao carregar lote.');
      var b = data.batch || {};
      var p = data.product || {};
      var usage = data.order_usage || {};
      var html = '<div class="admin-lotes-detail-grid">';
      html += '<div class="admin-lotes-detail-card"><div class="admin-lotes-detail-card-title">Produto</div>';
      html += '<p class="mb-1 fw-semibold">' + escapeHtml(p.name) + '</p>';
      html += '<p class="mb-1 small text-muted">SKU: ' + escapeHtml(p.sku || '—') + '</p>';
      html += '<p class="mb-0 small">Estoque vendável: <strong>' + Number(p.valid_stock || 0) + ' un.</strong></p></div>';
      html += '<div class="admin-lotes-detail-card"><div class="admin-lotes-detail-card-title">Lote</div>';
      html += '<p class="mb-1"><code>' + escapeHtml(b.batch_code) + '</code></p>';
      html += '<p class="mb-1 small">Validade: ' + escapeHtml(fmtDate(b.expiry_date)) + ' · ' + escapeHtml(validityLabel(b.validity_status)) + '</p>';
      html += '<p class="mb-0 small">Saldo atual: <strong>' + Number(b.quantity || 0) + ' un.</strong></p></div>';
      html += '<div class="admin-lotes-detail-card"><div class="admin-lotes-detail-card-title">Movimentação</div>';
      html += '<p class="mb-1 small">Pedidos efetivados: <strong>' + Number(usage.orders_count || 0) + '</strong></p>';
      html += '<p class="mb-1 small">Unidades vendidas: <strong>' + Number(usage.units_sold || 0) + '</strong></p>';
      if (Number(usage.units_cancelled || 0) > 0) {
        html += '<p class="mb-1 small text-muted">Cancelados (não contabilizados): <strong>' + Number(usage.units_cancelled || 0) + ' un.</strong> em ' + Number(usage.orders_cancelled_count || 0) + ' pedido(s)</p>';
      }
      html += '<p class="mb-0 small">Descartado: <strong>' + Number(b.disposed_qty || 0) + ' un.</strong></p></div></div>';

      html += '<div class="cadastro-edit-section-title">Fila FEFO do produto</div>';
      if ((data.fefo_queue || []).length) {
        html += '<div class="table-responsive mb-3"><table class="table table-sm table-custom mb-0"><thead><tr><th>Pos.</th><th>Lote</th><th>Validade</th><th class="text-center">Qtd</th></tr></thead><tbody>';
        data.fefo_queue.forEach(function (item) {
          var cls = Number(item.id) === Number(b.id) ? 'admin-lotes-fefo-current' : '';
          html += '<tr class="' + cls + '"><td>' + (item.fefo_rank || '—') + 'º</td><td><code>' + escapeHtml(item.batch_code) + '</code></td><td>' + escapeHtml(fmtDate(item.expiry_date)) + '</td><td class="text-center">' + Number(item.quantity || 0) + '</td></tr>';
        });
        html += '</tbody></table></div>';
      } else {
        html += '<p class="text-muted small mb-3">Nenhum lote vendável na fila FEFO.</p>';
      }

      html += '<div class="cadastro-edit-section-title">Histórico de descartes</div>';
      if ((data.disposals || []).length) {
        html += '<div class="table-responsive mb-3"><table class="table table-sm table-custom mb-0"><thead><tr><th>Data</th><th>Qtd</th><th>Motivo</th><th>Responsável</th></tr></thead><tbody>';
        data.disposals.forEach(function (d) {
          html += '<tr><td class="small">' + escapeHtml(fmtDateTime(d.created_at)) + '</td><td>' + Number(d.quantity || 0) + '</td><td>' + escapeHtml(d.reason || '—') + '</td><td class="small">' + escapeHtml(d.disposed_by_name || '—') + '</td></tr>';
        });
        html += '</tbody></table></div>';
      } else {
        html += '<p class="text-muted small mb-3">Nenhum descarte registrado para este lote.</p>';
      }

      if ((usage.recent || []).length) {
        html += '<div class="cadastro-edit-section-title">Histórico de saídas em pedidos</div>';
        html += '<div class="table-responsive"><table class="table table-sm table-custom mb-0"><thead><tr><th>Pedido</th><th>Data</th><th class="text-center">Qtd</th><th>Status</th><th>Contabiliza</th></tr></thead><tbody>';
        usage.recent.forEach(function (o) {
          var isSale = Number(o.counts_as_sale) === 1;
          var statusClass = String(o.order_status || '').toUpperCase() === 'CANCELLED' ? 'text-danger' : '';
          html += '<tr class="' + (isSale ? '' : 'text-muted') + '">';
          html += '<td>#' + Number(o.order_id) + '</td>';
          html += '<td class="small">' + escapeHtml(fmtDateTime(o.created_at)) + '</td>';
          html += '<td class="text-center">' + Number(o.quantity || 0) + '</td>';
          html += '<td class="small ' + statusClass + '">' + escapeHtml(o.order_status || '—') + '</td>';
          html += '<td class="small">' + (isSale ? '<span class="text-success">Sim</span>' : '<span class="text-muted">Não</span>') + '</td>';
          html += '</tr>';
        });
        html += '</tbody></table></div>';
      }

      bodyEl.innerHTML = html;
      footerEl.innerHTML = '<button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>'
        + '<a class="btn btn-outline-primary" href="/admin/produtos?search=' + encodeURIComponent(p.sku || p.name || '') + '">Ver produto</a>';
    } catch (err) {
      bodyEl.innerHTML = '<div class="alert alert-danger mb-0">' + escapeHtml(err.message || 'Erro.') + '</div>';
    }
  }

  function openEdit(row) {
    var data = parseRowData(row);
    if (!data) return;
    document.getElementById('loteEditId').value = data.id;
    document.getElementById('loteEditProductLabel').textContent = data.product_name + (data.sku ? ' · SKU ' + data.sku : '');
    document.getElementById('loteEditCode').value = data.batch_code || '';
    document.getElementById('loteEditMfg').value = data.mfg_date || '';
    document.getElementById('loteEditExpiry').value = data.expiry_date || '';
    document.getElementById('loteEditQty').value = data.quantity != null ? data.quantity : '';
    document.getElementById('loteEditError').textContent = '';
    bootstrap.Modal.getOrCreateInstance(document.getElementById('modalLoteEdit')).show();
  }

  function openDispose(row) {
    var data = parseRowData(row);
    if (!data) return;
    document.getElementById('loteDisposeBatchId').value = data.id;
    document.getElementById('loteDisposeProductId').value = data.product_id;
    document.getElementById('loteDisposeMaxQty').value = data.quantity;
    document.getElementById('loteDisposeLabel').textContent = data.product_name + ' · lote ' + data.batch_code + ' · saldo ' + data.quantity + ' un.';
    document.getElementById('loteDisposeQty').value = data.validity_status === 'EXPIRED' ? data.quantity : '';
    document.getElementById('loteDisposeQty').max = data.quantity;
    document.getElementById('loteDisposeReason').value = data.validity_status === 'EXPIRED' ? 'Produto vencido identificado em conferência de estoque' : '';
    document.getElementById('loteDisposeError').textContent = '';
    bootstrap.Modal.getOrCreateInstance(document.getElementById('modalLoteDispose')).show();
  }

  document.addEventListener('click', function (ev) {
    var row = ev.target.closest('tr[data-batch]');
    if (!row) return;
    if (ev.target.closest('.lotes-btn-detail')) { ev.preventDefault(); openDetail(parseRowData(row).id); return; }
    if (ev.target.closest('.lotes-btn-edit')) { ev.preventDefault(); openEdit(row); return; }
    if (ev.target.closest('.lotes-btn-dispose')) { ev.preventDefault(); openDispose(row); }
  });

  document.getElementById('loteEditSaveBtn')?.addEventListener('click', async function () {
    var id = document.getElementById('loteEditId').value;
    var errEl = document.getElementById('loteEditError');
    errEl.textContent = '';
    var body = {
      batch_code: document.getElementById('loteEditCode').value.trim(),
      mfg_date: document.getElementById('loteEditMfg').value || null,
      expiry_date: document.getElementById('loteEditExpiry').value,
      quantity: document.getElementById('loteEditQty').value,
    };
    if (!body.batch_code || !body.expiry_date) {
      errEl.textContent = 'Informe código e validade.';
      return;
    }
    this.disabled = true;
    try {
      var res = await fetch('/admin/produtos/lotes/' + encodeURIComponent(id), {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(body),
      });
      var data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.message || 'Falha ao salvar.');
      lotesToast('Lote atualizado com sucesso.', 'success');
      bootstrap.Modal.getInstance(document.getElementById('modalLoteEdit')).hide();
      window.location.reload();
    } catch (err) {
      errEl.textContent = err.message || 'Erro ao salvar.';
    } finally {
      this.disabled = false;
    }
  });

  document.getElementById('loteDisposeSaveBtn')?.addEventListener('click', async function () {
    var errEl = document.getElementById('loteDisposeError');
    errEl.textContent = '';
    var maxQty = Number(document.getElementById('loteDisposeMaxQty').value || 0);
    var body = {
      product_id: Number(document.getElementById('loteDisposeProductId').value),
      batch_id: Number(document.getElementById('loteDisposeBatchId').value),
      quantity: document.getElementById('loteDisposeQty').value,
      reason: document.getElementById('loteDisposeReason').value.trim(),
    };
    if (!body.quantity || !body.reason) {
      errEl.textContent = 'Informe quantidade e motivo.';
      return;
    }
    if (Number(body.quantity) > maxQty) {
      errEl.textContent = 'Quantidade maior que o saldo do lote.';
      return;
    }
    this.disabled = true;
    try {
      var res = await fetch('/admin/descartes', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(body),
      });
      var data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.message || 'Falha ao descartar.');
      lotesToast(data.message || 'Descarte registrado.', 'success');
      bootstrap.Modal.getInstance(document.getElementById('modalLoteDispose')).hide();
      window.location.href = '/admin/lotes?disposed=1';
    } catch (err) {
      errEl.textContent = err.message || 'Erro ao descartar.';
    } finally {
      this.disabled = false;
    }
  });

  document.getElementById('checkAll')?.addEventListener('change', function () {
    document.querySelectorAll('.row-check').forEach(function (c) { c.checked = this.checked; }.bind(this));
  });

  document.getElementById('btnDeleteMany')?.addEventListener('click', async function () {
    var ids = Array.from(document.querySelectorAll('.row-check:checked')).map(function (c) { return Number(c.value); });
    if (!ids.length) return lotesToast('Selecione ao menos um lote.', 'warning');
    var ok = typeof window.neofarmaConfirm === 'function'
      ? await window.neofarmaConfirm({ title: 'Excluir lotes', message: 'Excluir os lotes selecionados? Esta ação não pode ser desfeita.' })
      : window.confirm('Excluir os lotes selecionados?');
    if (!ok) return;
    var btn = this;
    btn.disabled = true;
    try {
      var resp = await fetch('/admin/lotes/delete-many', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ids: ids })
      });
      var data = await resp.json();
      if (!data.ok) {
        lotesToast(data.message || 'Falha na exclusão em massa.', 'danger');
        return;
      }
      lotesToast('Lotes excluídos com sucesso.', 'success');
      window.location.reload();
    } catch (e) {
      lotesToast('Erro de conexão. Tente novamente.', 'danger');
    } finally {
      btn.disabled = false;
    }
  });
})();
</script>
