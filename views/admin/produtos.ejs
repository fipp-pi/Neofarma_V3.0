<%- include('partials/header') %>
<%
  const prodList = typeof list !== 'undefined' ? list : [];
  const prodStats = typeof stats !== 'undefined' ? stats : { total: prodList.length, active: 0, inactive: 0, expired: 0, expiring: 0, filtered: prodList.length };
  const riskFilterVal = typeof riskFilter !== 'undefined' ? riskFilter : 'ALL';
  const labsList = typeof labs !== 'undefined' ? labs : [];
  const categoriesList = typeof categories !== 'undefined' ? categories : [];
  const typesList = typeof productTypes !== 'undefined' ? productTypes : [];
  const catNameMap = categoriesList.reduce(function(acc, c){ acc[c.id] = c.name; return acc; }, {});
  const typeNameMap = typesList.reduce(function(acc, t){ acc[t.id] = t.name; return acc; }, {});
  function prodUrl(extra) {
    var risk = extra && extra.batchRisk ? extra.batchRisk : 'ALL';
    if (risk === 'ALL') return '/admin/produtos';
    return '/admin/produtos?batchRisk=' + encodeURIComponent(risk);
  }
%>
<script src="/assets/js/admin-catalog-filters.js"></script>
<div class="container admin-catalog">
  <div id="pageFlash" class="mb-3" style="display:none;">
    <div class="alert alert-dismissible fade show mb-0" id="pageFlashAlert" role="alert">
      <span id="pageFlashText"></span>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
  </div>

  <div class="list-header mb-4">
    <div>
      <h2 class="neo-heading">Produtos</h2>
      <p class="text-muted mb-0">Cadastre e mantenha os produtos da loja, com preços, imagens, estoque e vínculos com laboratório, categoria e tipo.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <a href="/admin/categorias" class="btn btn-outline-primary btn-sm"><i class="bi bi-tags me-1"></i> Categorias</a>
      <a href="/admin/lotes" class="btn btn-outline-primary btn-sm"><i class="bi bi-archive me-1"></i> Lotes</a>
    </div>
  </div>

  <div class="admin-catalog__stats row g-3 mb-4">
    <div class="col-6 col-lg-3">
      <div class="admin-catalog__stat admin-catalog__stat--primary">
        <span class="admin-catalog__stat-icon"><i class="bi bi-box-seam"></i></span>
        <div><div class="admin-catalog__stat-value"><%= prodStats.total %></div><div class="admin-catalog__stat-label">Total no catálogo</div></div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="admin-catalog__stat admin-catalog__stat--success">
        <span class="admin-catalog__stat-icon"><i class="bi bi-check-circle"></i></span>
        <div><div class="admin-catalog__stat-value"><%= prodStats.active %></div><div class="admin-catalog__stat-label">Ativos</div></div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <a href="<%= prodUrl({ batchRisk: 'EXPIRING' }) %>" class="admin-catalog__stat admin-catalog__stat--warning text-decoration-none">
        <span class="admin-catalog__stat-icon"><i class="bi bi-hourglass-split"></i></span>
        <div><div class="admin-catalog__stat-value"><%= prodStats.expiring %></div><div class="admin-catalog__stat-label">Próx. vencimento</div></div>
      </a>
    </div>
    <div class="col-6 col-lg-3">
      <a href="<%= prodUrl({ batchRisk: 'EXPIRED' }) %>" class="admin-catalog__stat admin-catalog__stat--danger text-decoration-none">
        <span class="admin-catalog__stat-icon"><i class="bi bi-exclamation-octagon"></i></span>
        <div><div class="admin-catalog__stat-value"><%= prodStats.expired %></div><div class="admin-catalog__stat-label">Lotes vencidos</div></div>
      </a>
    </div>
  </div>

  <% if ((prodStats.expired || 0) > 0 || (prodStats.expiring || 0) > 0) { %>
  <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div><strong><i class="bi bi-exclamation-triangle me-1"></i> Atenção ao estoque:</strong> há produtos com lotes vencidos ou a vencer nos próximos 30 dias.</div>
    <div class="d-flex gap-2">
      <% if (prodStats.expiring > 0) { %><a class="btn btn-sm btn-warning" href="<%= prodUrl({ batchRisk: 'EXPIRING' }) %>">Ver a vencer</a><% } %>
      <% if (prodStats.expired > 0) { %><a class="btn btn-sm btn-danger" href="<%= prodUrl({ batchRisk: 'EXPIRED' }) %>">Ver vencidos</a><% } %>
    </div>
  </div>
  <% } %>

  <div class="admin-catalog__tabs mb-3">
    <a href="<%= prodUrl({ batchRisk: 'ALL' }) %>" class="admin-catalog__tab <%= riskFilterVal === 'ALL' ? 'is-active' : '' %>"><i class="bi bi-grid me-1"></i> Todos</a>
    <a href="<%= prodUrl({ batchRisk: 'EXPIRING' }) %>" class="admin-catalog__tab <%= riskFilterVal === 'EXPIRING' ? 'is-active' : '' %>"><i class="bi bi-hourglass me-1"></i> Próx. vencimento</a>
    <a href="<%= prodUrl({ batchRisk: 'EXPIRED' }) %>" class="admin-catalog__tab <%= riskFilterVal === 'EXPIRED' ? 'is-active' : '' %>"><i class="bi bi-exclamation-octagon me-1"></i> Vencidos</a>
  </div>

  <section class="admin-catalog__panel mb-3">
    <div class="admin-catalog__panel-head d-flex flex-wrap justify-content-between align-items-center gap-2">
      <h3 class="admin-catalog__panel-title mb-0"><i class="bi bi-funnel me-2"></i>Filtros avançados</h3>
      <button type="button" class="admin-catalog__filters-toggle" id="prodFiltersToggle" aria-expanded="true"><i class="bi bi-sliders"></i> Recolher filtros</button>
    </div>
    <div class="admin-catalog__panel-body" id="prodFiltersPanel">
      <div class="row g-3">
        <div class="col-lg-3">
          <label class="form-label" for="filtro_q">Busca geral</label>
          <div class="admin-catalog__search">
            <i class="bi bi-search"></i>
            <input type="text" class="form-control form-control-sm" id="filtro_q" placeholder="Nome, SKU, EAN, laboratório...">
          </div>
        </div>
        <div class="col-md-2">
          <label class="form-label" for="filtro_lab">Laboratório</label>
          <select class="form-select form-select-sm" id="filtro_lab">
            <option value="ALL">Todos</option>
            <% labsList.forEach(function(l){ %><option value="<%= l.id %>"><%= l.name %></option><% }) %>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label" for="filtro_cat">Categoria</label>
          <select class="form-select form-select-sm" id="filtro_cat">
            <option value="ALL">Todas</option>
            <% categoriesList.forEach(function(c){ %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label" for="filtro_type">Tipo</label>
          <select class="form-select form-select-sm" id="filtro_type">
            <option value="ALL">Todos</option>
            <% typesList.forEach(function(t){ %><option value="<%= t.id %>"><%= t.name %></option><% }) %>
          </select>
        </div>
        <div class="col-md-1">
          <label class="form-label" for="filtro_status">Status</label>
          <select class="form-select form-select-sm" id="filtro_status">
            <option value="ALL">Todos</option>
            <option value="ACTIVE">Ativo</option>
            <option value="INACTIVE">Inativo</option>
            <option value="DISCONTINUED">Descontinuado</option>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label" for="filtro_rx">Receita</label>
          <select class="form-select form-select-sm" id="filtro_rx">
            <option value="ALL">Qualquer</option>
            <option value="1">Exige receita</option>
            <option value="0">Livre</option>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label" for="filtro_risk">Risco lote</label>
          <select class="form-select form-select-sm" id="filtro_risk">
            <option value="ALL">Qualquer</option>
            <option value="none">Sem risco</option>
            <option value="expiring">A vencer</option>
            <option value="expired">Vencido</option>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label" for="filtro_price_min">Preço mín. (R$)</label>
          <input type="number" step="0.01" min="0" class="form-control form-control-sm" id="filtro_price_min" placeholder="0,00">
        </div>
        <div class="col-md-2">
          <label class="form-label" for="filtro_price_max">Preço máx. (R$)</label>
          <input type="number" step="0.01" min="0" class="form-control form-control-sm" id="filtro_price_max" placeholder="999,99">
        </div>
        <div class="col-md-2 d-flex align-items-end">
          <button type="button" class="btn btn-outline-secondary btn-sm w-100" id="prodClearFilters"><i class="bi bi-x-lg me-1"></i> Limpar</button>
        </div>
      </div>
    </div>
  </section>

  <section class="admin-catalog__panel admin-catalog__panel--table">
    <div class="admin-catalog__panel-head admin-catalog__panel-head--table">
      <h3 class="admin-catalog__panel-title"><i class="bi bi-list-ul me-2"></i>Produtos cadastrados</h3>
      <div class="admin-catalog__panel-actions">
        <span class="admin-catalog__panel-meta" id="prodResultsCount"><%= prodList.length %> registro(s)</span>
        <button type="button" class="btn btn-save btn-sm" onclick="abrirModalProd()" data-bs-toggle="modal" data-bs-target="#modalEditar">
          <i class="bi bi-plus-lg me-1"></i> Novo produto
        </button>
      </div>
    </div>
    <div class="admin-catalog__results-bar">
      <span>Exibindo <strong id="prodResultsVisible"><%= prodList.length %></strong> produto(s) · filtro servidor: <strong><%= riskFilterVal === 'ALL' ? 'todos' : (riskFilterVal === 'EXPIRED' ? 'vencidos' : 'a vencer') %></strong></span>
    </div>
    <div id="catalogTableWrap">
      <div class="table-responsive">
        <table class="table table-hover table-custom align-middle mb-0" id="tabelaProd">
          <thead>
            <tr>
              <th class="col-id">#</th>
              <th>Produto</th>
              <th>SKU</th>
              <th>Laboratório</th>
              <th>Categoria / Tipo</th>
              <th>Preço</th>
              <th class="col-status">Status</th>
              <th>Lotes</th>
              <th class="col-actions text-end">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% if (prodList.length) { prodList.forEach(function(item) {
              var catName = catNameMap[item.category_id] || '';
              var typeName = typeNameMap[item.product_type_id] || '';
              var riskKey = (item.expired_batches > 0 && item.expiring_batches > 0) ? 'both' : (item.expired_batches > 0 ? 'expired' : (item.expiring_batches > 0 ? 'expiring' : 'none'));
              var stBadge = item.status === 'ACTIVE' ? 'success' : (item.status === 'INACTIVE' ? 'muted' : 'danger');
              var searchBlob = [item.id, item.name, item.sku, item.ean13, item.lab_name, catName, typeName, item.status].filter(Boolean).join(' ');
            %>
              <tr
                data-filter-search="<%= searchBlob.toLowerCase() %>"
                data-filter-lab="<%= item.lab_id || '' %>"
                data-filter-cat="<%= item.category_id || '' %>"
                data-filter-type="<%= item.product_type_id || '' %>"
                data-filter-status="<%= item.status || '' %>"
                data-filter-rx="<%= item.prescription_required ? '1' : '0' %>"
                data-filter-risk="<%= riskKey %>"
                data-filter-price="<%= Number(item.unit_price || 0) %>"
              >
                <td class="col-id"><%= item.id %></td>
                <td class="fw-bold"><span class="cell-truncate-wide" title="<%= item.name %>"><%= item.name %></span></td>
                <td><code class="small"><%= item.sku || '—' %></code></td>
                <td><span class="cell-truncate" title="<%= item.lab_name || '' %>"><%= item.lab_name || '—' %></span></td>
                <td>
                  <div class="small"><%= catName || '—' %></div>
                  <% if (typeName) { %><span class="admin-catalog__badge admin-catalog__badge--info mt-1"><%= typeName %></span><% } %>
                </td>
                <td class="fw-semibold">R$ <%= Number(item.unit_price).toFixed(2).replace('.', ',') %></td>
                <td class="col-status"><span class="admin-catalog__badge admin-catalog__badge--<%= stBadge %>"><%= t('productStatus', item.status) %></span></td>
                <td>
                  <% if ((item.expired_batches || 0) > 0) { %><span class="admin-catalog__badge admin-catalog__badge--danger me-1">Venc.: <%= item.expired_batches %></span><% } %>
                  <% if ((item.expiring_batches || 0) > 0) { %><span class="admin-catalog__badge admin-catalog__badge--warning">30d: <%= item.expiring_batches %></span><% } %>
                  <% if ((item.expired_batches || 0) === 0 && (item.expiring_batches || 0) === 0) { %><span class="admin-catalog__badge admin-catalog__badge--success">OK</span><% } %>
                </td>
                <td class="col-actions text-end">
                  <div class="table-actions table-actions--4">
                  <button type="button" class="btn-action btn-stock" data-item="<%= encodeURIComponent(JSON.stringify(item)) %>" onclick="abrirModalLotes(this)" title="Lotes"><i class="bi bi-archive"></i></button>
                  <button type="button" class="btn-action btn-view" onclick="verProd(<%= item.id %>)" title="Ver informações" aria-label="Ver informações"><i class="bi bi-info-circle"></i></button>
                  <button type="button" class="btn-action btn-edit" data-item="<%= encodeURIComponent(JSON.stringify(item)) %>" onclick="editarProd(this)" title="Editar"><i class="bi bi-pencil"></i></button>
                  <button type="button" class="btn-action btn-delete" onclick="abrirModalExclusao(<%= item.id %>, '<%= (item.name || "").replace(/'/g, "\\'").replace(/"/g, '&quot;') %>')" title="Excluir"><i class="bi bi-trash"></i></button>
                  </div>
                </td>
              </tr>
            <% }); } %>
          </tbody>
        </table>
      </div>
    </div>
    <div id="mensagemVazia" class="admin-catalog__empty" style="display: <%= prodList.length ? 'none' : 'block' %>;">
      <i class="bi bi-box-seam main-icon"></i>
      <p class="fw-semibold mb-1">Nenhum produto cadastrado</p>
      <button type="button" class="btn btn-save btn-sm mt-2" onclick="abrirModalProd()" data-bs-toggle="modal" data-bs-target="#modalEditar">Cadastrar primeiro produto</button>
    </div>
    <div id="mensagemVaziaFilter" class="admin-catalog__empty" style="display:none;">
      <i class="bi bi-search main-icon"></i>
      <p class="fw-semibold mb-1">Nenhum resultado para os filtros</p>
      <p class="text-muted small mb-0">Ajuste os critérios ou limpe os filtros locais.</p>
    </div>
  </section>
</div>

<style>
  .modal-cadastro .modal-content { border: none; border-radius: 12px; box-shadow: 0 12px 40px rgba(0,0,0,0.15); overflow: hidden; }
  .modal-cadastro .modal-header { background: var(--accent-color); color: var(--contrast-color); padding: 1rem 1.25rem; border-bottom: none; }
  .modal-cadastro .modal-header .modal-title { font-weight: 600; font-size: 1.1rem; }
  .modal-cadastro .modal-header .btn-close { filter: brightness(0) invert(1); opacity: 0.9; }
  .modal-cadastro .modal-body { padding: 0; }
  .modal-cadastro .modal-footer { padding: 1rem 1.25rem; border-top: 1px solid rgba(0,0,0,0.06); background: #fafafa; }
  .cadastro-view { padding: 1.5rem 1.5rem 1.25rem; }
  .cadastro-view-avatar { width: 56px; height: 56px; border-radius: 50%; background: color-mix(in srgb, var(--accent-color), transparent 88%); color: var(--accent-color); font-size: 1.4rem; font-weight: 700; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem; }
  .cadastro-view-nome { font-size: 1.25rem; font-weight: 600; color: var(--heading-color); margin-bottom: 1.25rem; }
  .cadastro-view-section { margin-bottom: 1.25rem; }
  .cadastro-view-section:last-child { margin-bottom: 0; }
  .cadastro-view-section-title { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--accent-color); margin-bottom: 0.6rem; }
  .cadastro-view-row { display: flex; padding: 0.5rem 0; border-bottom: 1px solid rgba(0,0,0,0.06); align-items: baseline; gap: 0.75rem; }
  .cadastro-view-row:last-child { border-bottom: none; }
  .cadastro-view-label { font-size: 0.85rem; color: #6c757d; min-width: 130px; flex-shrink: 0; }
  .cadastro-view-value { font-size: 0.95rem; color: #212529; font-weight: 500; }
  .cadastro-edit { padding: 1.5rem 1.5rem 1.25rem; }
  .cadastro-edit-section { margin-bottom: 1.5rem; }
  .cadastro-edit-section:last-of-type { margin-bottom: 0; }
  .cadastro-edit-section-title { font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.03em; color: var(--accent-color); margin-bottom: 0.75rem; padding-bottom: 0.4rem; border-bottom: 2px solid color-mix(in srgb, var(--accent-color), transparent 85%); }
  .cadastro-edit .form-label { font-size: 0.875rem; font-weight: 500; color: #495057; margin-bottom: 0.25rem; }
  .cadastro-edit .form-control, .cadastro-edit .form-select, .cadastro-edit textarea { border-radius: 8px; border-color: #dee2e6; font-size: 0.9rem; }
  .cadastro-edit .form-control:focus, .cadastro-edit .form-select:focus, .cadastro-edit textarea:focus { border-color: var(--accent-color); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-color), transparent 88%); }
  .modal-cadastro .btn-save { background: var(--accent-color); border-color: var(--accent-color); color: var(--contrast-color); font-weight: 500; padding: 0.5rem 1.25rem; border-radius: 8px; }
  .modal-cadastro .btn-save:hover { background: color-mix(in srgb, var(--accent-color), black 12%); border-color: color-mix(in srgb, var(--accent-color), black 12%); color: var(--contrast-color); }
  .modal-header-danger { background: #dc3545; color: #fff; }
  .modal-header-danger .btn-close { filter: brightness(0) invert(1); }
  .field-required::after { content: ' *'; color: #dc3545; font-weight: 600; }
  .form-control.is-invalid, .form-select.is-invalid { border-color: #dc3545; box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.12); }
  .invalid-feedback { display: none; font-size: 0.8rem; color: #dc3545; margin-top: 0.2rem; }
  .form-control.is-invalid ~ .invalid-feedback,
  .form-select.is-invalid ~ .invalid-feedback,
  .was-validated .form-control:invalid ~ .invalid-feedback { display: block; }
  #prodFormAlert:empty { display: none !important; }
</style>

<!-- Modal Ver -->
<div class="modal fade modal-cadastro" id="modalVisualizar" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-box-seam me-2"></i>Dados do produto</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="conteudoVisualizacao"></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal Novo/Editar -->
<div class="modal fade modal-cadastro" id="modalEditar" tabindex="-1" data-bs-backdrop="static">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modalEditarTitle"><i class="bi bi-pencil-square me-2"></i>Novo produto</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="prod_id">
        <div id="prodFormAlert" class="alert alert-danger py-2 px-3 small mb-0 mx-3 mt-3" role="alert" style="display:none;"></div>
        <div class="cadastro-edit">
          <div class="cadastro-edit-section">
            <div class="cadastro-edit-section-title">Dados do produto</div>
            <div class="row g-3">
              <div class="col-md-8">
                <label for="prod_name" class="form-label field-required">Nome</label>
                <input type="text" class="form-control" id="prod_name" placeholder="Nome do produto" autocomplete="off">
                <div class="invalid-feedback" id="prod_name_error">Informe o nome do produto.</div>
              </div>
              <div class="col-md-4">
                <label for="prod_sku" class="form-label field-required">SKU</label>
                <input type="text" class="form-control" id="prod_sku" placeholder="Ex.: SKU-0001" autocomplete="off">
                <div class="invalid-feedback" id="prod_sku_error">Informe o SKU do produto.</div>
                <div class="form-text">Código único para estoque e vendas.</div>
              </div>
              <div class="col-md-6">
                <label for="prod_lab_id" class="form-label field-required">Laboratório</label>
                <select class="form-select" id="prod_lab_id">
                  <option value="">— Selecione o laboratório —</option>
                  <% if (typeof labs !== 'undefined' && labs) { labs.forEach(function(l) { %>
                    <option value="<%= l.id %>"><%= l.name %></option>
                  <% }); } %>
                </select>
                <div class="invalid-feedback" id="prod_lab_id_error">Selecione o laboratório fabricante.</div>
              </div>
              <div class="col-md-6">
                <label for="prod_supplier_id" class="form-label field-required">Fornecedor principal</label>
                <select class="form-select" id="prod_supplier_id">
                  <option value="">— Selecione o fornecedor —</option>
                  <% if (typeof suppliers !== 'undefined' && suppliers) { suppliers.forEach(function(s) { %>
                    <option value="<%= s.id %>"><%= s.corporate_name %></option>
                  <% }); } %>
                </select>
                <div class="invalid-feedback" id="prod_supplier_id_error">Selecione o fornecedor principal.</div>
              </div>
              <div class="col-md-6">
                <label for="prod_category_id" class="form-label field-required">Categoria</label>
                <select class="form-select" id="prod_category_id">
                  <option value="">— Selecione uma categoria —</option>
                  <% if (typeof categories !== 'undefined' && categories) { categories.forEach(function(c) { %>
                    <option value="<%= c.id %>"><%= c.name %></option>
                  <% }); } %>
                </select>
                <div class="invalid-feedback" id="prod_category_id_error">Selecione uma categoria.</div>
              </div>
              <div class="col-md-6">
                <label for="prod_type_id" class="form-label field-required">Tipo de produto</label>
                <select class="form-select" id="prod_type_id">
                  <option value="">— Selecione o tipo —</option>
                  <% if (typeof productTypes !== 'undefined' && productTypes) { productTypes.forEach(function(t) { %>
                    <option value="<%= t.id %>" data-slug="<%= t.slug %>"><%= t.name %></option>
                  <% }); } %>
                </select>
                <div class="invalid-feedback" id="prod_type_id_error">Selecione o tipo de produto.</div>
              </div>
              <div class="col-md-4">
                <label for="prod_unit_price" class="form-label field-required">Preço unitário (R$)</label>
                <input type="text" class="form-control" id="prod_unit_price" placeholder="0,00" inputmode="decimal">
                <div class="invalid-feedback" id="prod_unit_price_error">Informe um preço válido maior que zero.</div>
              </div>
              <div class="col-md-4">
                <label for="prod_promotional_price" class="form-label">Preço promocional (R$)</label>
                <input type="text" class="form-control" id="prod_promotional_price" placeholder="Opcional" inputmode="decimal">
                <div class="invalid-feedback" id="prod_promotional_price_error">Preço promocional inválido.</div>
                <div class="form-text">Deve ser menor que o preço unitário.</div>
              </div>
              <div class="col-md-4">
                <label for="prod_status" class="form-label">Status</label>
                <select class="form-select" id="prod_status">
                  <option value="ACTIVE">Ativo</option>
                  <option value="INACTIVE">Inativo</option>
                  <option value="DISCONTINUED">Descontinuado</option>
                </select>
              </div>
              <div class="col-12">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" id="prod_prescription">
                  <label class="form-check-label" for="prod_prescription">Exige receita médica</label>
                </div>
              </div>
              <div class="col-md-6">
                <label for="prod_ean13" class="form-label" id="prod_ean13_label">EAN-13</label>
                <input type="text" class="form-control" id="prod_ean13" maxlength="13" placeholder="Somente números (13 dígitos)" inputmode="numeric" pattern="[0-9]*" autocomplete="off">
                <div class="invalid-feedback" id="prod_ean13_error">Informe um EAN-13 válido com 13 dígitos.</div>
                <div class="form-text" id="prod_ean13_hint">Opcional para cosméticos e higiene. Obrigatório para medicamentos e produtos com receita. Validação GS1 (dígito verificador).</div>
              </div>
              <div class="col-md-6">
                <label for="prod_gtin14" class="form-label">GTIN-14 (caixa de distribuição)</label>
                <input type="text" class="form-control" id="prod_gtin14" maxlength="14" placeholder="Somente números (14 dígitos)" inputmode="numeric" pattern="[0-9]*" autocomplete="off">
                <div class="invalid-feedback" id="prod_gtin14_error">Informe um GTIN-14 válido com 14 dígitos.</div>
                <div class="form-text">Opcional. Código de embalagem para recebimento em caixa master (validação GS1).</div>
              </div>
              <div class="col-12">
                <label for="prod_description" class="form-label">Descrição</label>
                <textarea class="form-control" id="prod_description" rows="2" placeholder="Descrição"></textarea>
              </div>
              <div class="col-12">
                <label for="prod_composition" class="form-label">Composição</label>
                <textarea class="form-control" id="prod_composition" rows="2" placeholder="Composição"></textarea>
              </div>
              <div class="col-12">
                <label for="prod_usage_info" class="form-label">Modo de uso</label>
                <textarea class="form-control" id="prod_usage_info" rows="2" placeholder="Ex.: Tomar 1 cápsula ao dia após as refeições."></textarea>
              </div>
              <div class="col-12 pt-2 border-top" id="prodImagensSection" style="display: none;">
                <div class="cadastro-edit-section-title mb-2">Imagens da vitrine</div>
                <p class="text-muted small mb-2">Adicione por upload ou informe URL/caminho. A ordem será usada na vitrine.</p>
                <div id="prodImageFeedback" class="small mb-2" style="display:none;"></div>
                <div class="d-flex gap-2 mb-2">
                  <input type="file" class="form-control" id="prod_image_file" accept="image/png,image/jpeg,image/webp,image/gif">
                  <button type="button" class="btn btn-outline-primary btn-sm flex-shrink-0" id="btnUploadProdImage"><i class="bi bi-upload"></i> Enviar arquivo</button>
                </div>
                <div class="d-flex gap-2 mb-2">
                  <input type="text" class="form-control" id="prod_image_url" placeholder="URL ou caminho da imagem">
                  <button type="button" class="btn btn-outline-primary btn-sm flex-shrink-0" id="btnAddProdImage"><i class="bi bi-plus-lg"></i> Adicionar</button>
                </div>
                <div id="prodImagensList" class="d-flex flex-wrap gap-2"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-save" id="btnSalvarProd"><i class="bi bi-check-lg me-1"></i> Salvar</button>
      </div>
    </div>
  </div>
</div>

