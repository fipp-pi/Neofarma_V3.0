<%- include('partials/footer') %>
<script>
  var PROD_FIELD_IDS = {
    name: 'prod_name',
    sku: 'prod_sku',
    lab_id: 'prod_lab_id',
    main_supplier_id: 'prod_supplier_id',
    product_type_id: 'prod_type_id',
    category_id: 'prod_category_id',
    unit_price: 'prod_unit_price',
    promotional_price: 'prod_promotional_price',
    ean13: 'prod_ean13',
    gtin14: 'prod_gtin14'
  };
  var BATCH_FIELD_IDS = ['batch_code', 'batch_mfg_date', 'batch_expiry_date', 'batch_quantity'];
  var MEDICATION_TYPE_RE = /medicament|homeopat|fitoterap|manipulad|medicin|controlad|cha-medicinal/i;

  function isMedicationProduct() {
    if (document.getElementById('prod_prescription').checked) return true;
    var sel = document.getElementById('prod_type_id');
    if (!sel || !sel.value) return false;
    var opt = sel.options[sel.selectedIndex];
    var slug = (opt && opt.getAttribute('data-slug')) || '';
    var name = (opt && opt.textContent) || '';
    return MEDICATION_TYPE_RE.test(slug) || MEDICATION_TYPE_RE.test(name);
  }

  function isValidGtinChecksum(digits, expectedLength) {
    if (!digits || digits.length !== expectedLength) return false;
    if (/^(\d)\1+$/.test(digits)) return false;
    var sum = 0;
    for (var i = 0; i < expectedLength - 1; i++) {
      var n = parseInt(digits.charAt(i), 10);
      sum += i % 2 === 0 ? n : n * 3;
    }
    var check = (10 - (sum % 10)) % 10;
    return check === parseInt(digits.charAt(expectedLength - 1), 10);
  }

  function isValidEan13Checksum(digits) {
    return isValidGtinChecksum(digits, 13);
  }

  function isValidGtin14Checksum(digits) {
    return isValidGtinChecksum(digits, 14);
  }

  function bindDigitsInput(fieldId, maxLen) {
    var el = document.getElementById(fieldId);
    if (!el) return;
    el.setAttribute('maxlength', String(maxLen));
    el.setAttribute('inputmode', 'numeric');
    el.setAttribute('pattern', '[0-9]*');
    el.addEventListener('input', function() {
      var cleaned = el.value.replace(/\D/g, '').slice(0, maxLen);
      if (el.value !== cleaned) el.value = cleaned;
      clearFieldError(fieldId);
      setProdFormAlert('');
    });
    el.addEventListener('paste', function(e) {
      e.preventDefault();
      var pasted = (e.clipboardData || window.clipboardData).getData('text') || '';
      el.value = pasted.replace(/\D/g, '').slice(0, maxLen);
      clearFieldError(fieldId);
      setProdFormAlert('');
    });
  }
  bindDigitsInput('prod_ean13', 13);
  bindDigitsInput('prod_gtin14', 14);

  function syncEanFieldRequirement() {
    var label = document.getElementById('prod_ean13_label');
    var required = isMedicationProduct();
    if (label) {
      label.classList.toggle('field-required', required);
    }
  }

  function showPageFlash(message, type) {
    var wrap = document.getElementById('pageFlash');
    var alertEl = document.getElementById('pageFlashAlert');
    var textEl = document.getElementById('pageFlashText');
    if (!wrap || !alertEl || !textEl) return;
    alertEl.className = 'alert alert-dismissible fade show mb-0 alert-' + (type === 'danger' ? 'danger' : 'success');
    textEl.textContent = message;
    wrap.style.display = 'block';
  }

  (function initPageFlash() {
    try {
      var raw = sessionStorage.getItem('prodAdminFlash');
      if (!raw) return;
      sessionStorage.removeItem('prodAdminFlash');
      var data = JSON.parse(raw);
      if (data && data.message) showPageFlash(data.message, data.type || 'success');
    } catch (e) { /* ignore */ }
  })();

  function setProdFormAlert(message) {
    var el = document.getElementById('prodFormAlert');
    if (!el) return;
    if (!message) {
      el.style.display = 'none';
      el.textContent = '';
      return;
    }
    el.style.display = 'block';
    el.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> ' + message;
  }

  function clearFieldError(fieldId) {
    var input = document.getElementById(fieldId);
    var err = document.getElementById(fieldId + '_error');
    if (input) input.classList.remove('is-invalid');
    if (err) err.style.display = 'none';
  }

  function setFieldError(fieldId, message) {
    var input = document.getElementById(fieldId);
    var err = document.getElementById(fieldId + '_error');
    if (input) {
      input.classList.add('is-invalid');
      input.focus({ preventScroll: true });
    }
    if (err && message) {
      err.textContent = message;
      err.style.display = 'block';
    }
  }

  function clearProdValidation() {
    setProdFormAlert('');
    Object.keys(PROD_FIELD_IDS).forEach(function(k) { clearFieldError(PROD_FIELD_IDS[k]); });
  }

  function clearBatchValidation() {
    BATCH_FIELD_IDS.forEach(function(id) { clearFieldError(id); });
  }

  function applyServerFieldErrors(fields) {
    if (!fields || typeof fields !== 'object') return;
    Object.keys(fields).forEach(function(key) {
      var fieldId = PROD_FIELD_IDS[key] || key;
      setFieldError(fieldId, fields[key]);
    });
  }

  function numBr(v) {
    if (v === '' || v === null || v === undefined) return null;
    var n = parseFloat(String(v).replace(',', '.'));
    return Number.isNaN(n) ? null : n;
  }

  function validateProdFormClient() {
    clearProdValidation();
    var errors = {};
    var name = document.getElementById('prod_name').value.trim();
    var sku = document.getElementById('prod_sku').value.trim();
    var categoryId = document.getElementById('prod_category_id').value;
    var labId = document.getElementById('prod_lab_id').value;
    var supplierId = document.getElementById('prod_supplier_id').value;
    var productTypeId = document.getElementById('prod_type_id').value;
    var unitPrice = numBr(document.getElementById('prod_unit_price').value);
    var promoPrice = numBr(document.getElementById('prod_promotional_price').value);
    var eanDigits = document.getElementById('prod_ean13').value.replace(/\D/g, '');
    var gtin14Digits = document.getElementById('prod_gtin14').value.replace(/\D/g, '');

    if (!name) errors.name = 'Informe o nome do produto.';
    else if (name.length < 2) errors.name = 'O nome deve ter pelo menos 2 caracteres.';

    if (!sku) errors.sku = 'Informe o SKU do produto.';
    else if (sku.length < 2) errors.sku = 'O SKU deve ter pelo menos 2 caracteres.';

    if (!labId) errors.lab_id = 'Selecione o laboratório fabricante.';
    if (!supplierId) errors.main_supplier_id = 'Selecione o fornecedor principal.';
    if (!productTypeId) errors.product_type_id = 'Selecione o tipo de produto.';
    if (!categoryId) errors.category_id = 'Selecione uma categoria.';

    if (unitPrice === null) errors.unit_price = 'Informe o preço unitário.';
    else if (unitPrice <= 0) errors.unit_price = 'O preço unitário deve ser maior que zero.';

    if (promoPrice !== null && promoPrice >= 0 && unitPrice !== null && promoPrice >= unitPrice) {
      errors.promotional_price = 'O preço promocional deve ser menor que o preço unitário.';
    }

    if (eanDigits) {
      if (eanDigits.length !== 13) {
        errors.ean13 = 'O EAN-13 deve conter exatamente 13 dígitos.';
      } else if (!isValidEan13Checksum(eanDigits)) {
        errors.ean13 = 'EAN-13 inválido — verifique o dígito verificador.';
      }
    } else if (isMedicationProduct()) {
      errors.ean13 = 'Informe o EAN-13 para medicamentos e produtos sujeitos a receita.';
    }

    if (gtin14Digits) {
      if (gtin14Digits.length !== 14) {
        errors.gtin14 = 'O GTIN-14 deve conter exatamente 14 dígitos.';
      } else if (!isValidGtin14Checksum(gtin14Digits)) {
        errors.gtin14 = 'GTIN-14 inválido — verifique o dígito verificador.';
      }
    }

    var keys = Object.keys(errors);
    if (keys.length) {
      applyServerFieldErrors(errors);
      setProdFormAlert('Revise os campos destacados em vermelho antes de continuar.');
      var first = PROD_FIELD_IDS[keys[0]] || keys[0];
      var firstEl = document.getElementById(first);
      if (firstEl) firstEl.focus();
      return false;
    }
    return true;
  }

  function validateBatchFormClient() {
    clearBatchValidation();
    var batch_code = document.getElementById('batch_code').value.trim();
    var mfg_date = document.getElementById('batch_mfg_date').value;
    var expiry_date = document.getElementById('batch_expiry_date').value;
    var quantity = parseInt(document.getElementById('batch_quantity').value || '0', 10);
    var ok = true;

    if (!batch_code) { setFieldError('batch_code', 'Informe o código do lote.'); ok = false; }
    if (!expiry_date) { setFieldError('batch_expiry_date', 'Informe a data de validade.'); ok = false; }
    if (Number.isNaN(quantity) || quantity < 0) { setFieldError('batch_quantity', 'Informe uma quantidade válida (0 ou mais).'); ok = false; }
    if (mfg_date && expiry_date && mfg_date > expiry_date) {
      setFieldError('batch_mfg_date', 'A fabricação não pode ser posterior à validade.');
      ok = false;
    }
    if (!ok) setProdBatchFeedback('Corrija os campos de lote destacados.', true);
    return ok;
  }

  Object.keys(PROD_FIELD_IDS).forEach(function(k) {
    var el = document.getElementById(PROD_FIELD_IDS[k]);
    if (!el) return;
    el.addEventListener('input', function() { clearFieldError(PROD_FIELD_IDS[k]); setProdFormAlert(''); });
    el.addEventListener('change', function() {
      clearFieldError(PROD_FIELD_IDS[k]);
      setProdFormAlert('');
      if (k === 'product_type_id') syncEanFieldRequirement();
    });
  });
  var rxEl = document.getElementById('prod_prescription');
  if (rxEl) {
    rxEl.addEventListener('change', function() {
      clearFieldError('prod_ean13');
      syncEanFieldRequirement();
    });
  }
  BATCH_FIELD_IDS.forEach(function(id) {
    var el = document.getElementById(id);
    if (!el) return;
    el.addEventListener('input', function() { clearFieldError(id); });
    el.addEventListener('change', function() { clearFieldError(id); });
  });

  function filtrarTabela() {
    if (window.__prodFilters) window.__prodFilters.apply();
  }

  if (window.NeoFarmaCatalogFilters) {
    window.__prodFilters = NeoFarmaCatalogFilters.init({
      tableBodySelector: '#tabelaProd tbody tr',
      resultsId: 'prodResultsCount',
      emptyFilterId: 'mensagemVaziaFilter',
      tableWrapId: 'catalogTableWrap',
      clearBtnId: 'prodClearFilters',
      filtersToggleId: 'prodFiltersToggle',
      filtersPanelId: 'prodFiltersPanel',
      inputs: {
        q: 'filtro_q', lab: 'filtro_lab', cat: 'filtro_cat', type: 'filtro_type',
        status: 'filtro_status', rx: 'filtro_rx', risk: 'filtro_risk',
        priceMin: 'filtro_price_min', priceMax: 'filtro_price_max',
      },
      matchRow: function (tr, v) {
        var F = NeoFarmaCatalogFilters;
        if (!F.textMatch(tr, v.q)) return false;
        if (v.lab && v.lab !== 'ALL' && String(tr.getAttribute('data-filter-lab')) !== String(v.lab)) return false;
        if (v.cat && v.cat !== 'ALL' && String(tr.getAttribute('data-filter-cat')) !== String(v.cat)) return false;
        if (v.type && v.type !== 'ALL' && String(tr.getAttribute('data-filter-type')) !== String(v.type)) return false;
        if (v.status && v.status !== 'ALL' && tr.getAttribute('data-filter-status') !== v.status) return false;
        if (v.rx === '1' && tr.getAttribute('data-filter-rx') !== '1') return false;
        if (v.rx === '0' && tr.getAttribute('data-filter-rx') !== '0') return false;
        var risk = tr.getAttribute('data-filter-risk') || 'none';
        if (v.risk === 'none' && risk !== 'none') return false;
        if (v.risk === 'expiring' && risk !== 'expiring' && risk !== 'both') return false;
        if (v.risk === 'expired' && risk !== 'expired' && risk !== 'both') return false;
        var price = F.parseNum(tr.getAttribute('data-filter-price'));
        var minP = F.parseNum(v.priceMin);
        var maxP = F.parseNum(v.priceMax);
        if (minP != null && price != null && price < minP) return false;
        if (maxP != null && price != null && price > maxP) return false;
        return true;
      },
      onApply: function (visible) {
        var el = document.getElementById('prodResultsVisible');
        if (el) el.textContent = visible;
      },
    });
  }
  function abrirModalProd() {
    clearProdValidation();
    document.getElementById('prod_id').value = '';
    document.getElementById('prod_name').value = '';
    document.getElementById('prod_sku').value = '';
    document.getElementById('prod_lab_id').value = '';
    document.getElementById('prod_supplier_id').value = '';
    document.getElementById('prod_category_id').value = '';
    document.getElementById('prod_type_id').value = '';
    document.getElementById('prod_unit_price').value = '';
    document.getElementById('prod_promotional_price').value = '';
    document.getElementById('prod_status').value = 'ACTIVE';
    document.getElementById('prod_prescription').checked = false;
    document.getElementById('prod_ean13').value = '';
    document.getElementById('prod_gtin14').value = '';
    document.getElementById('prod_description').value = '';
    document.getElementById('prod_composition').value = '';
    document.getElementById('prod_usage_info').value = '';
    document.getElementById('modalEditarTitle').innerHTML = '<i class="bi bi-pencil-square me-2"></i>Novo produto';
    syncEanFieldRequirement();
    document.getElementById('prodImagensSection').style.display = 'none';
    document.getElementById('prod_image_file').value = '';
    document.getElementById('prod_image_url').value = '';
    document.getElementById('prodImagensList').innerHTML = '';
    document.getElementById('prodBatchList').innerHTML = '';
    document.getElementById('batch_code').value = '';
    document.getElementById('batch_mfg_date').value = '';
    document.getElementById('batch_expiry_date').value = '';
    document.getElementById('batch_quantity').value = '';
    document.getElementById('btnAddBatch').removeAttribute('data-edit-id');
    document.getElementById('btnAddBatch').innerHTML = '<i class="bi bi-plus-lg"></i>';
    setProdImageFeedback('', false);
    setProdBatchFeedback('', false);
  }
  var lotesProdId = null;
  function abrirModalLotes(btn) {
    try { var item = JSON.parse(decodeURIComponent(btn.getAttribute('data-item') || '{}')); } catch (e) { return; }
    if (!item || !item.id) return;
    lotesProdId = item.id;
    document.getElementById('modalLotesTitle').innerHTML = '<i class="bi bi-archive me-2"></i>Lotes - ' + (item.name || ('Produto #' + item.id));
    document.getElementById('batch_code').value = '';
    document.getElementById('batch_mfg_date').value = '';
    document.getElementById('batch_expiry_date').value = '';
    document.getElementById('batch_quantity').value = '';
    document.getElementById('btnAddBatch').removeAttribute('data-edit-id');
    document.getElementById('btnAddBatch').innerHTML = '<i class="bi bi-plus-lg"></i>';
    setProdBatchFeedback('', false);
    carregarProdLotes(item.id);
    new bootstrap.Modal(document.getElementById('modalLotes')).show();
  }
  function verProd(id) {
    var tr = [].find.call(document.querySelectorAll('#tabelaProd tbody tr'), function(r) { return parseInt(r.cells[0].textContent, 10) === id; });
    if (!tr) return;
    var nome = tr.cells[1].textContent;
    var sku = tr.cells[2].textContent;
    var lab = tr.cells[3].textContent;
    var preco = tr.cells[4].textContent;
    var status = tr.cells[5].textContent;
    var inicial = nome ? nome.charAt(0).toUpperCase() : '?';
    var html = '<div class="cadastro-view">' +
      '<div class="cadastro-view-avatar">' + inicial + '</div>' +
      '<div class="cadastro-view-nome">' + nome + '</div>' +
      '<div class="cadastro-view-section">' +
        '<div class="cadastro-view-section-title">Dados</div>' +
        '<div class="cadastro-view-row"><span class="cadastro-view-label">SKU</span><span class="cadastro-view-value">' + (sku === '-' ? '-' : sku) + '</span></div>' +
        '<div class="cadastro-view-row"><span class="cadastro-view-label">Laboratório</span><span class="cadastro-view-value">' + (lab === '-' ? '-' : lab) + '</span></div>' +
        '<div class="cadastro-view-row"><span class="cadastro-view-label">Preço</span><span class="cadastro-view-value">' + preco + '</span></div>' +
        '<div class="cadastro-view-row"><span class="cadastro-view-label">Status</span><span class="cadastro-view-value">' + status + '</span></div>' +
      '</div></div>';
    document.getElementById('conteudoVisualizacao').innerHTML = html;
    new bootstrap.Modal(document.getElementById('modalVisualizar')).show();
  }
  function editarProd(btn) {
    try { var item = JSON.parse(decodeURIComponent(btn.getAttribute('data-item') || '{}')); } catch (e) { return; }
    clearProdValidation();
    document.getElementById('prod_id').value = item.id;
    document.getElementById('prod_name').value = item.name || '';
    document.getElementById('prod_sku').value = item.sku || '';
    document.getElementById('prod_lab_id').value = item.lab_id || '';
    document.getElementById('prod_supplier_id').value = item.main_supplier_id || '';
    document.getElementById('prod_category_id').value = item.category_id || '';
    document.getElementById('prod_type_id').value = item.product_type_id || '';
    document.getElementById('prod_unit_price').value = item.unit_price != null ? String(item.unit_price).replace('.', ',') : '';
    document.getElementById('prod_promotional_price').value = item.promotional_price != null ? String(item.promotional_price).replace('.', ',') : '';
    document.getElementById('prod_status').value = item.status || 'ACTIVE';
    document.getElementById('prod_prescription').checked = !!item.prescription_required;
    document.getElementById('prod_ean13').value = item.ean13 || '';
    document.getElementById('prod_gtin14').value = item.gtin14 || '';
    document.getElementById('prod_description').value = item.description || '';
    document.getElementById('prod_composition').value = item.composition || '';
    document.getElementById('prod_usage_info').value = item.usage_info || '';
    document.getElementById('modalEditarTitle').innerHTML = '<i class="bi bi-pencil-square me-2"></i>Editar produto';
    document.getElementById('prodImagensSection').style.display = 'block';
    document.getElementById('prod_image_file').value = '';
    document.getElementById('prod_image_url').value = '';
    setProdImageFeedback('', false);
    carregarProdImagens(item.id);
    syncEanFieldRequirement();
    new bootstrap.Modal(document.getElementById('modalEditar')).show();
  }
  function carregarProdImagens(prodId) {
    var listEl = document.getElementById('prodImagensList');
    listEl.innerHTML = '<span class="text-muted small">Carregando...</span>';
    fetch('/admin/produtos/' + prodId + '/imagens', { headers: { 'Accept': 'application/json' } })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        listEl.innerHTML = '';
        if (res.ok && res.data && res.data.length) {
          res.data.forEach(function(img) {
            var card = document.createElement('div');
            card.className = 'border rounded p-2 d-flex align-items-center gap-2 bg-light';
            card.style.maxWidth = '200px';
            var thumb = document.createElement('img');
            var fullSrc = img.image_url.startsWith('http') || img.image_url.startsWith('/') ? img.image_url : '/' + img.image_url.replace(/^\//, '');
            var thumbSrc = fullSrc;
            if (/^\/uploads\/products\/.+\.webp$/i.test(fullSrc) && !/-thumb\.webp$/i.test(fullSrc)) {
              thumbSrc = fullSrc.replace(/\.webp$/i, '-thumb.webp');
            }
            thumb.src = thumbSrc;
            thumb.alt = 'Imagem';
            thumb.style.width = '48px'; thumb.style.height = '48px'; thumb.style.objectFit = 'cover'; thumb.style.borderRadius = '4px';
            thumb.onerror = function() {
              if (this.src !== fullSrc) {
                this.src = fullSrc;
                return;
              }
              this.style.display = 'none';
            };
            var url = document.createElement('span');
            url.className = 'small text-truncate flex-grow-1'; url.title = img.image_url; url.textContent = img.image_url;
            var btnDel = document.createElement('button');
            btnDel.type = 'button'; btnDel.className = 'btn btn-outline-danger btn-sm'; btnDel.innerHTML = '<i class="bi bi-trash"></i>';
            btnDel.onclick = function() { excluirProdImagem(img.id, prodId); };
            card.appendChild(thumb); card.appendChild(url); card.appendChild(btnDel);
            listEl.appendChild(card);
          });
        } else {
          listEl.innerHTML = '<span class="text-muted small">Nenhuma imagem. Adicione acima.</span>';
        }
      })
      .catch(function() { listEl.innerHTML = '<span class="text-danger small">Erro ao carregar imagens.</span>'; });
  }
  function setProdImageFeedback(message, isError) {
    var el = document.getElementById('prodImageFeedback');
    if (!message) {
      el.style.display = 'none';
      el.textContent = '';
      el.className = 'small mb-2';
      return;
    }
    el.style.display = 'block';
    el.textContent = message;
    el.className = 'small mb-2 ' + (isError ? 'text-danger' : 'text-success');
  }
  function excluirProdImagem(imageId, prodId) {
    window.neofarmaConfirm({
      title: 'Remover imagem',
      message: 'Remover esta imagem?'
    }).then(function(ok) {
      if (!ok) return;
      setProdImageFeedback('', false);
      fetch('/admin/produtos/imagens/' + imageId, { method: 'DELETE' })
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (d.ok) {
            carregarProdImagens(prodId);
            setProdImageFeedback('Imagem removida com sucesso.', false);
          } else {
            setProdImageFeedback(d.message || 'Erro ao remover imagem.', true);
          }
        })
        .catch(function() { setProdImageFeedback('Erro ao remover imagem.', true); });
    });
  }
  function setProdBatchFeedback(message, isError) {
    var el = document.getElementById('prodBatchFeedback');
    if (!message) {
      el.style.display = 'none';
      el.textContent = '';
      el.className = 'small mb-2';
      return;
    }
    el.style.display = 'block';
    el.textContent = message;
    el.className = 'small mb-2 ' + (isError ? 'text-danger' : 'text-success');
  }
  function formatDateBr(iso) {
    if (!iso) return '-';
    return window.NeoDates ? NeoDates.formatDate(iso) : iso;
  }
  function batchStatus(expiryDate) {
    if (!expiryDate) return { label: '-', cls: 'secondary' };
    var today = new Date(); today.setHours(0, 0, 0, 0);
    var exp = new Date(expiryDate); exp.setHours(0, 0, 0, 0);
    var diffDays = Math.floor((exp - today) / 86400000);
    if (diffDays < 0) return { label: 'Vencido', cls: 'danger' };
    if (diffDays <= 30) return { label: 'Próx. vencimento', cls: 'warning text-dark' };
    return { label: 'Válido', cls: 'success' };
  }
  function summarizeRisk(batches) {
    var expired = 0, expiring = 0, valid = 0;
    (batches || []).forEach(function(b) {
      if (b.validity_status === 'EXPIRED') expired++;
      else if (b.validity_status === 'EXPIRING') expiring++;
      else valid++;
    });
    return 'Válidos: ' + valid + ' | Próx. vencimento: ' + expiring + ' | Vencidos: ' + expired;
  }
  function carregarProdLotes(prodId) {
    var tbody = document.getElementById('prodBatchList');
    var status = document.getElementById('batchFilterStatus').value;
    var sort = document.getElementById('batchSort').value;
    tbody.innerHTML = '<tr><td colspan="7" class="text-muted small">Carregando lotes...</td></tr>';
    fetch('/admin/produtos/' + prodId + '/lotes?status=' + encodeURIComponent(status) + '&sort=' + encodeURIComponent(sort), { headers: { 'Accept': 'application/json' } })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        tbody.innerHTML = '';
        if (!res.ok || !res.batches || !res.batches.length) {
          document.getElementById('batchRiskSummary').textContent = '';
          tbody.innerHTML = '<tr><td colspan="7" class="text-muted small">Nenhum lote cadastrado.</td></tr>';
          return;
        }
        document.getElementById('batchRiskSummary').textContent = summarizeRisk(res.batches);
        res.batches.forEach(function(b) {
          var s = batchStatus(b.expiry_date);
          var disp = '—';
          if (b.disposal_status === 'FULL') {
            disp = '<span class="badge bg-secondary">Total (' + Number(b.disposed_qty || 0) + ' un.)</span>';
          } else if (b.disposal_status === 'PARTIAL') {
            disp = '<span class="badge bg-info text-dark">Parcial (' + Number(b.disposed_qty || 0) + ' un.)</span>';
          }
          var tr = document.createElement('tr');
          tr.innerHTML =
            '<td>' + (b.batch_code || '-') + '</td>' +
            '<td>' + formatDateBr(b.mfg_date) + '</td>' +
            '<td>' + formatDateBr(b.expiry_date) + '</td>' +
            '<td><span class="badge bg-' + s.cls + '">' + s.label + '</span></td>' +
            '<td>' + disp + '</td>' +
            '<td>' + Number(b.quantity || 0) + '</td>' +
            '<td class="col-actions"><div class="table-actions table-actions--2">' +
              '<button type="button" class="btn btn-outline-secondary btn-sm" title="Editar"><i class="bi bi-pencil"></i></button>' +
              '<button type="button" class="btn btn-outline-danger btn-sm" title="Excluir"><i class="bi bi-trash"></i></button>' +
            '</div></td>';
          var btnEdit = tr.querySelector('.btn-outline-secondary');
          var btnDel = tr.querySelector('.btn-outline-danger');
          btnEdit.onclick = function() {
            document.getElementById('batch_code').value = b.batch_code || '';
            document.getElementById('batch_mfg_date').value = b.mfg_date ? (window.NeoDates ? NeoDates.formatDateInput(b.mfg_date) : String(b.mfg_date).slice(0, 10)) : '';
            document.getElementById('batch_expiry_date').value = b.expiry_date ? (window.NeoDates ? NeoDates.formatDateInput(b.expiry_date) : String(b.expiry_date).slice(0, 10)) : '';
            document.getElementById('batch_quantity').value = Number(b.quantity || 0);
            document.getElementById('btnAddBatch').setAttribute('data-edit-id', b.id);
            document.getElementById('btnAddBatch').innerHTML = '<i class="bi bi-check2"></i>';
            setProdBatchFeedback('Editando lote ' + (b.batch_code || ('#' + b.id)) + '.', false);
          };
          btnDel.onclick = function() {
            window.neofarmaConfirm({
              title: 'Excluir lote',
              message: 'Excluir lote ' + (b.batch_code || ('#' + b.id)) + '?'
            }).then(function(ok) {
              if (!ok) return;
              fetch('/admin/produtos/lotes/' + b.id, { method: 'DELETE' })
                .then(function(r) { return r.json(); })
                .then(function(d) {
                  if (d.ok) {
                    setProdBatchFeedback('Lote removido.', false);
                    carregarProdLotes(prodId);
                  } else {
                    setProdBatchFeedback(d.message || 'Erro ao excluir lote.', true);
                  }
                })
                .catch(function() { setProdBatchFeedback('Erro ao excluir lote.', true); });
            });
          };
          tbody.appendChild(tr);
        });
      })
      .catch(function() {
        document.getElementById('batchRiskSummary').textContent = '';
        tbody.innerHTML = '<tr><td colspan="7" class="text-danger small">Erro ao carregar lotes.</td></tr>';
      });
  }
  document.getElementById('batchFilterStatus').addEventListener('change', function() {
    var prodId = lotesProdId;
    if (prodId) carregarProdLotes(prodId);
  });
  document.getElementById('batchSort').addEventListener('change', function() {
    var prodId = lotesProdId;
    if (prodId) carregarProdLotes(prodId);
  });
  document.getElementById('btnAddBatch').addEventListener('click', function() {
    var prodId = lotesProdId;
    if (!prodId) { setProdBatchFeedback('Salve o produto antes de gerenciar lotes.', true); return; }
    if (!validateBatchFormClient()) return;

    var batch_code = document.getElementById('batch_code').value.trim();
    var mfg_date = document.getElementById('batch_mfg_date').value || null;
    var expiry_date = document.getElementById('batch_expiry_date').value;
    var quantity = parseInt(document.getElementById('batch_quantity').value || '0', 10);

    var editId = this.getAttribute('data-edit-id');
    var url = editId ? ('/admin/produtos/lotes/' + editId) : ('/admin/produtos/' + prodId + '/lotes');
    var method = editId ? 'PUT' : 'POST';
    setProdBatchFeedback(editId ? 'Atualizando lote...' : 'Adicionando lote...', false);
    fetch(url, {
      method: method,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ batch_code: batch_code, mfg_date: mfg_date, expiry_date: expiry_date, quantity: quantity })
    })
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (d.ok) {
          document.getElementById('batch_code').value = '';
          document.getElementById('batch_mfg_date').value = '';
          document.getElementById('batch_expiry_date').value = '';
          document.getElementById('batch_quantity').value = '';
          clearBatchValidation();
          document.getElementById('btnAddBatch').removeAttribute('data-edit-id');
          document.getElementById('btnAddBatch').innerHTML = '<i class="bi bi-plus-lg"></i>';
          setProdBatchFeedback(editId ? 'Lote atualizado com sucesso.' : 'Lote adicionado com sucesso.', false);
          if (window.neofarmaToast) window.neofarmaToast(editId ? 'Lote atualizado.' : 'Lote adicionado ao estoque.', 'success');
          carregarProdLotes(prodId);
        } else {
          setProdBatchFeedback(d.message || 'Erro ao salvar lote.', true);
          if (window.neofarmaToast) window.neofarmaToast(d.message || 'Erro ao salvar lote.', 'danger');
        }
      })
      .catch(function() { setProdBatchFeedback('Erro ao salvar lote.', true); });
  });
  document.getElementById('btnAddProdImage').addEventListener('click', function() {
    var prodId = document.getElementById('prod_id').value;
    if (!prodId) { setProdImageFeedback('Salve o produto antes de adicionar imagens.', true); return; }
    var url = document.getElementById('prod_image_url').value.trim();
    if (!url) { setProdImageFeedback('Informe a URL ou caminho da imagem.', true); return; }
    setProdImageFeedback('', false);
    fetch('/admin/produtos/' + prodId + '/imagens', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ image_url: url })
    })
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (d.ok) {
          document.getElementById('prod_image_url').value = '';
          carregarProdImagens(prodId);
          setProdImageFeedback('Imagem adicionada com sucesso.', false);
        } else {
          setProdImageFeedback(d.message || 'Erro ao adicionar imagem.', true);
        }
      })
      .catch(function() { setProdImageFeedback('Erro ao adicionar imagem.', true); });
  });
  document.getElementById('btnUploadProdImage').addEventListener('click', function() {
    var prodId = document.getElementById('prod_id').value;
    if (!prodId) { setProdImageFeedback('Salve o produto antes de enviar imagens.', true); return; }
    var input = document.getElementById('prod_image_file');
    if (!input.files || !input.files.length) { setProdImageFeedback('Selecione um arquivo de imagem.', true); return; }
    setProdImageFeedback('Enviando imagem...', false);
    var formData = new FormData();
    formData.append('image', input.files[0]);
    fetch('/admin/produtos/' + prodId + '/imagens/upload', {
      method: 'POST',
      headers: { 'Accept': 'application/json' },
      body: formData
    })
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (d.ok) {
          input.value = '';
          carregarProdImagens(prodId);
          setProdImageFeedback('Upload concluído com sucesso.', false);
        } else {
          setProdImageFeedback(d.message || 'Erro ao enviar imagem.', true);
        }
      })
      .catch(function() { setProdImageFeedback('Erro ao enviar imagem.', true); });
  });
  var exclusaoId = null;
  function abrirModalExclusao(id, nome) {
    exclusaoId = id;
    document.getElementById('exclusaoNome').textContent = nome || ('#' + id);
    new bootstrap.Modal(document.getElementById('modalExclusao')).show();
  }
  document.getElementById('btnConfirmarExclusao').addEventListener('click', function() {
    if (!exclusaoId) return;
    var id = exclusaoId;
    exclusaoId = null;
    bootstrap.Modal.getInstance(document.getElementById('modalExclusao')).hide();
    fetch('/admin/produtos/' + id, { method: 'DELETE' }).then(function(r) { return r.json(); }).then(function(d) {
      if (d.ok) location.reload(); else window.neofarmaToast(d.message, 'danger');
    }).catch(function() { window.neofarmaToast('Erro ao excluir.', 'danger'); });
  });
  document.getElementById('btnConfirmarExclusao').addEventListener('click', function() {
    if (!exclusaoId) return;
    var id = exclusaoId;
    var nome = document.getElementById('exclusaoNome').textContent;
    exclusaoId = null;
    bootstrap.Modal.getInstance(document.getElementById('modalExclusao')).hide();
    fetch('/admin/produtos/' + id, { method: 'DELETE' }).then(function(r) { return r.json(); }).then(function(d) {
      if (d.ok) {
        sessionStorage.setItem('prodAdminFlash', JSON.stringify({ type: 'success', message: 'Produto "' + nome + '" removido com sucesso.' }));
        location.reload();
      } else {
        window.neofarmaToast(d.message || 'Não foi possível excluir o produto.', 'danger');
      }
    }).catch(function() { window.neofarmaToast('Erro de conexão ao excluir. Tente novamente.', 'danger'); });
  });

  document.getElementById('btnSalvarProd').addEventListener('click', function() {
    if (!validateProdFormClient()) {
      if (window.neofarmaToast) window.neofarmaToast('Preencha os campos obrigatórios.', 'warning');
      return;
    }
    var id = document.getElementById('prod_id').value;
    var name = document.getElementById('prod_name').value.trim();
    var categoryId = document.getElementById('prod_category_id').value;
    var body = {
      name: name,
      sku: document.getElementById('prod_sku').value.trim() || null,
      lab_id: document.getElementById('prod_lab_id').value || null,
      main_supplier_id: document.getElementById('prod_supplier_id').value || null,
      category_id: categoryId,
      product_type_id: document.getElementById('prod_type_id').value || null,
      unit_price: numBr(document.getElementById('prod_unit_price').value),
      promotional_price: numBr(document.getElementById('prod_promotional_price').value),
      status: document.getElementById('prod_status').value,
      prescription_required: document.getElementById('prod_prescription').checked,
      ean13: document.getElementById('prod_ean13').value.replace(/\D/g, '') || null,
      gtin14: document.getElementById('prod_gtin14').value.replace(/\D/g, '') || null,
      description: document.getElementById('prod_description').value.trim() || null,
      composition: document.getElementById('prod_composition').value.trim() || null,
      usage_info: document.getElementById('prod_usage_info').value.trim() || null
    };
    if (id) body.id = id;
    var btn = document.getElementById('btnSalvarProd');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Salvando...';
    fetch('/admin/produtos', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
      .then(function(r) {
        return r.text().then(function(txt) {
          var data = {};
          try { data = txt ? JSON.parse(txt) : {}; } catch (e) { data = {}; }
          if (!r.ok) {
            var err = new Error((data && data.message) || 'Erro ao salvar produto.');
            err.payload = data;
            err.status = r.status;
            throw err;
          }
          return data;
        });
      })
      .then(function(d) {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-check-lg me-1"></i> Salvar';
        if (d.ok) {
          bootstrap.Modal.getInstance(document.getElementById('modalEditar')).hide();
          sessionStorage.setItem('prodAdminFlash', JSON.stringify({
            type: 'success',
            message: d.message || ('Produto "' + (d.name || name) + '" salvo com sucesso.')
          }));
          location.reload();
        } else {
          applyServerFieldErrors(d.fields);
          setProdFormAlert(d.message || 'Não foi possível salvar.');
          window.neofarmaToast(d.message || 'Não foi possível salvar.', 'danger');
        }
      })
      .catch(function(err) {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-check-lg me-1"></i> Salvar';
        if (err.payload && err.payload.fields) applyServerFieldErrors(err.payload.fields);
        setProdFormAlert((err && err.message) || 'Erro ao salvar.');
        window.neofarmaToast((err && err.message) || 'Erro de conexão. Tente novamente.', 'danger');
      });
  });
</script>
