<%- include('partials/header') %>

<%
  function fmtMoney(v) {
    return Number(v || 0).toFixed(2).replace('.', ',');
  }
  const summaryData = typeof summary !== 'undefined' ? summary : {};
  const filtersData = typeof filters !== 'undefined' ? filters : { from: '', to: '', days: 30 };
  const revByMethod = typeof revenueByMethod !== 'undefined' ? revenueByMethod : {};
  const revByDayList = typeof revenueByDay !== 'undefined' ? revenueByDay : [];
  const topSold = typeof mostSold !== 'undefined' ? mostSold : [];
  const receiptsList = typeof recentReceipts !== 'undefined' ? recentReceipts : [];

  const totalOrders = Number(summaryData.total_transactions || 0);
  const pending = Number(summaryData.pending_count || 0);
  const failed = Number(summaryData.failed_count || 0);
  const paid = Math.max(0, totalOrders - pending - failed);

  function pct(value, base) {
    const b = Number(base || 0);
    if (!b) return 0;
    return Math.max(0, Math.min(100, Number((Number(value || 0) * 100 / b).toFixed(1))));
  }

  const pixRev = Number(revByMethod.PIX || 0);
  const boletoRev = Number(revByMethod.BOLETO || 0);
  const creditRev = Number(revByMethod.CREDIT_CARD || 0);
  const debitRev = Number(revByMethod.DEBIT_CARD || 0);
  const cashRev = Number(revByMethod.CASH || 0);
  const cardRev = creditRev + debitRev;
  const totalRevByMethod = pixRev + boletoRev + cardRev + cashRev;

  const periodLabel = filtersData.from && filtersData.to
    ? (filtersData.from + ' — ' + filtersData.to)
    : ('Últimos ' + (filtersData.days || 30) + ' dias');

  function finUrl(extra) {
    const q = new URLSearchParams();
    if (extra && extra.from) q.set('from', extra.from);
    if (extra && extra.to) q.set('to', extra.to);
    if (extra && extra.days) q.set('days', extra.days);
    const s = q.toString();
    return '/admin/financas' + (s ? '?' + s : '');
  }

  const PAY_LABELS = { PIX: 'PIX', BOLETO: 'Boleto', CREDIT_CARD: 'Cartão crédito', DEBIT_CARD: 'Cartão débito', CASH: 'Dinheiro' };
  const methodRows = [
    { key: 'PIX', value: pixRev, color: '#0d6efd' },
    { key: 'BOLETO', value: boletoRev, color: '#6c757d' },
    { key: 'CARTÃO', value: cardRev, color: '#0dcaf0' },
    { key: 'DINHEIRO', value: cashRev, color: '#198754' },
  ];
%>

<div class="container admin-catalog admin-financas">
  <div class="list-header mb-3">
    <div>
      <h2 class="neo-heading">Finanças</h2>
      <p class="text-muted mb-0">Visão consolidada de receitas da loja e dos serviços de saúde, com indicadores, gráficos e atalhos operacionais.</p>
    </div>
  </div>

  <%- include('partials/financas-nav') %>

  <section class="admin-catalog__panel mb-4">
    <div class="admin-catalog__panel-head d-flex flex-wrap justify-content-between align-items-center gap-2">
      <h3 class="admin-catalog__panel-title mb-0"><i class="bi bi-calendar-range me-2"></i>Período de análise</h3>
      <span class="admin-catalog__panel-meta"><i class="bi bi-clock me-1"></i><%= periodLabel %></span>
    </div>
    <div class="admin-catalog__panel-body">
      <form method="GET" action="/admin/financas" class="row g-3 align-items-end" id="finPeriodForm">
        <div class="col-md-3">
          <label class="form-label" for="fin_from">De</label>
          <input type="date" class="form-control form-control-sm" id="fin_from" name="from" value="<%= filtersData.from || '' %>">
        </div>
        <div class="col-md-3">
          <label class="form-label" for="fin_to">Até</label>
          <input type="date" class="form-control form-control-sm" id="fin_to" name="to" value="<%= filtersData.to || '' %>">
        </div>
        <div class="col-md-3 d-flex gap-2">
          <button type="submit" class="btn btn-primary btn-sm flex-grow-1"><i class="bi bi-funnel me-1"></i> Aplicar período</button>
          <a href="<%= finUrl({ days: 30 }) %>" class="btn btn-outline-secondary btn-sm" title="Limpar"><i class="bi bi-x-lg"></i></a>
        </div>
      </form>
      <div class="admin-catalog__tabs mt-3">
        <a href="<%= finUrl({ days: 7 }) %>" class="admin-catalog__tab <%= !filtersData.from && Number(filtersData.days) === 7 ? 'is-active' : '' %>">7 dias</a>
        <a href="<%= finUrl({ days: 30 }) %>" class="admin-catalog__tab <%= !filtersData.from && Number(filtersData.days) === 30 ? 'is-active' : '' %>">30 dias</a>
        <a href="<%= finUrl({ days: 90 }) %>" class="admin-catalog__tab <%= !filtersData.from && Number(filtersData.days) === 90 ? 'is-active' : '' %>">90 dias</a>
      </div>
    </div>
  </section>

  <div class="admin-catalog__stats row g-3 mb-4">
    <div class="col-6 col-lg-3">
      <div class="admin-catalog__stat admin-catalog__stat--primary">
        <span class="admin-catalog__stat-icon"><i class="bi bi-cash-stack"></i></span>
        <div>
          <div class="admin-catalog__stat-value admin-financas__stat-value--money">R$ <%= fmtMoney(summaryData.revenue_paid) %></div>
          <div class="admin-catalog__stat-label">Receita confirmada</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <a href="/admin/financas/pedidos?payment_status=PENDING" class="admin-catalog__stat admin-catalog__stat--warning text-decoration-none">
        <span class="admin-catalog__stat-icon"><i class="bi bi-hourglass-split"></i></span>
        <div>
          <div class="admin-catalog__stat-value"><%= pending %></div>
          <div class="admin-catalog__stat-label">Pagamentos pendentes</div>
        </div>
      </a>
    </div>
    <div class="col-6 col-lg-3">
      <a href="/admin/financas/pedidos?payment_status=FAILED" class="admin-catalog__stat admin-catalog__stat--danger text-decoration-none">
        <span class="admin-catalog__stat-icon"><i class="bi bi-x-octagon"></i></span>
        <div>
          <div class="admin-catalog__stat-value"><%= failed %></div>
          <div class="admin-catalog__stat-label">Pagamentos falhos</div>
        </div>
      </a>
    </div>
    <div class="col-6 col-lg-3">
      <div class="admin-catalog__stat admin-catalog__stat--neutral">
        <span class="admin-catalog__stat-icon"><i class="bi bi-receipt"></i></span>
        <div>
          <div class="admin-catalog__stat-value"><%= totalOrders %></div>
          <div class="admin-catalog__stat-label">Transações no período</div>
        </div>
      </div>
    </div>
  </div>

  <% if (pending > 0) { %>
  <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div><strong><i class="bi bi-exclamation-circle me-1"></i> Pendências financeiras:</strong> <%= pending %> transação(ões) aguardam confirmação de pagamento.</div>
    <a href="/admin/financas/pedidos?payment_status=PENDING" class="btn btn-sm btn-warning">Revisar pendentes</a>
  </div>
  <% } %>

  <div class="row g-3 mb-4">
    <div class="col-lg-6">
      <section class="admin-catalog__panel h-100">
        <div class="admin-catalog__panel-head">
          <h3 class="admin-catalog__panel-title"><i class="bi bi-pie-chart me-2"></i>Status das transações</h3>
        </div>
        <div class="admin-catalog__panel-body">
          <div class="admin-financas__chart-box">
            <canvas id="ordersStatusChart" aria-label="Gráfico de status de transações"></canvas>
          </div>
          <div class="admin-financas__chart-legend">
            Pagos: <strong><%= paid %></strong> (<%= pct(paid, totalOrders) %>%) ·
            Pendentes: <strong><%= pending %></strong> ·
            Falhou: <strong><%= failed %></strong>
          </div>
        </div>
      </section>
    </div>
    <div class="col-lg-6">
      <section class="admin-catalog__panel h-100">
        <div class="admin-catalog__panel-head d-flex flex-wrap justify-content-between align-items-center gap-2">
          <h3 class="admin-catalog__panel-title mb-0"><i class="bi bi-bar-chart me-2"></i>Receita por método</h3>
          <span class="admin-catalog__panel-meta">Total R$ <%= fmtMoney(totalRevByMethod) %></span>
        </div>
        <div class="admin-catalog__panel-body">
          <div class="admin-financas__chart-box">
            <canvas id="revenueByMethodChart" aria-label="Gráfico de receita por método"></canvas>
          </div>
        </div>
      </section>
    </div>
  </div>

  <section class="admin-catalog__panel mb-4">
    <div class="admin-catalog__panel-head">
      <h3 class="admin-catalog__panel-title"><i class="bi bi-grid me-2"></i>Operações financeiras</h3>
    </div>
    <div class="admin-catalog__panel-body">
      <div class="admin-financas__quick-grid">
        <a href="/admin/financas/pedidos" class="admin-financas__quick-link">
          <span class="admin-financas__quick-icon"><i class="bi bi-credit-card"></i></span>
          <span>
            <div class="admin-financas__quick-title">Pedidos e pagamentos</div>
            <div class="admin-financas__quick-desc">Tabela completa, busca, filtros e ações de baixa.</div>
          </span>
        </a>
        <a href="/admin/financas/relatorios<%= filtersData.from ? '?from=' + encodeURIComponent(filtersData.from) + '&to=' + encodeURIComponent(filtersData.to) : '?days=' + (filtersData.days || 30) %>" class="admin-financas__quick-link">
          <span class="admin-financas__quick-icon"><i class="bi bi-file-earmark-bar-graph"></i></span>
          <span>
            <div class="admin-financas__quick-title">Relatórios detalhados</div>
            <div class="admin-financas__quick-desc">Produtos, vendas, clientes e serviços de saúde.</div>
          </span>
        </a>
        <a href="/admin/financas/recibos" class="admin-financas__quick-link">
          <span class="admin-financas__quick-icon"><i class="bi bi-receipt-cutoff"></i></span>
          <span>
            <div class="admin-financas__quick-title">Recibos recentes</div>
            <div class="admin-financas__quick-desc">Últimas operações pagas com detalhes PIX/boleto.</div>
          </span>
        </a>
        <a href="/admin/agendamentos-servicos/caixa" class="admin-financas__quick-link">
          <span class="admin-financas__quick-icon"><i class="bi bi-cash-coin"></i></span>
          <span>
            <div class="admin-financas__quick-title">Caixa de serviços</div>
            <div class="admin-financas__quick-desc">Recebimentos presenciais pendentes de serviços.</div>
          </span>
        </a>
      </div>
    </div>
  </section>

  <div class="row g-3 mb-4">
    <div class="col-lg-5">
      <section class="admin-catalog__panel h-100">
        <div class="admin-catalog__panel-head">
          <h3 class="admin-catalog__panel-title"><i class="bi bi-wallet2 me-2"></i>Receita por método</h3>
        </div>
        <div class="admin-catalog__panel-body pt-2 pb-3">
          <% methodRows.forEach(function(m) { var p = pct(m.value, totalRevByMethod); %>
            <div class="admin-financas__method-row">
              <span class="fw-semibold small"><%= m.key %></span>
              <div class="admin-financas__method-bar-wrap" aria-hidden="true"><div class="admin-financas__method-bar" style="width:<%= p %>%; background:<%= m.color %>;"></div></div>
              <span class="small fw-semibold text-nowrap">R$ <%= fmtMoney(m.value) %></span>
            </div>
          <% }) %>
          <% if (summaryData.revenue_paid_orders != null || summaryData.revenue_paid_services != null) { %>
          <div class="mt-3 pt-2 border-top small text-muted">
            Loja: <strong>R$ <%= fmtMoney(summaryData.revenue_paid_orders) %></strong> ·
            Serviços: <strong>R$ <%= fmtMoney(summaryData.revenue_paid_services) %></strong>
          </div>
          <% } %>
        </div>
      </section>
    </div>
    <div class="col-lg-7">
      <section class="admin-catalog__panel admin-catalog__panel--table h-100">
        <div class="admin-catalog__panel-head admin-catalog__panel-head--table">
          <h3 class="admin-catalog__panel-title"><i class="bi bi-calendar-week me-2"></i>Receita por dia</h3>
          <span class="admin-catalog__panel-meta"><%= revByDayList.length %> dia(s)</span>
        </div>
        <div class="table-responsive">
          <table class="table table-custom align-middle mb-0">
            <thead>
              <tr><th>Dia</th><th>Pedidos</th><th class="text-end">Receita</th></tr>
            </thead>
            <tbody>
              <% if (revByDayList.length) { revByDayList.forEach(function(r) { %>
                <tr>
                  <td><%= fmtDate(r.day) %></td>
                  <td><%= r.orders_count || 0 %></td>
                  <td class="text-end fw-semibold">R$ <%= fmtMoney(r.revenue) %></td>
                </tr>
              <% }) } else { %>
                <tr><td colspan="3" class="text-muted py-4 text-center">Sem movimentação no período selecionado.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-lg-5">
      <section class="admin-catalog__panel admin-catalog__panel--table h-100">
        <div class="admin-catalog__panel-head admin-catalog__panel-head--table">
          <h3 class="admin-catalog__panel-title"><i class="bi bi-trophy me-2"></i>Top produtos (pagos)</h3>
          <a href="/admin/financas/relatorios?report=products" class="btn btn-outline-primary btn-sm">Ver relatório</a>
        </div>
        <div class="table-responsive">
          <table class="table table-custom align-middle mb-0">
            <thead><tr><th>Produto</th><th>Qtd</th><th class="text-end">Receita</th></tr></thead>
            <tbody>
              <% if (topSold.length) { topSold.forEach(function(p) { %>
                <tr>
                  <td>
                    <div class="fw-semibold"><%= p.product_name || '—' %></div>
                    <div class="text-muted small"><%= p.sku || '' %></div>
                  </td>
                  <td><%= p.qty_sold || 0 %></td>
                  <td class="text-end fw-semibold">R$ <%= fmtMoney(p.revenue) %></td>
                </tr>
              <% }) } else { %>
                <tr><td colspan="3" class="text-muted py-4 text-center">Sem vendas pagas no período.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>
    </div>
    <div class="col-lg-7">
      <section class="admin-catalog__panel admin-catalog__panel--table h-100">
        <div class="admin-catalog__panel-head admin-catalog__panel-head--table">
          <h3 class="admin-catalog__panel-title"><i class="bi bi-clock-history me-2"></i>Últimas operações pagas</h3>
          <div class="admin-catalog__panel-actions">
            <span class="admin-catalog__panel-meta"><%= receiptsList.length %> exibido(s)</span>
            <a href="/admin/financas/recibos" class="btn btn-outline-primary btn-sm">Ver todos</a>
          </div>
        </div>
        <div class="table-responsive">
          <table class="table table-custom align-middle mb-0">
            <thead>
              <tr><th>Pedido</th><th>Cliente</th><th>Método</th><th class="text-end">Valor</th></tr>
            </thead>
            <tbody>
              <% if (receiptsList.length) { receiptsList.forEach(function(r) {
                var methodKey = String(r.payment_method || '').toUpperCase();
                var methodLabel = PAY_LABELS[methodKey] || methodKey || '—';
              %>
                <tr>
                  <td>
                    <span class="fw-semibold">#<%= r.order_id %></span>
                    <div class="text-muted small"><%= fmtDate(r.created_at) %></div>
                  </td>
                  <td><%= r.full_name || '—' %></td>
                  <td><span class="admin-catalog__badge admin-catalog__badge--info"><%= methodLabel %></span></td>
                  <td class="text-end fw-semibold">R$ <%= fmtMoney(r.total) %></td>
                </tr>
              <% }) } else { %>
                <tr><td colspan="4" class="text-muted py-4 text-center">Nenhum recibo recente no período.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
  (function () {
    if (!window.Chart) return;

    var accent = getComputedStyle(document.documentElement).getPropertyValue('--accent-color').trim() || '#2E5C5C';

    function numberPtBr(v) {
      return Number(v || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    var statusCtx = document.getElementById('ordersStatusChart');
    if (statusCtx) {
      new window.Chart(statusCtx, {
        type: 'doughnut',
        data: {
          labels: ['Pagos', 'Pendentes', 'Falhou'],
          datasets: [{
            data: [<%= paid %>, <%= pending %>, <%= failed %>],
            backgroundColor: ['#198754', '#ffc107', '#dc3545'],
            borderWidth: 0,
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom' },
            tooltip: {
              callbacks: {
                label: function (ctx) {
                  var total = <%= totalOrders %> || 0;
                  var value = Number(ctx.raw || 0);
                  var p = total ? ((value * 100) / total).toFixed(1) : '0.0';
                  return ctx.label + ': ' + value + ' (' + p + '%)';
                }
              }
            }
          },
          cutout: '62%',
        }
      });
    }

    var revCtx = document.getElementById('revenueByMethodChart');
    if (revCtx) {
      new window.Chart(revCtx, {
        type: 'bar',
        data: {
          labels: ['PIX', 'Boleto', 'Cartão', 'Dinheiro'],
          datasets: [{
            label: 'Receita (R$)',
            data: [<%= pixRev %>, <%= boletoRev %>, <%= cardRev %>, <%= cashRev %>],
            backgroundColor: [accent, '#6c757d', '#0dcaf0', '#198754'],
            borderRadius: 8,
            borderSkipped: false,
          }]
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: function (ctx) { return 'R$ ' + numberPtBr(ctx.raw); }
              }
            }
          },
          scales: {
            x: {
              ticks: { callback: function (v) { return 'R$ ' + numberPtBr(v); } },
              grid: { color: 'rgba(0,0,0,0.06)' }
            },
            y: { grid: { display: false } }
          }
        }
      });
    }
  })();
</script>

<%- include('partials/footer') %>
