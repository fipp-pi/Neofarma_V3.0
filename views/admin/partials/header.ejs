    <script>
      (function () {
        function normPath(value) {
          return (String(value || '').split('?')[0].replace(/\/$/, '') || '/');
        }
        var current = normPath(window.location.pathname);
        var links = document.querySelectorAll('.admin-sidebar__nav .admin-sidebar__link[href]');
        if (!links.length) return;

        var bestHref = null;
        var bestScore = -1;
        links.forEach(function (link) {
          var href = normPath(link.getAttribute('href'));
          var score = -1;
          if (current === href) {
            score = 10000 + href.length;
          } else if (href !== '/admin' && current.indexOf(href + '/') === 0) {
            score = href.length;
          }
          if (score > bestScore) {
            bestScore = score;
            bestHref = href;
          }
        });

        links.forEach(function (link) {
          var href = normPath(link.getAttribute('href'));
          link.classList.toggle('is-active', bestHref !== null && href === bestHref);
        });
      })();
    </script>
    <main class="admin-content flex-grow-1">
      <script>
        (function () {
          var btn = document.getElementById('btnAdminToggleSidebar');
          if (!btn) return;
          function syncToggleUi() {
            var collapsed = document.body.classList.contains('admin-sidebar-collapsed');
            btn.setAttribute('aria-label', collapsed ? 'Expandir menu' : 'Recolher menu');
            btn.title = collapsed ? 'Expandir menu' : 'Recolher menu';
            btn.innerHTML = collapsed
              ? '<i class="bi bi-layout-sidebar"></i>'
              : '<i class="bi bi-layout-sidebar-inset"></i>';
          }
          syncToggleUi();
          btn.addEventListener('click', function () {
            document.body.classList.toggle('admin-sidebar-collapsed');
            syncToggleUi();
            try {
              localStorage.setItem('neofarma_admin_sidebar', document.body.classList.contains('admin-sidebar-collapsed') ? 'collapsed' : 'expanded');
            } catch (_) {}
          });
        })();
      </script>
