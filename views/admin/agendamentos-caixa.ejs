<%- include('partials/header') %>
<div class="container-fluid">
  <div class="list-header mb-3">
    <div>
      <h2 class="neo-heading">Caixa de Serviços (Dinheiro)</h2>
      <p class="text-muted mb-0">Recebimentos pendentes de agendamentos em dinheiro.</p>
    </div>
    <div>
      <a href="/admin/agendamentos-servicos" class="btn btn-outline-secondary btn-sm">Voltar aos agendamentos</a>
    </div>
  </div>

  <div class="card p-3 mb-3">
    <form class="row g-2" method="GET" action="/admin/agendamentos-servicos/caixa">
      <div class="col-md-3">
        <label class="form-label small">De</label>
        <input type="date" class="form-control" name="from" value="<%= filters.from || '' %>">
      </div>
      <div class="col-md-3">
        <label class="form-label small">Até</label>
        <input type="date" class="form-control" name="to" value="<%= filters.to || '' %>">
      </div>
      <div class="col-md-4">
        <label class="form-label small">Profissional</label>
        <select class="form-select" name="professional_id">
          <option value="0">Todos</option>
          <% (professionals || []).forEach(function(p){ %>
            <option value="<%= p.id %>" <%= Number(filters.professional_id || 0) === Number(p.id) ? 'selected' : '' %>><%= p.full_name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2 d-flex align-items-end gap-2">
        <button class="btn btn-primary w-100" type="submit">Filtrar</button>
      </div>
    </form>
    <div class="mt-2">
      <a
        class="btn btn-sm btn-outline-primary"
        href="/admin/agendamentos-servicos/caixa/export.csv?from=<%= encodeURIComponent(filters.from || '') %>&to=<%= encodeURIComponent(filters.to || '') %>&professional_id=<%= encodeURIComponent(filters.professional_id || 0) %>"
      >
        <i class="bi bi-download me-1"></i> Exportar CSV
      </a>
    </div>
  </div>

  <div class="d-flex justify-content-between align-items-center mb-2">
    <h6 class="mb-0">Pendências</h6>
    <div class="badge bg-warning text-dark">Total pendente: R$ <%= Number(totalPending || 0).toFixed(2).replace('.', ',') %></div>
  </div>

  <div class="table-responsive">
    <table class="table table-custom align-middle">
      <thead>
        <tr>
          <th>#</th><th>Cliente</th><th>Serviço</th><th>Profissional</th><th>Data</th><th>Valor</th><th class="text-end">Ação</th>
        </tr>
      </thead>
      <tbody>
        <% (rows || []).forEach(function(r){ %>
          <tr>
            <td><%= r.id %></td>
            <td><%= r.customer_name %></td>
            <td><%= r.service_name %></td>
            <td><%= r.professional_name || '-' %></td>
            <td><%= new Date(r.scheduled_start).toLocaleString('pt-BR') %></td>
            <td>R$ <%= Number(r.total_amount || 0).toFixed(2).replace('.', ',') %></td>
            <td class="text-end">
              <button type="button" class="btn btn-sm btn-success" onclick="receberDinheiro(<%= r.id %>)">Confirmar recebimento</button>
            </td>
          </tr>
        <% }) %>
        <% if (!rows || !rows.length) { %>
          <tr><td colspan="7" class="text-muted">Nenhum recebimento pendente para os filtros aplicados.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
<script>
  function toast(msg, type) {
    if (typeof window.neofarmaToast === 'function') return window.neofarmaToast(msg, type);
    console.log((type || 'info') + ': ' + msg);
  }
  async function receberDinheiro(id) {
    const ok = (typeof window.neofarmaConfirm === 'function')
      ? await window.neofarmaConfirm({ title: 'Confirmar recebimento', message: 'Confirmar pagamento em dinheiro deste agendamento?' })
      : true;
    if (!ok) return;
    const resp = await fetch('/admin/agendamentos-servicos/' + id + '/confirmar-pagamento', { method: 'POST' });
    const data = await resp.json();
    if (data.ok) {
      toast(data.message || 'Recebimento confirmado.', 'success');
      setTimeout(function(){ location.reload(); }, 600);
    } else {
      toast(data.message || 'Falha ao confirmar recebimento.', 'danger');
    }
  }
</script>
<%- include('partials/footer') %>
