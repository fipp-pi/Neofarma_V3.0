<%- include('partials/header') %>
<%
  const catList = typeof list !== 'undefined' ? list : [];
  const catStats = typeof stats !== 'undefined' ? stats : { total: catList.length, active: 0, inactive: 0, root: 0, sub: 0 };
  const parentNamesMap = typeof parentNames !== 'undefined' ? parentNames : {};
%>
<script src="/assets/js/admin-catalog-filters.js"></script>
<div class="container admin-catalog">
  <div id="pageFlash" class="mb-3" style="display:none;">
    <div class="alert alert-dismissible fade show mb-0" id="pageFlashAlert" role="alert">
      <span id="pageFlashText"></span>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
  </div>

  <div class="list-header mb-4">
    <div>
      <h2 class="neo-heading">Categorias</h2>
      <p class="text-muted mb-0">Crie categorias e subcategorias para estruturar o catálogo e facilitar a busca dos produtos na loja.</p>
    </div>
  </div>

  <div class="admin-catalog__stats row g-3 mb-4">
    <div class="col-6 col-lg-3">
      <div class="admin-catalog__stat admin-catalog__stat--primary">
        <span class="admin-catalog__stat-icon"><i class="bi bi-tags"></i></span>
        <div><div class="admin-catalog__stat-value"><%= catStats.total %></div><div class="admin-catalog__stat-label">Total cadastradas</div></div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="admin-catalog__stat admin-catalog__stat--success">
        <span class="admin-catalog__stat-icon"><i class="bi bi-check-circle"></i></span>
        <div><div class="admin-catalog__stat-value"><%= catStats.active %></div><div class="admin-catalog__stat-label">Ativas</div></div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="admin-catalog__stat admin-catalog__stat--info">
        <span class="admin-catalog__stat-icon"><i class="bi bi-diagram-2"></i></span>
        <div><div class="admin-catalog__stat-value"><%= catStats.root %></div><div class="admin-catalog__stat-label">Categorias raiz</div></div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="admin-catalog__stat admin-catalog__stat--neutral">
        <span class="admin-catalog__stat-icon"><i class="bi bi-diagram-3"></i></span>
        <div><div class="admin-catalog__stat-value"><%= catStats.sub %></div><div class="admin-catalog__stat-label">Subcategorias</div></div>
      </div>
    </div>
  </div>

  <section class="admin-catalog__panel mb-3">
    <div class="admin-catalog__panel-head d-flex flex-wrap justify-content-between align-items-center gap-2">
      <h3 class="admin-catalog__panel-title mb-0"><i class="bi bi-funnel me-2"></i>Filtros avançados</h3>
      <button type="button" class="admin-catalog__filters-toggle" id="catFiltersToggle" aria-expanded="true">
        <i class="bi bi-sliders"></i> Recolher filtros
      </button>
    </div>
    <div class="admin-catalog__panel-body" id="catFiltersPanel">
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label" for="filtro_q">Busca geral</label>
          <div class="admin-catalog__search">
            <i class="bi bi-search"></i>
            <input type="text" class="form-control form-control-sm" id="filtro_q" placeholder="Nome, slug, descrição ou categoria pai...">
          </div>
        </div>
        <div class="col-md-3">
          <label class="form-label" for="filtro_parent">Categoria pai</label>
          <select class="form-select form-select-sm" id="filtro_parent">
            <option value="ALL">Qualquer pai</option>
            <option value="0">Somente raiz (sem pai)</option>
            <% catList.filter(function(c){ return !c.parent_id; }).forEach(function(c){ %>
              <option value="<%= c.id %>">Filhas de: <%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label" for="filtro_level">Nível</label>
          <select class="form-select form-select-sm" id="filtro_level">
            <option value="ALL">Todos</option>
            <option value="root">Raiz</option>
            <option value="child">Subcategoria</option>
          </select>
        </div>
        <div class="col-md-3 d-flex align-items-end">
          <div class="admin-catalog__filter-actions w-100">
            <input type="hidden" id="filtro_status" value="ALL">
            <button type="button" class="btn btn-outline-secondary btn-sm" id="catClearFilters"><i class="bi bi-x-lg me-1"></i> Limpar</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="admin-catalog__tabs mb-3">
    <button type="button" class="admin-catalog__tab is-active" id="catTabAll">Todas</button>
    <button type="button" class="admin-catalog__tab" id="catTabActive">Ativas</button>
    <button type="button" class="admin-catalog__tab" id="catTabInactive">Inativas</button>
  </div>

  <section class="admin-catalog__panel admin-catalog__panel--table">
    <div class="admin-catalog__panel-head admin-catalog__panel-head--table">
      <h3 class="admin-catalog__panel-title"><i class="bi bi-list-ul me-2"></i>Lista de categorias</h3>
      <div class="admin-catalog__panel-actions">
        <span class="admin-catalog__panel-meta" id="catResultsCount"><%= catList.length %> registro(s)</span>
        <button type="button" class="btn btn-save btn-sm" onclick="abrirModalCat()" data-bs-toggle="modal" data-bs-target="#modalEditar">
          <i class="bi bi-plus-lg me-1"></i> Nova categoria
        </button>
      </div>
    </div>
    <div class="admin-catalog__results-bar">
      <span>Exibindo <strong id="catResultsVisible"><%= catList.length %></strong> categoria(s) conforme filtros aplicados.</span>
    </div>
    <div id="catalogTableWrap">
      <div class="table-responsive">
        <table class="table table-hover table-custom align-middle mb-0" id="tabelaCat">
          <thead>
            <tr>
              <th class="col-id">#</th>
              <th>Nome</th>
              <th>Slug</th>
              <th>Pai</th>
              <th class="col-status">Status</th>
              <th class="col-actions text-end">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% if (catList.length) { catList.forEach(function(item) {
              var paiNome = parentNamesMap[item.parent_id] || (item.parent_id ? String(item.parent_id) : '-');
              var searchBlob = [item.id, item.name, item.slug, paiNome, item.description].filter(Boolean).join(' ');
            %>
              <tr
                data-filter-search="<%= searchBlob.toLowerCase() %>"
                data-filter-active="<%= item.is_active ? '1' : '0' %>"
                data-filter-parent="<%= item.parent_id || 0 %>"
                data-filter-level="<%= item.parent_id ? 'child' : 'root' %>"
              >
                <td class="col-id"><%= item.id %></td>
                <td class="fw-bold"><span class="cell-truncate-wide" title="<%= item.name %>"><%= item.name %></span></td>
                <td><code class="small"><%= item.slug || '-' %></code></td>
                <td><span class="cell-truncate" title="<%= paiNome %>"><%= paiNome %></span></td>
                <td class="col-status">
                  <span class="admin-catalog__badge admin-catalog__badge--<%= item.is_active ? 'success' : 'muted' %>"><%= item.is_active ? 'Ativa' : 'Inativa' %></span>
                </td>
                <td class="col-actions text-end">
                  <div class="table-actions table-actions--3">
                  <button type="button" class="btn-action btn-view" onclick="verCat(<%= item.id %>)" title="Ver informações" aria-label="Ver informações"><i class="bi bi-info-circle"></i></button>
                  <button type="button" class="btn-action btn-edit" data-item="<%= encodeURIComponent(JSON.stringify(item)) %>" onclick="editarCat(this)" title="Editar"><i class="bi bi-pencil"></i></button>
                  <button type="button" class="btn-action btn-delete" onclick="abrirModalExclusao(<%= item.id %>, '<%= (item.name || "").replace(/'/g, "\\'").replace(/"/g, '&quot;') %>')" title="Excluir"><i class="bi bi-trash"></i></button>
                  </div>
                </td>
              </tr>
            <% }); } %>
          </tbody>
        </table>
      </div>
    </div>
    <div id="mensagemVazia" class="admin-catalog__empty" style="display: <%= catList.length ? 'none' : 'block' %>;">
      <i class="bi bi-folder2-open main-icon"></i>
      <p class="fw-semibold mb-1">Nenhuma categoria cadastrada</p>
      <p class="text-muted small mb-2">Comece criando a estrutura principal do catálogo.</p>
      <button type="button" class="btn btn-save btn-sm" onclick="abrirModalCat()" data-bs-toggle="modal" data-bs-target="#modalEditar">Cadastrar primeira categoria</button>
    </div>
    <div id="mensagemVaziaFilter" class="admin-catalog__empty" style="display:none;">
      <i class="bi bi-search main-icon"></i>
      <p class="fw-semibold mb-1">Nenhum resultado para os filtros</p>
      <p class="text-muted small mb-0">Ajuste a busca ou limpe os filtros para ver mais categorias.</p>
    </div>
  </section>
</div>

<style>
  .modal-cadastro .modal-content { border: none; border-radius: 12px; box-shadow: 0 12px 40px rgba(0,0,0,0.15); overflow: hidden; }
  .modal-cadastro .modal-header { background: var(--accent-color); color: var(--contrast-color); padding: 1rem 1.25rem; border-bottom: none; }
  .modal-cadastro .modal-header .modal-title { font-weight: 600; font-size: 1.1rem; }
  .modal-cadastro .modal-header .btn-close { filter: brightness(0) invert(1); opacity: 0.9; }
  .modal-cadastro .modal-body { padding: 0; }
  .modal-cadastro .modal-footer { padding: 1rem 1.25rem; border-top: 1px solid rgba(0,0,0,0.06); background: #fafafa; }
  .cadastro-view { padding: 1.5rem 1.5rem 1.25rem; }
  .cadastro-view-avatar { width: 56px; height: 56px; border-radius: 50%; background: color-mix(in srgb, var(--accent-color), transparent 88%); color: var(--accent-color); font-size: 1.4rem; font-weight: 700; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem; }
  .cadastro-view-nome { font-size: 1.25rem; font-weight: 600; color: var(--heading-color); margin-bottom: 1.25rem; }
  .cadastro-view-section { margin-bottom: 1.25rem; }
  .cadastro-view-section:last-child { margin-bottom: 0; }
  .cadastro-view-section-title { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--accent-color); margin-bottom: 0.6rem; }
  .cadastro-view-row { display: flex; padding: 0.5rem 0; border-bottom: 1px solid rgba(0,0,0,0.06); align-items: baseline; gap: 0.75rem; }
  .cadastro-view-row:last-child { border-bottom: none; }
  .cadastro-view-label { font-size: 0.85rem; color: #6c757d; min-width: 110px; flex-shrink: 0; }
  .cadastro-view-value { font-size: 0.95rem; color: #212529; font-weight: 500; }
  .cadastro-edit { padding: 1.5rem 1.5rem 1.25rem; }
  .cadastro-edit-section { margin-bottom: 1.5rem; }
  .cadastro-edit-section:last-of-type { margin-bottom: 0; }
  .cadastro-edit-section-title { font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.03em; color: var(--accent-color); margin-bottom: 0.75rem; padding-bottom: 0.4rem; border-bottom: 2px solid color-mix(in srgb, var(--accent-color), transparent 85%); }
  .cadastro-edit .form-label { font-size: 0.875rem; font-weight: 500; color: #495057; margin-bottom: 0.25rem; }
  .cadastro-edit .form-control, .cadastro-edit .form-select { border-radius: 8px; border-color: #dee2e6; font-size: 0.9rem; }
  .cadastro-edit .form-control:focus, .cadastro-edit .form-select:focus { border-color: var(--accent-color); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-color), transparent 88%); }
  .modal-cadastro .btn-save { background: var(--accent-color); border-color: var(--accent-color); color: var(--contrast-color); font-weight: 500; padding: 0.5rem 1.25rem; border-radius: 8px; }
  .modal-cadastro .btn-save:hover { background: color-mix(in srgb, var(--accent-color), black 12%); border-color: color-mix(in srgb, var(--accent-color), black 12%); color: var(--contrast-color); }
  .modal-header-danger { background: #dc3545; color: #fff; }
  .modal-header-danger .btn-close { filter: brightness(0) invert(1); }
  .field-required::after { content: ' *'; color: #dc3545; font-weight: 600; }
  .form-control.is-invalid, .form-select.is-invalid { border-color: #dc3545; box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.12); }
  .invalid-feedback { display: none; font-size: 0.8rem; color: #dc3545; margin-top: 0.2rem; }
  .form-control.is-invalid ~ .invalid-feedback,
  .form-select.is-invalid ~ .invalid-feedback { display: block; }
  #catFormAlert:empty { display: none !important; }
  .slug-status { min-width: 2.5rem; justify-content: center; background: #fff; }
  .slug-hint { font-size: 0.8rem; color: #6c757d; margin-top: 0.25rem; }
  .slug-hint.is-error { color: #dc3545; }
  .slug-hint.is-success { color: #198754; }
</style>

<!-- Modal Ver -->
<div class="modal fade modal-cadastro" id="modalVisualizar" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-tags me-2"></i>Dados da categoria</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="conteudoVisualizacao">
        <div class="cadastro-view"><div class="text-center text-muted py-4">Carregando...</div></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal Novo/Editar -->
<div class="modal fade modal-cadastro" id="modalEditar" tabindex="-1" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modalEditarTitle"><i class="bi bi-pencil-square me-2"></i>Nova categoria</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="cat_id">
        <div id="catFormAlert" class="alert alert-danger py-2 px-3 small mb-0 mx-3 mt-3" role="alert" style="display:none;"></div>
        <div class="cadastro-edit">
          <div class="cadastro-edit-section">
            <div class="cadastro-edit-section-title">Dados da categoria</div>
            <div class="row g-3">
              <div class="col-12">
                <label for="cat_name" class="form-label field-required">Nome</label>
                <input type="text" class="form-control" id="cat_name" placeholder="Nome da categoria" autocomplete="off" maxlength="100">
                <div class="invalid-feedback" id="cat_name_error">Informe o nome da categoria.</div>
              </div>
              <div class="col-12">
                <label for="cat_slug" class="form-label">Slug (URL)</label>
                <div class="input-group">
                  <input type="text" class="form-control" id="cat_slug" placeholder="Gerado automaticamente a partir do nome" autocomplete="off" maxlength="120" aria-describedby="cat_slug_hint cat_slug_error">
                  <span class="input-group-text slug-status" id="cat_slug_status" aria-hidden="true"></span>
                </div>
                <div class="invalid-feedback" id="cat_slug_error">Slug inválido ou em uso.</div>
                <div class="slug-hint" id="cat_slug_hint">Opcional. Use letras minúsculas, números e hífens. Deve ser único.</div>
              </div>
              <div class="col-12">
                <label for="cat_parent_id" class="form-label">Categoria pai</label>
                <select class="form-select" id="cat_parent_id">
                  <option value="">— Nenhuma (categoria raiz) —</option>
                  <% if (list && list.length) { list.forEach(function(c) { if (c.id) { %>
                  <option value="<%= c.id %>"><%= c.name %></option>
                  <% } }); } %>
                </select>
                <div class="invalid-feedback" id="cat_parent_id_error">Selecione uma categoria pai válida.</div>
              </div>
              <div class="col-12">
                <label for="cat_description" class="form-label">Descrição</label>
                <input type="text" class="form-control" id="cat_description" placeholder="Descrição opcional" autocomplete="off" maxlength="255">
                <div class="invalid-feedback" id="cat_description_error">Descrição muito longa.</div>
              </div>
              <div class="col-12">
                <div class="form-check">
                  <input type="checkbox" class="form-check-input" id="cat_is_active" checked>
                  <label class="form-check-label" for="cat_is_active">Ativo</label>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-save" id="btnSalvarCat"><i class="bi bi-check-lg me-1"></i> Salvar</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal Excluir -->
<div class="modal fade" id="modalExclusao" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header modal-header-danger">
        <h5 class="modal-title"><i class="bi bi-trash-fill me-2"></i>Excluir categoria</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p class="mb-0">Tem certeza que deseja remover a categoria <strong id="exclusaoNome"></strong>?<br>Esta ação não pode ser desfeita.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-danger" id="btnConfirmarExclusao">Sim, Excluir</button>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
<script src="/assets/js/admin-slug.js"></script>
<script>
  var CAT_SLUG_REGISTRY = <%- JSON.stringify(typeof slugRegistry !== 'undefined' ? slugRegistry : {}) %>;
  var parentNames = <%- JSON.stringify(typeof parentNames !== 'undefined' ? parentNames : {}) %>;
  var CAT_FIELD_IDS = {
    name: 'cat_name',
    slug: 'cat_slug',
    parent_id: 'cat_parent_id',
    description: 'cat_description'
  };

  function showPageFlash(message, type) {
    var wrap = document.getElementById('pageFlash');
    var alertEl = document.getElementById('pageFlashAlert');
    var textEl = document.getElementById('pageFlashText');
    if (!wrap || !alertEl || !textEl) return;
    alertEl.className = 'alert alert-dismissible fade show mb-0 alert-' + (type === 'danger' ? 'danger' : 'success');
    textEl.textContent = message;
    wrap.style.display = 'block';
  }

  (function initPageFlash() {
    try {
      var raw = sessionStorage.getItem('catAdminFlash');
      if (!raw) return;
      sessionStorage.removeItem('catAdminFlash');
      var data = JSON.parse(raw);
      if (data && data.message) showPageFlash(data.message, data.type || 'success');
    } catch (e) { /* ignore */ }
  })();

  function setCatFormAlert(message) {
    var el = document.getElementById('catFormAlert');
    if (!el) return;
    if (!message) {
      el.style.display = 'none';
      el.textContent = '';
      return;
    }
    el.style.display = 'block';
    el.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> ' + message;
  }

  function clearFieldError(fieldId) {
    var input = document.getElementById(fieldId);
    var err = document.getElementById(fieldId + '_error');
    if (input) input.classList.remove('is-invalid');
    if (err) err.style.display = 'none';
  }

  function setFieldError(fieldId, message) {
    var input = document.getElementById(fieldId);
    var err = document.getElementById(fieldId + '_error');
    if (input) input.classList.add('is-invalid');
    if (err && message) {
      err.textContent = message;
      err.style.display = 'block';
    }
  }

  function clearCatValidation() {
    setCatFormAlert('');
    Object.keys(CAT_FIELD_IDS).forEach(function(k) { clearFieldError(CAT_FIELD_IDS[k]); });
  }

  function applyServerFieldErrors(fields) {
    if (!fields || typeof fields !== 'object') return;
    Object.keys(fields).forEach(function(key) {
      var fieldId = CAT_FIELD_IDS[key] || key;
      setFieldError(fieldId, fields[key]);
    });
  }

  function slugifyClient(text) {
    return window.NeofarmaSlugField ? NeofarmaSlugField.slugify(text) : String(text || '').toLowerCase().trim();
  }

  var catSlugField = window.NeofarmaSlugField ? NeofarmaSlugField.attach({
    scope: 'category',
    localSlugs: CAT_SLUG_REGISTRY,
    slugInputId: 'cat_slug',
    nameInputId: 'cat_name',
    statusId: 'cat_slug_status',
    hintId: 'cat_slug_hint',
    errorId: 'cat_slug_error',
    getEditId: function () {
      var id = document.getElementById('cat_id').value;
      return id ? parseInt(id, 10) : null;
    },
    onStatusChange: function (st) {
      var hint = document.getElementById('cat_slug_hint');
      if (!hint) return;
      hint.classList.remove('is-error', 'is-success');
      if (st.status === 'available') hint.classList.add('is-success');
      if (st.status === 'taken' || st.status === 'invalid') hint.classList.add('is-error');
    }
  }) : null;

  function validateCatFormClient() {
    clearCatValidation();
    var errors = {};
    var name = document.getElementById('cat_name').value.trim();
    var slugInput = document.getElementById('cat_slug').value.trim().toLowerCase();
    var slug = slugInput || slugifyClient(name);
    var parentVal = document.getElementById('cat_parent_id').value;
    var parentId = parentVal ? parseInt(parentVal, 10) : null;
    var editId = document.getElementById('cat_id').value ? parseInt(document.getElementById('cat_id').value, 10) : null;
    var description = document.getElementById('cat_description').value.trim();

    if (!name) errors.name = 'Informe o nome da categoria.';
    else if (name.length < 2) errors.name = 'O nome deve ter pelo menos 2 caracteres.';

    if (slugInput && !/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slugInput)) {
      errors.slug = 'Use apenas letras minúsculas, números e hífens no slug.';
    } else if (slug.length < 2) {
      errors.slug = 'O slug deve ter pelo menos 2 caracteres.';
    }

    if (Number.isInteger(editId) && parentId === editId) {
      errors.parent_id = 'A categoria não pode ser pai de si mesma.';
    }

    if (description.length > 255) {
      errors.description = 'A descrição deve ter no máximo 255 caracteres.';
    }

    var keys = Object.keys(errors);
    if (keys.length) {
      applyServerFieldErrors(errors);
      setCatFormAlert('Revise os campos destacados em vermelho antes de continuar.');
      var first = CAT_FIELD_IDS[keys[0]] || keys[0];
      var firstEl = document.getElementById(first);
      if (firstEl) firstEl.focus();
      return false;
    }
    return true;
  }

  Object.keys(CAT_FIELD_IDS).forEach(function(k) {
    if (k === 'slug') return;
    var el = document.getElementById(CAT_FIELD_IDS[k]);
    if (!el) return;
    el.addEventListener('input', function() {
      clearFieldError(CAT_FIELD_IDS[k]);
      setCatFormAlert('');
    });
    el.addEventListener('change', function() {
      clearFieldError(CAT_FIELD_IDS[k]);
      setCatFormAlert('');
    });
  });

  function filtrarTabela() {
    if (window.__catFilters) window.__catFilters.apply();
  }

  window.__catFilters = null;
  if (window.NeoFarmaCatalogFilters) {
    window.__catFilters = NeoFarmaCatalogFilters.init({
      tableBodySelector: '#tabelaCat tbody tr',
      resultsId: 'catResultsCount',
      emptyFilterId: 'mensagemVaziaFilter',
      tableWrapId: 'catalogTableWrap',
      clearBtnId: 'catClearFilters',
      filtersToggleId: 'catFiltersToggle',
      filtersPanelId: 'catFiltersPanel',
      inputs: { q: 'filtro_q', parent: 'filtro_parent', level: 'filtro_level', status: 'filtro_status' },
      tabs: [
        { id: 'catTabAll', targetInput: 'filtro_status', value: 'ALL' },
        { id: 'catTabActive', targetInput: 'filtro_status', value: '1' },
        { id: 'catTabInactive', targetInput: 'filtro_status', value: '0' },
      ],
      matchRow: function (tr, v) {
        var F = NeoFarmaCatalogFilters;
        if (!F.textMatch(tr, v.q)) return false;
        if (v.status === '1' && tr.getAttribute('data-filter-active') !== '1') return false;
        if (v.status === '0' && tr.getAttribute('data-filter-active') !== '0') return false;
        if (v.level && v.level !== 'ALL' && tr.getAttribute('data-filter-level') !== v.level) return false;
        if (v.parent && v.parent !== 'ALL') {
          if (v.parent === '0' && tr.getAttribute('data-filter-parent') !== '0') return false;
          if (v.parent !== '0' && String(tr.getAttribute('data-filter-parent')) !== String(v.parent)) return false;
        }
        return true;
      },
      onApply: function (visible) {
        var el = document.getElementById('catResultsVisible');
        if (el) el.textContent = visible;
      },
    });
  }

  function abrirModalCat() {
    clearCatValidation();
    if (catSlugField) catSlugField.reset('');
    [].forEach.call(document.getElementById('cat_parent_id').options, function(opt) { opt.disabled = false; opt.hidden = false; });
    document.getElementById('cat_id').value = '';
    document.getElementById('cat_name').value = '';
    document.getElementById('cat_slug').value = '';
    document.getElementById('cat_parent_id').value = '';
    document.getElementById('cat_description').value = '';
    document.getElementById('cat_is_active').checked = true;
    document.getElementById('modalEditarTitle').innerHTML = '<i class="bi bi-pencil-square me-2"></i>Nova categoria';
  }

  function verCat(id) {
    var tr = [].find.call(document.querySelectorAll('#tabelaCat tbody tr'), function(row) {
      return parseInt(row.cells[0].textContent, 10) === id;
    });
    if (!tr) return;
    var editBtn = tr.querySelector('.btn-edit');
    if (!editBtn) return;
    try { var item = JSON.parse(decodeURIComponent(editBtn.getAttribute('data-item') || '{}')); } catch (e) { return; }
    var nome = item.name || '';
    var slug = item.slug || '-';
    var pai = (typeof parentNames !== 'undefined' && parentNames[item.parent_id]) ? parentNames[item.parent_id] : (item.parent_id ? item.parent_id : '-');
    var ativo = item.is_active !== 0 && item.is_active !== false ? 'Sim' : 'Não';
    var desc = item.description || '-';
    var inicial = nome ? nome.charAt(0).toUpperCase() : '?';
    var html = '<div class="cadastro-view">' +
      '<div class="cadastro-view-avatar">' + inicial + '</div>' +
      '<div class="cadastro-view-nome">' + nome + '</div>' +
      '<div class="cadastro-view-section">' +
        '<div class="cadastro-view-section-title">Dados</div>' +
        '<div class="cadastro-view-row"><span class="cadastro-view-label">Slug</span><span class="cadastro-view-value">' + slug + '</span></div>' +
        '<div class="cadastro-view-row"><span class="cadastro-view-label">Categoria pai</span><span class="cadastro-view-value">' + pai + '</span></div>' +
        '<div class="cadastro-view-row"><span class="cadastro-view-label">Ativo</span><span class="cadastro-view-value">' + ativo + '</span></div>' +
        '<div class="cadastro-view-row"><span class="cadastro-view-label">Descrição</span><span class="cadastro-view-value">' + desc + '</span></div>' +
      '</div></div>';
    document.getElementById('conteudoVisualizacao').innerHTML = html;
    new bootstrap.Modal(document.getElementById('modalVisualizar')).show();
  }

  function editarCat(btn) {
    try { var item = JSON.parse(decodeURIComponent(btn.getAttribute('data-item') || '{}')); } catch (e) { return; }
    clearCatValidation();
    var sel = document.getElementById('cat_parent_id');
    [].forEach.call(sel.options, function(opt) {
      opt.disabled = opt.value === String(item.id);
      opt.hidden = opt.value === String(item.id);
    });
    document.getElementById('cat_id').value = item.id || '';
    document.getElementById('cat_name').value = item.name || '';
    document.getElementById('cat_slug').value = item.slug || '';
    document.getElementById('cat_parent_id').value = item.parent_id != null ? item.parent_id : '';
    document.getElementById('cat_description').value = item.description || '';
    document.getElementById('cat_is_active').checked = item.is_active !== 0 && item.is_active !== false;
    if (catSlugField) catSlugField.reset(item.slug || '');
    document.getElementById('modalEditarTitle').innerHTML = '<i class="bi bi-pencil-square me-2"></i>Editar categoria';
    new bootstrap.Modal(document.getElementById('modalEditar')).show();
  }

  var exclusaoId = null;
  function abrirModalExclusao(id, nome) {
    exclusaoId = id;
    document.getElementById('exclusaoNome').textContent = nome || ('#' + id);
    new bootstrap.Modal(document.getElementById('modalExclusao')).show();
  }

  document.getElementById('btnConfirmarExclusao').addEventListener('click', function() {
    if (!exclusaoId) return;
    var id = exclusaoId;
    exclusaoId = null;
    var btn = document.getElementById('btnConfirmarExclusao');
    btn.disabled = true;
    bootstrap.Modal.getInstance(document.getElementById('modalExclusao')).hide();
    fetch('/admin/categorias/' + id, { method: 'DELETE' })
      .then(function(r) {
        return r.text().then(function(txt) {
          var data = {};
          try { data = txt ? JSON.parse(txt) : {}; } catch (e) { data = {}; }
          if (!r.ok) {
            var err = new Error((data && data.message) || 'Erro ao excluir categoria.');
            err.payload = data;
            throw err;
          }
          return data;
        });
      })
      .then(function(d) {
        btn.disabled = false;
        if (d.ok) {
          sessionStorage.setItem('catAdminFlash', JSON.stringify({ type: 'success', message: d.message || 'Categoria removida com sucesso.' }));
          location.reload();
        } else {
          window.neofarmaToast(d.message || 'Não foi possível excluir.', 'danger');
        }
      })
      .catch(function(err) {
        btn.disabled = false;
        window.neofarmaToast((err && err.message) || 'Erro ao excluir categoria.', 'danger');
      });
  });

  document.getElementById('btnSalvarCat').addEventListener('click', function() {
    if (!validateCatFormClient()) {
      if (window.neofarmaToast) window.neofarmaToast('Preencha os campos obrigatórios.', 'warning');
      return;
    }
    var proceedSave = function() {
      var id = document.getElementById('cat_id').value;
      var slugVal = document.getElementById('cat_slug').value.trim().toLowerCase();
      var body = {
        name: document.getElementById('cat_name').value.trim(),
        slug: slugVal || null,
        parent_id: document.getElementById('cat_parent_id').value ? parseInt(document.getElementById('cat_parent_id').value, 10) : null,
        description: document.getElementById('cat_description').value.trim() || null,
        is_active: document.getElementById('cat_is_active').checked
      };
      if (id) body.id = parseInt(id, 10);
      var btn = document.getElementById('btnSalvarCat');
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Salvando...';
      fetch('/admin/categorias', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
        .then(function(r) {
          return r.text().then(function(txt) {
            var data = {};
            try { data = txt ? JSON.parse(txt) : {}; } catch (e) { data = {}; }
            if (!r.ok) {
              var err = new Error((data && data.message) || 'Erro ao salvar categoria.');
              err.payload = data;
              err.status = r.status;
              throw err;
            }
            return data;
          });
        })
        .then(function(d) {
          btn.disabled = false;
          btn.innerHTML = '<i class="bi bi-check-lg me-1"></i> Salvar';
          if (d.ok) {
            bootstrap.Modal.getInstance(document.getElementById('modalEditar')).hide();
            sessionStorage.setItem('catAdminFlash', JSON.stringify({
              type: 'success',
              message: d.message || ('Categoria "' + (d.name || body.name) + '" salva com sucesso.')
            }));
            location.reload();
          } else {
            applyServerFieldErrors(d.fields);
            setCatFormAlert(d.message || 'Não foi possível salvar.');
            if (window.neofarmaToast) window.neofarmaToast(d.message || 'Não foi possível salvar.', 'danger');
          }
        })
        .catch(function(err) {
          btn.disabled = false;
          btn.innerHTML = '<i class="bi bi-check-lg me-1"></i> Salvar';
          if (err.payload && err.payload.fields) applyServerFieldErrors(err.payload.fields);
          setCatFormAlert((err && err.message) || 'Erro ao salvar.');
          if (window.neofarmaToast) window.neofarmaToast((err && err.message) || 'Erro de conexão. Tente novamente.', 'danger');
        });
    };

    if (catSlugField) {
      catSlugField.ensureAvailable().then(function(result) {
        if (!result.ok) {
          applyServerFieldErrors(result.fields || { slug: result.message });
          setCatFormAlert('Revise o slug antes de continuar.');
          document.getElementById('cat_slug').focus();
          return;
        }
        proceedSave();
      });
      return;
    }
    proceedSave();
  });
</script>
