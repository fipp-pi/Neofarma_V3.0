<%- include('partials/header') %>

<div class="container admin-catalog admin-financas">
  <%- include('partials/financas-nav') %>

  <%
    function toLocaleString(v) {
      const n = Number(v || 0);
      return n.toFixed(2).replace('.', ',');
    }
  %>

  <div class="list-header mb-3">
    <div>
      <h2 class="neo-heading">Pedidos e pagamentos</h2>
      <p class="text-muted mb-0">Consulte os pedidos da loja, filtre por status de pagamento e confirme ou rejeite recebimentos pendentes.</p>
    </div>

    <div class="d-flex flex-wrap gap-2 align-items-center">
      <form
        id="finFilterForm"
        method="GET"
        action="/admin/financas/pedidos"
        class="d-flex flex-wrap gap-2 align-items-center"
      >
        <div class="search-box">
          <i class="bi bi-search"></i>
          <input
            type="text"
            class="form-control"
            name="search"
            placeholder="Buscar por Pedido (ID) ou Cliente..."
            id="finSearch"
            value="<%= filters.search || '' %>"
            onkeydown="if (event.key === 'Enter') document.getElementById('finFilterForm').submit();"
          >
          <div class="small text-muted mt-1">Ex.: 123 ou "João"</div>
        </div>

        <input type="hidden" name="pageSize" value="<%= filters.pageSize || 25 %>">

        <select class="form-select form-select-sm" name="payment_status" onchange="document.getElementById('finFilterForm').submit();">
          <option value="ALL" <%= (!filters.payment_status || filters.payment_status === 'ALL') ? 'selected' : '' %>>Todos</option>
          <option value="PENDING" <%= filters.payment_status === 'PENDING' ? 'selected' : '' %>>Pendentes</option>
          <option value="PAID" <%= filters.payment_status === 'PAID' ? 'selected' : '' %>>Pagos</option>
          <option value="FAILED" <%= filters.payment_status === 'FAILED' ? 'selected' : '' %>>Falhou</option>
        </select>

        <input type="date" class="form-control form-control-sm" name="from" value="<%= filters.from || '' %>">
        <input type="date" class="form-control form-control-sm" name="to" value="<%= filters.to || '' %>">
        <button type="submit" class="btn btn-outline-primary btn-sm">Filtrar</button>
      </form>
    </div>
  </div>

  <div class="row g-3 mt-2">
    <div class="col-lg-12">
      <div class="card h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
            <div>
              <div class="text-muted small">Pedidos / Transações</div>
              <div style="font-weight: 700;">Controle financeiro</div>
            </div>
            <button
              type="button"
              class="btn btn-outline-primary btn-sm"
              id="btnOpenFinanceOrdersModal"
              data-bs-toggle="modal"
              data-bs-target="#modalFinanceOrders"
            >
              Tela cheia
            </button>
          </div>

          <div class="table-responsive mt-3">
            <table class="table table-hover table-custom align-middle" id="financeOrdersTable">
              <thead>
                <tr>
                  <th>Pedido</th>
                  <th>Cliente</th>
                  <th>Itens</th>
                  <th>Método</th>
                  <th>Status</th>
                  <th class="text-end">Valor</th>
                  <th class="text-end">Ações</th>
                </tr>
              </thead>
              <tbody>
                <% if (orders && orders.length) { %>
                  <% orders.forEach(function(o) { %>
                    <tr>
                      <td class="fw-bold">
                        <button type="button" class="btn btn-link btn-sm p-0 fw-bold fin-btn-order-detail" data-order-id="<%= o.id %>">#<%= o.id %></button>
                        <div class="text-muted small"><%= fmtDateTime(o.created_at) %></div>
                      </td>
                      <td>
                        <div class="fw-bold"><%= o.full_name || 'Cliente' %></div>
                        <div class="text-muted small text-break"><%= o.email || '' %></div>
                      </td>
                      <td>
                        <button type="button" class="btn btn-link btn-sm p-0 text-start fin-btn-order-detail" data-order-id="<%= o.id %>">
                          <% if (Number(o.items_qty || 0) > 0) { %>
                            <span class="badge bg-light text-dark border"><%= o.items_qty %> un.<% if (Number(o.items_lines || 0) > 1) { %> · <%= o.items_lines %> linhas<% } %></span>
                          <% } else { %>
                            <span class="badge bg-light text-muted border">Sem itens</span>
                          <% } %>
                          <% if (o.items_preview) { %>
                            <div class="small text-muted text-truncate fin-order-preview" title="<%= o.items_preview %>"><%= o.items_preview %></div>
                          <% } %>
                        </button>
                      </td>
                      <td><span class="badge bg-light text-dark border"><%= t('paymentMethod', o.payment_method) %></span></td>
                      <td>
                        <% 
                          const pay = String(o.payment_status || '');
                          const badge = tPayBadge(pay);
                        %>
                        <span class="badge bg-<%= badge %>"><%= t('paymentStatus', pay) || '-' %></span>
                        <div class="text-muted small mt-1"><%= t('orderStatus', o.order_status) %></div>
                      </td>
                      <td class="text-end fw-semibold">R$ <%= toLocaleString(o.total) %></td>
                      <td class="text-end">
                        <div class="d-flex justify-content-end gap-2 flex-wrap">
                          <button type="button" class="btn btn-sm btn-outline-primary fin-btn-order-detail" data-order-id="<%= o.id %>">
                            <i class="bi bi-info-circle"></i> Detalhes
                          </button>
                          <% if (String(o.payment_status || '') === 'PENDING') { %>
                            <button class="btn btn-sm btn-success btn-mark-paid" data-order-id="<%= o.id %>" type="button">Pago</button>
                            <button class="btn btn-sm btn-danger btn-mark-failed" data-order-id="<%= o.id %>" type="button">Falhou</button>
                          <% } %>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="7" class="text-muted">Nenhum pedido encontrado.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <% if (pagination && pagination.totalPages > 1) { %>
            <div class="d-flex justify-content-between align-items-center mt-3">
              <small class="text-muted">Página <%= pagination.page %> de <%= pagination.totalPages %> (total: <%= pagination.total %>)</small>
              <nav>
                <ul class="pagination pagination-sm mb-0">
                  <%
                    const startPage = Math.max(1, (pagination.page || 1) - 2);
                    const endPage = Math.min(pagination.totalPages, (pagination.page || 1) + 2);
                  %>
                  <% if (startPage > 1) { %>
                    <li class="page-item">
                      <a class="page-link" href="?payment_status=<%= encodeURIComponent(filters.payment_status || 'ALL') %>&from=<%= encodeURIComponent(filters.from || '') %>&to=<%= encodeURIComponent(filters.to || '') %>&search=<%= encodeURIComponent(filters.search || '') %>&pageSize=<%= filters.pageSize || 25 %>&page=1">1</a>
                    </li>
                  <% } %>
                  <% for (let p = startPage; p <= endPage; p++) { %>
                    <li class="page-item <%= p === pagination.page ? 'active' : '' %>">
                      <a class="page-link" href="?payment_status=<%= encodeURIComponent(filters.payment_status || 'ALL') %>&from=<%= encodeURIComponent(filters.from || '') %>&to=<%= encodeURIComponent(filters.to || '') %>&search=<%= encodeURIComponent(filters.search || '') %>&pageSize=<%= filters.pageSize || 25 %>&page=<%= p %>"><%= p %></a>
                    </li>
                  <% } %>
                  <% if (endPage < pagination.totalPages) { %>
                    <li class="page-item">
                      <a class="page-link" href="?payment_status=<%= encodeURIComponent(filters.payment_status || 'ALL') %>&from=<%= encodeURIComponent(filters.from || '') %>&to=<%= encodeURIComponent(filters.to || '') %>&search=<%= encodeURIComponent(filters.search || '') %>&pageSize=<%= filters.pageSize || 25 %>&page=<%= pagination.totalPages %>"><%= pagination.totalPages %></a>
                    </li>
                  <% } %>
                </ul>
              </nav>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal: tabela em tela cheia (reduz rolagem horizontal) -->
  <div class="modal fade" id="modalFinanceOrders" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Pedidos / Transações - Tela cheia</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <div class="table-responsive">
            <table class="table table-hover table-custom align-middle" id="financeOrdersTableModal">
              <thead>
                <tr>
                  <th>Pedido</th>
                  <th>Cliente</th>
                  <th>Itens</th>
                  <th>Método</th>
                  <th>Status</th>
                  <th class="text-end">Valor</th>
                  <th class="text-end">Ações</th>
                </tr>
              </thead>
              <tbody>
                <% if (orders && orders.length) { %>
                  <% orders.forEach(function(o) { %>
                    <tr>
                      <td class="fw-bold">
                        <button type="button" class="btn btn-link btn-sm p-0 fw-bold fin-btn-order-detail" data-order-id="<%= o.id %>">#<%= o.id %></button>
                        <div class="text-muted small"><%= fmtDateTime(o.created_at) %></div>
                      </td>
                      <td>
                        <div class="fw-bold"><%= o.full_name || 'Cliente' %></div>
                        <div class="text-muted small text-break"><%= o.email || '' %></div>
                      </td>
                      <td>
                        <button type="button" class="btn btn-link btn-sm p-0 text-start fin-btn-order-detail" data-order-id="<%= o.id %>">
                          <% if (Number(o.items_qty || 0) > 0) { %>
                            <span class="badge bg-light text-dark border"><%= o.items_qty %> un.<% if (Number(o.items_lines || 0) > 1) { %> · <%= o.items_lines %> linhas<% } %></span>
                          <% } else { %>
                            <span class="badge bg-light text-muted border">Sem itens</span>
                          <% } %>
                          <% if (o.items_preview) { %>
                            <div class="small text-muted text-truncate fin-order-preview" title="<%= o.items_preview %>"><%= o.items_preview %></div>
                          <% } %>
                        </button>
                      </td>
                      <td><span class="badge bg-light text-dark border"><%= t('paymentMethod', o.payment_method) %></span></td>
                      <td>
                        <% 
                          const pay = String(o.payment_status || '');
                          const badge = tPayBadge(pay);
                        %>
                        <span class="badge bg-<%= badge %>"><%= t('paymentStatus', pay) || '-' %></span>
                        <div class="text-muted small mt-1"><%= t('orderStatus', o.order_status) %></div>
                      </td>
                      <td class="text-end fw-semibold">R$ <%= toLocaleString(o.total) %></td>
                      <td class="text-end">
                        <div class="d-flex justify-content-end gap-2 flex-wrap">
                          <button type="button" class="btn btn-sm btn-outline-primary fin-btn-order-detail" data-order-id="<%= o.id %>">
                            <i class="bi bi-info-circle"></i> Detalhes
                          </button>
                          <% if (String(o.payment_status || '') === 'PENDING') { %>
                            <button class="btn btn-sm btn-success btn-mark-paid" data-order-id="<%= o.id %>" type="button">Pago</button>
                            <button class="btn btn-sm btn-danger btn-mark-failed" data-order-id="<%= o.id %>" type="button">Falhou</button>
                          <% } %>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="7" class="text-muted">Nenhum pedido encontrado.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <% if (pagination && pagination.totalPages > 1) { %>
            <div class="d-flex justify-content-between align-items-center mt-3">
              <small class="text-muted" id="financeOrdersPaginationSummaryModal">Página <%= pagination.page %> de <%= pagination.totalPages %> (total: <%= pagination.total %>)</small>
              <nav>
                <ul class="pagination pagination-sm mb-0" id="financeOrdersPaginationModal">
                  <%
                    const startPage = Math.max(1, (pagination.page || 1) - 2);
                    const endPage = Math.min(pagination.totalPages, (pagination.page || 1) + 2);
                  %>
                  <% if (startPage > 1) { %>
                    <li class="page-item">
                      <a class="page-link" href="#" data-page="1">1</a>
                    </li>
                  <% } %>
                  <% for (let p = startPage; p <= endPage; p++) { %>
                    <li class="page-item <%= p === pagination.page ? 'active' : '' %>">
                      <a class="page-link" href="#" data-page="<%= p %>"><%= p %></a>
                    </li>
                  <% } %>
                  <% if (endPage < pagination.totalPages) { %>
                    <li class="page-item">
                      <a class="page-link" href="#" data-page="<%= pagination.totalPages %>"><%= pagination.totalPages %></a>
                    </li>
                  <% } %>
                </ul>
              </nav>
            </div>
          <% } %>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal: detalhe do pedido -->
  <div class="modal fade modal-cadastro" id="modalFinOrderDetail" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="finOrderDetailTitle"><i class="bi bi-receipt me-2"></i>Pedido</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body" id="finOrderDetailBody">
          <div class="text-center py-4 text-muted">
            <span class="spinner-border spinner-border-sm me-2"></span> Carregando pedido...
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
        </div>
      </div>
    </div>
  </div>

</div>

<script>
  (function () {
    var mainTable = document.getElementById('financeOrdersTable');
    var modalTable = document.getElementById('financeOrdersTableModal');
    if (!mainTable && !modalTable) return;

    function formatMoney(v) {
      var n = Number(v || 0);
      return n.toFixed(2).replace('.', ',');
    }

    function getPaymentBadgeClass(paymentStatus) {
      if (window.NeoLabels && NeoLabels.paymentStatusBadge) {
        return NeoLabels.paymentStatusBadge(paymentStatus);
      }
      var pay = String(paymentStatus || '');
      if (pay === 'PAID') return 'success';
      if (pay === 'FAILED') return 'danger';
      return 'warning';
    }

    function labelPaymentStatus(v) {
      return window.NeoLabels ? NeoLabels.paymentStatus(v) : String(v || '-');
    }

    function labelPaymentMethod(v) {
      return window.NeoLabels ? NeoLabels.paymentMethod(v) : String(v || '');
    }

    function labelOrderStatus(v) {
      return window.NeoLabels ? NeoLabels.orderStatus(v) : String(v || '');
    }

    function formatDateOnly(v) {
      if (!v) return '—';
      return window.NeoDates ? NeoDates.formatDate(v) : String(v).slice(0, 10);
    }

    function formatDateTime(v) {
      if (!v) return '—';
      return window.NeoDates ? NeoDates.formatDateTime(v) : String(v);
    }

    function formatZip(zip) {
      var d = String(zip || '').replace(/\D/g, '');
      if (d.length !== 8) return zip || '—';
      return d.slice(0, 5) + '-' + d.slice(5);
    }

    function escapeHtml(v) {
      return String(v == null ? '' : v)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function renderOrderDetailHtml(data) {
      var o = data.order || {};
      var items = data.items || [];
      var pending = data.pending_items || [];
      var summary = data.summary || {};
      var payBadge = getPaymentBadgeClass(o.payment_status);

      var html = '<div class="admin-fin-order-detail-grid">';

      html += '<div class="admin-fin-order-detail-card">';
      html += '<div class="admin-fin-order-detail-card-title">Cliente</div>';
      html += '<p class="mb-1 fw-semibold">' + escapeHtml(o.full_name || 'Cliente') + '</p>';
      if (o.email) html += '<p class="mb-1 small text-muted">' + escapeHtml(o.email) + '</p>';
      if (o.phone) html += '<p class="mb-0 small">Tel.: ' + escapeHtml(o.phone) + '</p>';
      html += '</div>';

      html += '<div class="admin-fin-order-detail-card">';
      html += '<div class="admin-fin-order-detail-card-title">Pagamento</div>';
      html += '<div class="small">';
      html += '<div class="mb-1"><span class="text-muted">Status:</span> <span class="badge bg-' + payBadge + '">' + escapeHtml(labelPaymentStatus(o.payment_status)) + '</span></div>';
      html += '<div class="mb-1"><span class="text-muted">Forma:</span> ' + escapeHtml(labelPaymentMethod(o.payment_method)) + '</div>';
      html += '<div class="mb-1"><span class="text-muted">Pedido:</span> ' + escapeHtml(labelOrderStatus(o.order_status)) + '</div>';
      html += '<div><span class="text-muted">Realizado em:</span> ' + escapeHtml(formatDateTime(o.created_at)) + '</div>';
      html += '</div></div>';

      html += '<div class="admin-fin-order-detail-card">';
      html += '<div class="admin-fin-order-detail-card-title">Entrega</div>';
      html += '<div class="small">';
      if (o.street) {
        html += '<p class="mb-1">' + escapeHtml(o.street) + ', ' + escapeHtml(o.number || 's/n');
        if (o.complement) html += ' · ' + escapeHtml(o.complement);
        html += '</p>';
        html += '<p class="mb-1">' + escapeHtml(o.district || '') + ' — ' + escapeHtml(o.city || '') + '/' + escapeHtml(o.state || '') + '</p>';
        html += '<p class="mb-1">CEP ' + escapeHtml(formatZip(o.zip_code)) + '</p>';
      }
      if (o.shipping_service) html += '<p class="mb-1"><span class="text-muted">Frete:</span> ' + escapeHtml(o.shipping_service) + '</p>';
      if (o.shipping_deadline_days) html += '<p class="mb-1"><span class="text-muted">Prazo:</span> ' + escapeHtml(o.shipping_deadline_days) + ' dia(s)</p>';
      if (o.tracking_code) html += '<p class="mb-1"><span class="text-muted">Rastreio:</span> <code>' + escapeHtml(o.tracking_code) + '</code></p>';
      if (o.shipped_at) html += '<p class="mb-1"><span class="text-muted">Despachado em:</span> ' + escapeHtml(formatDateTime(o.shipped_at)) + '</p>';
      if (o.delivered_at) {
        html += '<p class="mb-1"><span class="text-muted">Entregue em:</span> ' + escapeHtml(formatDateTime(o.delivered_at)) + '</p>';
        if (o.delivered_by_name) html += '<p class="mb-0"><span class="text-muted">Confirmado por:</span> ' + escapeHtml(o.delivered_by_name) + '</p>';
      } else if (!o.shipped_at) {
        html += '<p class="mb-0"><span class="text-muted">Expedição:</span> aguardando despacho</p>';
      }
      html += '</div></div>';
      html += '</div>';

      html += '<div class="cadastro-edit-section-title">Itens separados (' + items.length + ')</div>';
      if (items.length) {
        html += '<div class="table-responsive mb-3"><table class="table table-sm table-custom align-middle mb-0">';
        html += '<thead><tr><th>Produto</th><th>SKU</th><th>Laboratório</th><th class="text-center">Qtd</th><th class="text-end">Unit.</th><th class="text-end">Subtotal</th><th>Lote</th><th>Validade</th></tr></thead><tbody>';
        items.forEach(function (it) {
          var batchLink = it.batch_code
            ? '<a href="/admin/lotes?search=' + encodeURIComponent(it.batch_code) + '" class="text-decoration-none">' + escapeHtml(it.batch_code) + '</a>'
            : '<span class="text-muted">—</span>';
          html += '<tr>';
          html += '<td class="fw-semibold">' + escapeHtml(it.product_name || 'Produto') + '</td>';
          html += '<td class="small text-muted">' + escapeHtml(it.sku || '—') + '</td>';
          html += '<td class="small">' + escapeHtml(it.lab_name || '—') + '</td>';
          html += '<td class="text-center">' + Number(it.quantity || 0) + '</td>';
          html += '<td class="text-end">R$ ' + formatMoney(it.unit_price) + '</td>';
          html += '<td class="text-end fw-semibold">R$ ' + formatMoney(it.line_total) + '</td>';
          html += '<td class="small">' + batchLink + '</td>';
          html += '<td class="small">' + escapeHtml(formatDateOnly(it.expiry_date)) + '</td>';
          html += '</tr>';
        });
        html += '</tbody></table></div>';
      } else {
        html += '<p class="text-muted small mb-3">Nenhum item separado registrado.</p>';
      }

      if (pending.length) {
        html += '<div class="alert alert-warning border small py-2 px-3 mb-3">';
        html += '<strong><i class="bi bi-hourglass-split me-1"></i> Itens pendentes de estoque (' + pending.length + ')</strong>';
        html += '<div class="table-responsive mt-2"><table class="table table-sm mb-0 align-middle">';
        html += '<thead><tr><th>Produto</th><th>SKU</th><th class="text-center">Qtd</th><th class="text-end">Unit.</th><th class="text-end">Subtotal</th></tr></thead><tbody>';
        pending.forEach(function (it) {
          html += '<tr>';
          html += '<td>' + escapeHtml(it.product_name || 'Produto') + '</td>';
          html += '<td class="small text-muted">' + escapeHtml(it.sku || '—') + '</td>';
          html += '<td class="text-center">' + Number(it.quantity || 0) + '</td>';
          html += '<td class="text-end">R$ ' + formatMoney(it.unit_price) + '</td>';
          html += '<td class="text-end">R$ ' + formatMoney(it.line_total) + '</td>';
          html += '</tr>';
        });
        html += '</tbody></table></div></div>';
      }

      html += '<div class="admin-fin-order-totals">';
      html += '<div class="admin-fin-order-totals-row"><span>Subtotal produtos</span><span>R$ ' + formatMoney(summary.subtotal) + '</span></div>';
      html += '<div class="admin-fin-order-totals-row"><span>Frete</span><span>R$ ' + formatMoney(summary.shipping) + '</span></div>';
      html += '<div class="admin-fin-order-totals-row admin-fin-order-totals-row--total"><span>Total do pedido</span><span>R$ ' + formatMoney(summary.total) + '</span></div>';
      html += '<div class="small text-muted mt-2">' + Number(summary.qty_total || 0) + ' unidade(s) · ' + (Number(summary.lines_fulfilled || 0) + Number(summary.lines_pending || 0)) + ' linha(s)</div>';
      html += '</div>';

      return html;
    }

    async function abrirDetalhePedido(orderId) {
      var detailModalEl = document.getElementById('modalFinOrderDetail');
      var detailBody = document.getElementById('finOrderDetailBody');
      var detailTitle = document.getElementById('finOrderDetailTitle');
      if (!detailModalEl || !detailBody) return;

      detailTitle.innerHTML = '<i class="bi bi-receipt me-2"></i>Pedido #' + escapeHtml(orderId);
      detailBody.innerHTML = '<div class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm me-2"></span> Carregando pedido...</div>';

      var openOthers = document.querySelectorAll('.modal.show');
      if (openOthers.length) {
        var maxZ = 1050;
        openOthers.forEach(function (el) {
          if (el === detailModalEl) return;
          var z = parseInt(el.style.zIndex || window.getComputedStyle(el).zIndex, 10);
          if (!Number.isNaN(z) && z > maxZ) maxZ = z;
        });
        detailModalEl.style.zIndex = String(maxZ + 10);
      }

      bootstrap.Modal.getOrCreateInstance(detailModalEl).show();
      detailModalEl.addEventListener('hidden.bs.modal', function () {
        detailModalEl.style.zIndex = '';
      }, { once: true });

      try {
        var res = await fetch('/admin/financas/orders/' + encodeURIComponent(orderId), { headers: { Accept: 'application/json' } });
        var data = await res.json();
        if (!res.ok || !data.ok) {
          detailBody.innerHTML = '<div class="alert alert-danger mb-0">' + escapeHtml((data && data.message) || 'Não foi possível carregar o pedido.') + '</div>';
          return;
        }
        detailTitle.innerHTML = '<i class="bi bi-receipt me-2"></i>Pedido #' + escapeHtml(data.order && data.order.id ? data.order.id : orderId);
        detailBody.innerHTML = renderOrderDetailHtml(data);
      } catch (e) {
        detailBody.innerHTML = '<div class="alert alert-danger mb-0">Erro de conexão ao carregar o pedido.</div>';
      }
    }

    document.addEventListener('click', function (e) {
      var detailBtn = e.target.closest && e.target.closest('.fin-btn-order-detail');
      if (detailBtn) {
        var orderId = detailBtn.getAttribute('data-order-id');
        if (!orderId) return;
        e.preventDefault();
        abrirDetalhePedido(orderId);
        return;
      }

      var paidBtn = e.target.closest && e.target.closest('.btn-mark-paid');
      var failedBtn = e.target.closest && e.target.closest('.btn-mark-failed');
      var btn = paidBtn || failedBtn;
      if (!btn) return;

      var tableRoot = btn.closest && btn.closest('#financeOrdersTable, #financeOrdersTableModal');
      if (!tableRoot) return;

      var orderId = btn.getAttribute('data-order-id');
      if (!orderId) return;

      var paymentStatus = paidBtn ? 'PAID' : 'FAILED';
      e.preventDefault();

      (async function () {
        var ok = await window.neofarmaConfirm({
          title: 'Atualizar pagamento',
          message: paymentStatus === 'PAID'
            ? 'Marcar este pedido como pago? Isso muda o status e libera a confirmação para testes.'
            : 'Marcar este pedido como falhou?'
        });
        if (!ok) return;

        btn.disabled = true;
        fetch('/admin/financas/orders/' + encodeURIComponent(orderId) + '/mark-payment', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ payment_status: paymentStatus })
        })
          .then(function (r) { return r.json().then(function (data) { return { status: r.status, data: data }; }); })
          .then(function (result) {
            btn.disabled = false;
            if (result.data && result.data.ok) {
              window.location.reload();
            } else {
              if (window.neofarmaToast) window.neofarmaToast(result.data && result.data.message ? result.data.message : 'Falha ao atualizar.', 'danger');
            }
          })
          .catch(function () {
            btn.disabled = false;
            if (window.neofarmaToast) window.neofarmaToast('Erro de conexão.', 'danger');
          });
      })();
    });

    // Paginação SEM reload dentro do modal
    var modalPagination = document.getElementById('financeOrdersPaginationModal');
    var modalPaginationSummary = document.getElementById('financeOrdersPaginationSummaryModal');
    var modalTbody = modalTable ? modalTable.querySelector('tbody') : null;
    if (modalPagination && modalTbody && modalPaginationSummary && modalTable) {
      var modalFilters = {
        payment_status: '<%= filters.payment_status || 'ALL' %>',
        from: '<%= filters.from || '' %>',
        to: '<%= filters.to || '' %>',
        search: '<%= filters.search || '' %>',
        pageSize: <%= filters.pageSize || 25 %>,
      };

      function buildOrdersUrl(page) {
        var params = new URLSearchParams();
        params.set('payment_status', modalFilters.payment_status || 'ALL');
        if (modalFilters.from) params.set('from', modalFilters.from);
        if (modalFilters.to) params.set('to', modalFilters.to);
        if (modalFilters.search) params.set('search', modalFilters.search);
        params.set('page', String(page));
        params.set('pageSize', String(modalFilters.pageSize));
        return '/admin/financas/orders?' + params.toString();
      }

      function renderItemsCell(o) {
        var qty = Number(o.items_qty || 0);
        var lines = Number(o.items_lines || 0);
        var badge = qty > 0
          ? '<span class="badge bg-light text-dark border">' + qty + ' un.' + (lines > 1 ? ' · ' + lines + ' linhas' : '') + '</span>'
          : '<span class="badge bg-light text-muted border">Sem itens</span>';
        var preview = o.items_preview
          ? '<div class="small text-muted text-truncate fin-order-preview" title="' + String(o.items_preview).replace(/"/g, '&quot;') + '">' + String(o.items_preview) + '</div>'
          : '';
        return '<button type="button" class="btn btn-link btn-sm p-0 text-start fin-btn-order-detail" data-order-id="' + String(o.id) + '">' + badge + preview + '</button>';
      }

      function renderOrdersRows(orders) {
        modalTbody.innerHTML = '';
        if (!orders || !orders.length) {
          var tr = document.createElement('tr');
          tr.innerHTML = '<td colspan="7" class="text-muted">Nenhum pedido encontrado.</td>';
          modalTbody.appendChild(tr);
          return;
        }

        orders.forEach(function (o) {
          var tr = document.createElement('tr');
          var createdStr = o.created_at ? (window.NeoDates ? NeoDates.formatDateTime(o.created_at) : o.created_at) : '';
          var pay = String(o.payment_status || '');
          var badgeClass = getPaymentBadgeClass(pay);

          var actionsHtml = '<div class="d-flex justify-content-end gap-2 flex-wrap">' +
            '<button type="button" class="btn btn-sm btn-outline-primary fin-btn-order-detail" data-order-id="' + String(o.id) + '"><i class="bi bi-info-circle"></i> Detalhes</button>';
          if (pay === 'PENDING') {
            actionsHtml += '<button class="btn btn-sm btn-success btn-mark-paid" data-order-id="' + String(o.id) + '" type="button">Pago</button>' +
              '<button class="btn btn-sm btn-danger btn-mark-failed" data-order-id="' + String(o.id) + '" type="button">Falhou</button>';
          }
          actionsHtml += '</div>';

          tr.innerHTML = '\
            <td class="fw-bold">\
              <button type="button" class="btn btn-link btn-sm p-0 fw-bold fin-btn-order-detail" data-order-id="' + String(o.id) + '">#' + String(o.id) + '</button>\
              <div class="text-muted small">' + createdStr + '</div>\
            </td>\
            <td>\
              <div class="fw-bold">' + (o.full_name ? String(o.full_name) : 'Cliente') + '</div>\
              <div class="text-muted small text-break">' + (o.email ? String(o.email) : '') + '</div>\
            </td>\
            <td>' + renderItemsCell(o) + '</td>\
            <td><span class="badge bg-light text-dark border">' + labelPaymentMethod(o.payment_method) + '</span></td>\
            <td>\
              <span class="badge bg-' + badgeClass + '">' + labelPaymentStatus(pay) + '</span>\
              <div class="text-muted small mt-1">' + labelOrderStatus(o.order_status) + '</div>\
            </td>\
            <td class="text-end fw-semibold">R$ ' + formatMoney(o.total) + '</td>\
            <td class="text-end">' + actionsHtml + '</td>';

          modalTbody.appendChild(tr);
        });
      }

      function renderPagination(pagination) {
        if (!pagination) return;
        var totalPages = Number(pagination.totalPages || 1);
        var page = Number(pagination.page || 1);
        var total = Number(pagination.total || 0);

        modalPaginationSummary.textContent = 'Página ' + page + ' de ' + totalPages + ' (total: ' + total + ')';

        var startPage = Math.max(1, page - 2);
        var endPage = Math.min(totalPages, page + 2);

        modalPagination.innerHTML = '';

        function addPageItem(p, active) {
          var li = document.createElement('li');
          li.className = 'page-item' + (active ? ' active' : '');
          var a = document.createElement('a');
          a.className = 'page-link';
          a.href = '#';
          a.dataset.page = String(p);
          a.textContent = String(p);
          li.appendChild(a);
          modalPagination.appendChild(li);
        }

        if (startPage > 1) addPageItem(1, page === 1);
        for (var x = startPage; x <= endPage; x += 1) addPageItem(x, x === page);
        if (endPage < totalPages) addPageItem(totalPages, page === totalPages);
      }

      var currentModalPage = <%= pagination && pagination.page ? pagination.page : 1 %>;

      async function refreshModalPage(page) {
        try {
          var res = await fetch(buildOrdersUrl(page), { headers: { 'Accept': 'application/json' } });
          var data = await res.json();
          if (!data || !data.ok) {
            if (window.neofarmaToast) window.neofarmaToast(data && data.message ? data.message : 'Falha ao carregar dados.', 'danger');
            return;
          }
          renderOrdersRows(data.orders);
          renderPagination(data.pagination);
          currentModalPage = data.pagination && data.pagination.page ? data.pagination.page : page;
        } catch (e) {
          if (window.neofarmaToast) window.neofarmaToast('Erro de conexão.', 'danger');
        }
      }

      modalPagination.addEventListener('click', function (e) {
        var a = e.target && e.target.closest && e.target.closest('a[data-page]');
        if (!a) return;
        e.preventDefault();
        var page = parseInt(a.dataset.page, 10);
        if (!page || page === currentModalPage) return;
        refreshModalPage(page);
      });
    }

    // UX: fallback no clique (caso Bootstrap ainda não esteja pronto)
    var openBtn = document.getElementById('btnOpenFinanceOrdersModal');
    var modalEl = document.getElementById('modalFinanceOrders');
    if (openBtn && modalEl) {
      openBtn.addEventListener('click', function () {
        var bs = window.bootstrap;
        if (bs && bs.Modal) {
          var modal = bs.Modal.getOrCreateInstance(modalEl, { keyboard: true });
          modal.show();
        }
      });
    }
  })();
</script>

<%- include('partials/footer') %>

