</style>

<script>
  var dispBatchCache = {};
  var dispHistoryMap = <%- JSON.stringify(Object.fromEntries(historyList.map(function (h) {
    return [String(h.id), {
      id: h.id,
      created_at: h.created_at,
      product_name: h.product_name,
      sku: h.sku || null,
      batch_code: h.batch_code,
      expiry_date: h.expiry_date,
      quantity: h.quantity,
      reason: h.reason,
      disposed_by_name: h.disposed_by_name || null
    }];
  }))) %>;

  function escapeHtml(value) {
    return String(value == null ? '' : value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function formatDispDate(value) {
    if (!value) return '—';
    if (window.NeoDates && NeoDates.formatDate) return NeoDates.formatDate(value);
    var s = String(value).slice(0, 10);
    var p = s.split('-');
    return p.length === 3 ? (p[2] + '/' + p[1] + '/' + p[0]) : s;
  }

  function formatDispDateTime(value) {
    if (!value) return '—';
    if (window.NeoDates && NeoDates.formatDateTime) return NeoDates.formatDateTime(value);
    return String(value);
  }

  function abrirDetalheDescarte(id) {
    var h = dispHistoryMap[String(id)];
    if (!h) return;

    var html = '';
    html += '<div class="cadastro-edit-section-title">Registro #' + escapeHtml(h.id) + '</div>';
    html += '<div class="admin-descartes__detail-grid">';
    html += '<div class="admin-descartes__detail-item"><span class="admin-descartes__detail-label">Data do descarte</span><span class="admin-descartes__detail-value">' + escapeHtml(formatDispDateTime(h.created_at)) + '</span></div>';
    html += '<div class="admin-descartes__detail-item"><span class="admin-descartes__detail-label">Responsável</span><span class="admin-descartes__detail-value">' + escapeHtml(h.disposed_by_name || '—') + '</span></div>';
    html += '<div class="admin-descartes__detail-item"><span class="admin-descartes__detail-label">Produto</span><span class="admin-descartes__detail-value">' + escapeHtml(h.product_name) + '</span></div>';
    html += '<div class="admin-descartes__detail-item"><span class="admin-descartes__detail-label">SKU</span><span class="admin-descartes__detail-value">' + escapeHtml(h.sku || '—') + '</span></div>';
    html += '<div class="admin-descartes__detail-item"><span class="admin-descartes__detail-label">Lote</span><span class="admin-descartes__detail-value"><code class="admin-descartes__batch-code">' + escapeHtml(h.batch_code) + '</code></span></div>';
    html += '<div class="admin-descartes__detail-item"><span class="admin-descartes__detail-label">Validade do lote</span><span class="admin-descartes__detail-value">' + escapeHtml(formatDispDate(h.expiry_date)) + '</span></div>';
    html += '<div class="admin-descartes__detail-item"><span class="admin-descartes__detail-label">Quantidade descartada</span><span class="admin-descartes__detail-value"><span class="badge admin-descartes__qty-badge">' + escapeHtml(h.quantity) + '</span></span></div>';
    html += '</div>';
    html += '<div class="mt-3"><span class="admin-descartes__detail-label">Motivo do descarte</span><div class="admin-descartes__detail-reason">' + escapeHtml(h.reason || '—') + '</div></div>';

    document.getElementById('detalheDescarteBody').innerHTML = html;
    new bootstrap.Modal(document.getElementById('modalDetalheDescarte')).show();
  }

  function showPageFlash(message, type) {
    var wrap = document.getElementById('pageFlash');
    var alertEl = document.getElementById('pageFlashAlert');
    var textEl = document.getElementById('pageFlashText');
    if (!wrap || !alertEl || !textEl) return;
    alertEl.className = 'alert alert-dismissible fade show mb-0 alert-' + (type === 'danger' ? 'danger' : 'success');
    textEl.textContent = message;
    wrap.style.display = 'block';
  }

  (function initPageFlash() {
    try {
      var raw = sessionStorage.getItem('dispAdminFlash');
      if (!raw) return;
      sessionStorage.removeItem('dispAdminFlash');
      var data = JSON.parse(raw);
      if (data && data.message) showPageFlash(data.message, data.type || 'success');
    } catch (e) { /* ignore */ }
  })();

  function setDispFormAlert(message) {
    var el = document.getElementById('dispFormAlert');
    if (!el) return;
    if (!message) { el.style.display = 'none'; el.textContent = ''; return; }
    el.style.display = 'block';
    el.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> ' + message;
  }

  function clearFieldError(fieldId) {
    var input = document.getElementById(fieldId);
    var err = document.getElementById(fieldId + '_error');
    if (input) input.classList.remove('is-invalid');
    if (err) err.style.display = 'none';
  }

  function setFieldError(fieldId, message) {
    var input = document.getElementById(fieldId);
    var err = document.getElementById(fieldId + '_error');
    if (input) input.classList.add('is-invalid');
    if (err && message) { err.textContent = message; err.style.display = 'block'; }
  }

  function clearDispValidation() {
    setDispFormAlert('');
    ['disp_product', 'disp_batch', 'disp_qty', 'disp_reason'].forEach(clearFieldError);
  }

  function validateDispForm() {
    clearDispValidation();
    var errors = {};
    var productId = document.getElementById('disp_product').value;
    var batchId = document.getElementById('disp_batch').value;
    var qtyRaw = document.getElementById('disp_qty').value;
    var qtyParsed = window.NeoWholeUnits
      ? NeoWholeUnits.parseWholeUnits(qtyRaw, { emptyMessage: 'Informe uma quantidade maior que zero.' })
      : { ok: Number.isFinite(Number(qtyRaw)) && Number(qtyRaw) > 0, value: Number(qtyRaw), message: 'Informe uma quantidade maior que zero.' };
    var reason = document.getElementById('disp_reason').value.trim();
    var batch = dispBatchCache[batchId];

    if (!productId) errors.disp_product = 'Selecione o produto.';
    if (!batchId) errors.disp_batch = 'Selecione o lote.';
    if (!qtyParsed.ok) errors.disp_qty = qtyParsed.message;
    else if (batch && qtyParsed.value > Number(batch.quantity)) {
      errors.disp_qty = 'Quantidade superior ao saldo disponível (' + batch.quantity + ').';
    }
    if (!reason) errors.disp_reason = 'Informe o motivo do descarte.';
    else if (reason.length < 5) errors.disp_reason = 'Descreva o motivo com pelo menos 5 caracteres.';

    var keys = Object.keys(errors);
    if (keys.length) {
      keys.forEach(function (k) { setFieldError(k, errors[k]); });
      setDispFormAlert('Revise os campos destacados antes de registrar o descarte.');
      return false;
    }
    return true;
  }

  ['disp_product', 'disp_batch', 'disp_qty', 'disp_reason'].forEach(function (id) {
    var el = document.getElementById(id);
    if (!el) return;
    el.addEventListener('input', function () { clearFieldError(id); setDispFormAlert(''); });
    el.addEventListener('change', function () { clearFieldError(id); setDispFormAlert(''); });
  });

  function atualizarInfoLote() {
    var batchId = document.getElementById('disp_batch').value;
    var hint = document.getElementById('disp_batch_hint');
    var hintText = document.getElementById('disp_batch_hint_text');
    var batch = dispBatchCache[batchId];
    if (!batch) {
      hint.hidden = true;
      return;
    }
    var valBr = window.NeoDates ? NeoDates.formatDate(batch.expiry_date) : (function () {
      var val = String(batch.expiry_date || '').slice(0, 10);
      var valParts = val.split('-');
      return valParts.length === 3 ? (valParts[2] + '/' + valParts[1] + '/' + valParts[0]) : val;
    })();
    var statusLabel = batch.validity_status === 'EXPIRED'
      ? 'Vencido'
      : (batch.validity_status === 'EXPIRING' ? 'Próximo do vencimento' : 'Válido');
    hintText.textContent = 'Validade: ' + valBr + ' · Status: ' + statusLabel + ' · Saldo disponível: ' + batch.quantity + ' un.';
    hint.hidden = false;
  }

  async function carregarLotes() {
    var pid = document.getElementById('disp_product').value;
    var sel = document.getElementById('disp_batch');
    var hint = document.getElementById('disp_batch_hint');
    dispBatchCache = {};
    hint.hidden = true;
    sel.disabled = true;
    sel.innerHTML = '<option value="">Carregando lotes...</option>';
    clearFieldError('disp_batch');

    if (!pid) {
      sel.innerHTML = '<option value="">Selecione o produto primeiro</option>';
      return;
    }

    try {
      var r = await fetch('/admin/descartes/produtos/' + pid + '/lotes');
      var d = await r.json();
      if (!d.ok) {
        sel.innerHTML = '<option value="">Erro ao carregar lotes</option>';
        return;
      }
      if (!d.batches.length) {
        sel.innerHTML = '<option value="">Nenhum lote com saldo disponível</option>';
        return;
      }
      sel.innerHTML = '<option value="">Selecione o lote</option>' + d.batches.map(function (b) {
        dispBatchCache[String(b.id)] = b;
        var val = window.NeoDates ? NeoDates.formatDate(b.expiry_date) : String(b.expiry_date).slice(0, 10);
        var tag = b.validity_status === 'EXPIRED' ? ' · Vencido' : (b.validity_status === 'EXPIRING' ? ' · A vencer' : '');
        return '<option value="' + b.id + '">' + b.batch_code + tag + ' (val. ' + val + ', saldo ' + b.quantity + ')</option>';
      }).join('');
      sel.disabled = false;
    } catch (e) {
      sel.innerHTML = '<option value="">Falha ao carregar lotes</option>';
    }
  }

  async function registrarDescarte() {
    if (!validateDispForm()) {
      if (window.neofarmaToast) window.neofarmaToast('Revise os campos do formulário.', 'warning');
      return;
    }

    var btn = document.getElementById('btnRegistrarDescarte');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Registrando...';

    try {
      var r = await fetch('/admin/descartes', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          product_id: document.getElementById('disp_product').value,
          batch_id: document.getElementById('disp_batch').value,
          quantity: document.getElementById('disp_qty').value,
          reason: document.getElementById('disp_reason').value.trim()
        })
      });
      var d = await r.json();
      if (!d.ok) {
        setDispFormAlert(d.message || 'Não foi possível registrar o descarte.');
        if (window.neofarmaToast) window.neofarmaToast(d.message || 'Erro ao registrar descarte.', 'danger');
        return;
      }
      sessionStorage.setItem('dispAdminFlash', JSON.stringify({
        type: 'success',
        message: d.message || 'Descarte registrado e estoque atualizado.'
      }));
      location.reload();
    } catch (e) {
      setDispFormAlert('Erro de conexão. Tente novamente.');
      if (window.neofarmaToast) window.neofarmaToast('Erro de conexão. Tente novamente.', 'danger');
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-check-lg me-1"></i> Registrar descarte';
    }
  }

  function filtrarHistorico() {
    var q = (document.getElementById('buscaHistorico').value || '').toLowerCase();
    document.querySelectorAll('#tabelaHistorico tbody tr').forEach(function (tr) {
      var h = dispHistoryMap[String(tr.getAttribute('data-id') || '')];
      var blob = h
        ? [h.product_name, h.batch_code, h.reason, h.disposed_by_name, h.sku].filter(Boolean).join(' ').toLowerCase()
        : (tr.textContent || '').toLowerCase();
      tr.style.display = blob.indexOf(q) >= 0 ? '' : 'none';
    });
  }
</script>

