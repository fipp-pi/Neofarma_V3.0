<%- include('partials/header') %>

<% var statsData = typeof stats !== 'undefined' ? stats : {}; %>
<% var historyList = typeof history !== 'undefined' ? history : []; %>

<div class="container admin-descartes">
  <div id="pageFlash" class="mb-3" style="display:none;">
    <div class="alert alert-dismissible fade show mb-0" id="pageFlashAlert" role="alert">
      <span id="pageFlashText"></span>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
  </div>

  <div class="list-header">
    <div>
      <h2 class="neo-heading">Descarte de estoque</h2>
      <p class="text-muted mb-0">Registre a baixa de produtos vencidos ou avariados, informando o motivo do descarte e atualizando o saldo em estoque.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <a href="/admin/lotes?status=EXPIRED" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-archive me-1"></i> Ver lotes vencidos
      </a>
    </div>
  </div>

  <div class="admin-descartes__stats row g-3 mb-4">
    <div class="col-md-4">
      <div class="admin-descartes__stat admin-descartes__stat--danger">
        <span class="admin-descartes__stat-icon"><i class="bi bi-exclamation-triangle"></i></span>
        <div>
          <div class="admin-descartes__stat-value"><%= statsData.expiredAwaiting || 0 %></div>
          <div class="admin-descartes__stat-label">Lotes vencidos com saldo</div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="admin-descartes__stat admin-descartes__stat--neutral">
        <span class="admin-descartes__stat-icon"><i class="bi bi-box-seam"></i></span>
        <div>
          <div class="admin-descartes__stat-value"><%= statsData.productsEligible || 0 %></div>
          <div class="admin-descartes__stat-label">Produtos com lotes disponíveis</div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="admin-descartes__stat admin-descartes__stat--success">
        <span class="admin-descartes__stat-icon"><i class="bi bi-journal-check"></i></span>
        <div>
          <div class="admin-descartes__stat-value"><%= statsData.historyCount || 0 %></div>
          <div class="admin-descartes__stat-label">Registros no histórico recente</div>
        </div>
      </div>
    </div>
  </div>

  <% if ((statsData.expiredAwaiting || 0) > 0) { %>
  <div class="alert alert-danger d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
      <strong><i class="bi bi-exclamation-octagon me-1"></i> Atenção:</strong>
      existem <strong><%= statsData.expiredAwaiting %></strong> lote(s) vencido(s) ainda com quantidade em estoque. Confira fisicamente e registre o descarte abaixo.
    </div>
    <a class="btn btn-sm btn-danger" href="/admin/lotes?status=EXPIRED">Conferir lotes</a>
  </div>
  <% } %>

  <div class="row g-4">
    <div class="col-lg-5">
      <section class="admin-descartes__panel">
        <div class="admin-descartes__panel-head">
          <h3 class="admin-descartes__panel-title"><i class="bi bi-trash3 me-2"></i>Registrar descarte</h3>
        </div>
        <div class="admin-descartes__panel-body">
          <div id="dispFormAlert" class="alert alert-danger py-2 px-3 small mb-3" role="alert" style="display:none;"></div>

          <div class="admin-descartes__section-title">Identificação</div>

          <div class="mb-3">
            <label for="disp_product" class="form-label field-required">Produto</label>
            <select class="form-select" id="disp_product" onchange="carregarLotes()">
              <option value="">Selecione um produto</option>
              <% (products || []).forEach(function (p) {
                var statusLabels = { DISCONTINUED: 'Descontinuado', INACTIVE: 'Inativo' };
                var tag = p.status && p.status !== 'ACTIVE' ? ' [' + (statusLabels[p.status] || p.status) + ']' : '';
              %><option value="<%= p.id %>"><%= p.name %><%= tag %></option><% }); %>
            </select>
            <div class="invalid-feedback" id="disp_product_error">Selecione o produto.</div>
          </div>

          <div class="mb-3">
            <label for="disp_batch" class="form-label field-required">Lote</label>
            <select class="form-select" id="disp_batch" onchange="atualizarInfoLote()" disabled>
              <option value="">Selecione o produto primeiro</option>
            </select>
            <div class="invalid-feedback" id="disp_batch_error">Selecione o lote.</div>
          </div>

          <div class="admin-descartes__batch-hint" id="disp_batch_hint" hidden>
            <i class="bi bi-info-circle me-1"></i>
            <span id="disp_batch_hint_text"></span>
          </div>

          <div class="admin-descartes__section-title mt-4">Baixa</div>

          <div class="mb-3">
            <label for="disp_qty" class="form-label field-required">Quantidade</label>
            <input type="number" min="1" step="1" inputmode="numeric" class="form-control" id="disp_qty" placeholder="Informe a quantidade a descartar">
            <div class="invalid-feedback" id="disp_qty_error">Informe uma quantidade válida.</div>
          </div>

          <div class="mb-4">
            <label for="disp_reason" class="form-label field-required">Motivo do descarte</label>
            <textarea class="form-control" id="disp_reason" rows="3" maxlength="500" placeholder="Ex.: Produto vencido identificado em conferência de estoque"></textarea>
            <div class="invalid-feedback" id="disp_reason_error">Informe o motivo do descarte.</div>
          </div>

          <button type="button" class="btn btn-save w-100" id="btnRegistrarDescarte" onclick="registrarDescarte()">
            <i class="bi bi-check-lg me-1"></i> Registrar descarte
          </button>
        </div>
      </section>
    </div>

    <div class="col-lg-7">
      <section class="admin-descartes__panel admin-descartes__panel--table">
        <div class="admin-descartes__panel-head admin-descartes__panel-head--table">
          <h3 class="admin-descartes__panel-title"><i class="bi bi-clock-history me-2"></i>Histórico recente</h3>
          <div class="search-box admin-descartes__search">
            <i class="bi bi-search"></i>
            <input type="text" class="form-control form-control-sm" id="buscaHistorico" placeholder="Buscar produto, lote, motivo..." onkeyup="filtrarHistorico()">
          </div>
        </div>

        <% if (!historyList.length) { %>
          <div class="admin-descartes__empty">
            <i class="bi bi-inbox d-block mb-2"></i>
            Nenhum descarte registrado ainda.
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover table-custom align-middle mb-0" id="tabelaHistorico">
              <thead>
                <tr>
                  <th>Data</th>
                  <th>Produto</th>
                  <th>Lote</th>
                  <th class="text-center">Qtd</th>
                  <th>Responsável</th>
                  <th class="col-actions text-end">Ações</th>
                </tr>
              </thead>
              <tbody>
                <% historyList.forEach(function (h) { %>
                  <tr data-id="<%= h.id %>">
                    <td class="text-nowrap small text-muted">
                      <%= fmtDateTime(h.created_at) %>
                    </td>
                    <td><span class="cell-truncate-wide" title="<%= h.product_name %>"><%= h.product_name %></span></td>
                    <td><code class="admin-descartes__batch-code"><%= h.batch_code %></code></td>
                    <td class="text-center"><span class="badge admin-descartes__qty-badge"><%= h.quantity %></span></td>
                    <td class="small text-muted"><%= h.disposed_by_name || '—' %></td>
                    <td class="col-actions text-end">
                      <div class="table-actions justify-content-end">
                        <button type="button" class="btn-action btn-view" onclick="abrirDetalheDescarte(<%= h.id %>)" title="Ver detalhes" aria-label="Ver detalhes do descarte">
                          <i class="bi bi-info-circle"></i>
                        </button>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    </div>
  </div>
</div>

<!-- Modal Detalhe do descarte -->
<div class="modal fade modal-cadastro" id="modalDetalheDescarte" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-trash3 me-2"></i>Detalhe do descarte</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body" id="detalheDescarteBody"></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
      </div>
    </div>
  </div>
</div>

