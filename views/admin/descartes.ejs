  }

  .admin-descartes__stat-label {
    font-size: 0.8rem;
    color: #6c757d;
    margin-top: 0.15rem;
  }

  .admin-descartes__panel {
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 14px;
