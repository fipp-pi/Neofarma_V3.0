<%- include('partials/header') %>

<div class="container">
  <%
    function toLocaleString(v) {
      const n = Number(v || 0);
      return n.toFixed(2).replace('.', ',');
    }
  %>

  <div class="list-header">
    <div>
      <h2 class="neo-heading">Finanças</h2>
      <p class="text-muted mb-0">Receitas, pedidos, mais vendidos e controle de pagamentos (para testes).</p>
    </div>

    <div class="d-flex flex-wrap gap-2 align-items-center">
      <form
        id="finFilterForm"
        method="GET"
        action="/admin/financas"
        class="d-flex flex-wrap gap-2 align-items-center"
      >
        <input type="date" class="form-control form-control-sm" name="from" value="<%= filters.from || '' %>">
        <input type="date" class="form-control form-control-sm" name="to" value="<%= filters.to || '' %>">
        <button type="submit" class="btn btn-outline-primary btn-sm">Filtrar</button>
      </form>
    </div>
  </div>

  <div class="mt-4 mb-2">
    <h5 class="text-muted mb-0">Resumo financeiro</h5>
  </div>

  <div class="row g-3 mt-1">
    <div class="col-md-3">
      <div class="card h-100">
        <div class="card-body">
          <div class="text-muted small">Receita (pagos)</div>
          <div class="display-6 neo-accent-strong">R$ <%= summary && summary.revenue_paid ? toLocaleString(summary.revenue_paid) : '0,00' %></div>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card h-100">
        <div class="card-body">
          <div class="text-muted small">Pendentes</div>
          <div class="display-6" style="font-weight: 700;"><%= summary.pending_count || 0 %></div>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card h-100">
        <div class="card-body">
          <div class="text-muted small">Falhou</div>
          <div class="display-6" style="font-weight: 700;"><%= summary.failed_count || 0 %></div>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card h-100">
        <div class="card-body">
          <div class="text-muted small">Total de pedidos</div>
          <div class="display-6" style="font-weight: 700;"><%= summary.total_orders || 0 %></div>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-4 mb-2">
    <h5 class="text-muted mb-0">Receitas: métodos e por dia</h5>
  </div>

  <div class="row g-3 mt-2">
    <div class="col-md-4">
      <div class="card h-100">
        <div class="card-body">
          <div class="text-muted small mb-2">Receita por método</div>
          <div class="d-flex justify-content-between"><span>PIX</span><strong>R$ <%= revenueByMethod && revenueByMethod.PIX ? toLocaleString(revenueByMethod.PIX) : '0,00' %></strong></div>
          <div class="d-flex justify-content-between mt-1"><span>BOLETO</span><strong>R$ <%= revenueByMethod && revenueByMethod.BOLETO ? toLocaleString(revenueByMethod.BOLETO) : '0,00' %></strong></div>
          <div class="d-flex justify-content-between mt-1"><span>CARTÃO</span><strong>R$ <%= revenueByMethod && revenueByMethod.CREDIT_CARD ? toLocaleString(revenueByMethod.CREDIT_CARD) : '0,00' %></strong></div>
        </div>
      </div>
    </div>

    <div class="col-md-8">
      <div class="card h-100">
        <div class="card-body">
          <div class="text-muted small mb-2">Receita por dia (pagos)</div>
          <div class="table-responsive">
            <table class="table table-hover table-custom align-middle">
              <thead>
                <tr>
                  <th>Dia</th>
                  <th>Pedidos</th>
                  <th class="text-end">Receita</th>
                </tr>
              </thead>
              <tbody>
                <% if (revenueByDay && revenueByDay.length) { %>
                  <% revenueByDay.forEach(function(r) { %>
                    <tr>
                      <td><%= r.day || '-' %></td>
                      <td><%= r.orders_count || 0 %></td>
                      <td class="text-end">R$ <%= toLocaleString(r.revenue) %></td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="3" class="text-muted">Sem dados</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-4 mb-2">
    <h5 class="text-muted mb-0">Destaques e pedidos</h5>
  </div>

  <div class="row g-3 mt-2">
    <div class="col-lg-5">
      <div class="card h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <div class="text-muted small">Mais vendidos (pagos)</div>
              <div style="font-weight: 700;">Top 10 produtos</div>
            </div>
          </div>
          <div class="table-responsive mt-3">
            <table class="table table-hover table-custom align-middle">
              <thead>
                <tr>
                  <th>Produto</th>
                  <th>Qtd</th>
                  <th class="text-end">Receita</th>
                </tr>
              </thead>
              <tbody>
                <% if (mostSold && mostSold.length) { %>
                  <% mostSold.forEach(function(p) { %>
                    <tr>
                      <td>
                        <div class="fw-bold"><%= p.product_name || '-' %></div>
                        <div class="text-muted small"><%= p.sku || '' %></div>
                      </td>
                      <td><%= p.qty_sold || 0 %></td>
                      <td class="text-end">R$ <%= toLocaleString(p.revenue) %></td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="3" class="text-muted">Sem dados</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-7" id="financeOrdersCol">
      <div class="card h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
            <div>
              <div class="text-muted small">Pedidos / Transações</div>
              <div style="font-weight: 700;">Controle financeiro</div>
            </div>
            <a
              class="btn btn-outline-primary btn-sm"
              href="/admin/financas/pedidos?payment_status=<%= encodeURIComponent(filters.payment_status || 'ALL') %>&from=<%= encodeURIComponent(filters.from || '') %>&to=<%= encodeURIComponent(filters.to || '') %>&search=<%= encodeURIComponent(filters.search || '') %>&pageSize=<%= filters.pageSize || 25 %>&page=1"
            >
              Ver pedidos completos
            </a>
          </div>

          <div class="text-muted small mt-3">
            A tabela completa de pedidos com o botão <strong>Tela cheia</strong> e ações de pagamento fica na página dedicada.
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-4 mb-2">
    <h5 class="text-muted mb-0">Operações recentes (pagos)</h5>
  </div>

  <div class="row g-3 mt-2">
    <div class="col-lg-12">
      <div class="card h-100">
        <div class="card-body">
          <div class="text-muted small">Recibos / Transações recentes (pagos)</div>
          <div style="font-weight: 700;" class="mb-2">Últimas operações</div>

          <div class="table-responsive">
            <table class="table table-hover table-custom align-middle">
              <thead>
                <tr>
                  <th>Pedido</th>
                  <th>Cliente</th>
                  <th>Método</th>
                  <th class="text-end">Valor</th>
                  <th>Detalhes (simulados)</th>
                </tr>
              </thead>
              <tbody>
                <% if (recentReceipts && recentReceipts.length) { %>
                  <% recentReceipts.forEach(function(r) { %>
                    <tr>
                      <td class="fw-bold">#<%= r.order_id %><div class="text-muted small"><%= r.created_at ? new Date(r.created_at).toLocaleDateString('pt-BR') : '' %></div></td>
                      <td><%= r.full_name || '-' %></td>
                      <td><span class="badge bg-light text-dark border"><%= r.payment_method %></span></td>
                      <td class="text-end fw-semibold">R$ <%= toLocaleString(r.total) %></td>
                      <td class="small text-muted">
                        <% if (r.payment_method === 'PIX') { %>
                          <code class="text-break"><%= (r.pix_copy_paste || '').slice(0, 40) %>...</code>
                        <% } else if (r.payment_method === 'BOLETO') { %>
                          <code class="text-break"><%= (r.boleto_barcode || '').slice(0, 25) %>...</code>
                        <% } else { %>
                          Cartão
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="5" class="text-muted">Sem recibos recentes.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal de pedidos movida para a página /admin/financas/pedidos -->

<script>
  (function () {
    var mainTable = document.getElementById('financeOrdersTable');
    var modalTable = document.getElementById('financeOrdersTableModal');
    if (!mainTable && !modalTable) return;

    function formatMoney(v) {
      var n = Number(v || 0);
      return n.toFixed(2).replace('.', ',');
    }

    function getPaymentBadgeClass(paymentStatus) {
      var pay = String(paymentStatus || '');
      if (pay === 'PAID') return 'success';
      if (pay === 'FAILED') return 'danger';
      return 'warning';
    }

    // Delegação de eventos para funcionar também após paginação via AJAX no modal
    document.addEventListener('click', function (e) {
      var paidBtn = e.target.closest && e.target.closest('.btn-mark-paid');
      var failedBtn = e.target.closest && e.target.closest('.btn-mark-failed');
      var btn = paidBtn || failedBtn;
      if (!btn) return;

      var tableRoot = btn.closest && btn.closest('#financeOrdersTable, #financeOrdersTableModal');
      if (!tableRoot) return;

      var orderId = btn.getAttribute('data-order-id');
      if (!orderId) return;

      var paymentStatus = paidBtn ? 'PAID' : 'FAILED';
      e.preventDefault();

      (async function () {
        var ok = await window.neofarmaConfirm({
          title: 'Atualizar pagamento',
          message: paymentStatus === 'PAID'
            ? 'Marcar este pedido como pago? Isso muda o status e libera a confirmação para testes.'
            : 'Marcar este pedido como falhou?'
        });
        if (!ok) return;

        btn.disabled = true;
        fetch('/admin/financas/orders/' + encodeURIComponent(orderId) + '/mark-payment', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ payment_status: paymentStatus })
        })
          .then(function (r) { return r.json().then(function (data) { return { status: r.status, data: data }; }); })
          .then(function (result) {
            btn.disabled = false;
            if (result.data && result.data.ok) {
              window.location.reload();
            } else {
              if (window.neofarmaToast) window.neofarmaToast(result.data && result.data.message ? result.data.message : 'Falha ao atualizar.', 'danger');
            }
          })
          .catch(function () {
            btn.disabled = false;
            if (window.neofarmaToast) window.neofarmaToast('Erro de conexão.', 'danger');
          });
      })();
    });

    // Paginação SEM reload dentro do modal
    var modalPagination = document.getElementById('financeOrdersPaginationModal');
    var modalPaginationSummary = document.getElementById('financeOrdersPaginationSummaryModal');
    var modalTbody = modalTable ? modalTable.querySelector('tbody') : null;
    if (modalPagination && modalTbody && modalPaginationSummary && modalTable) {
      var modalFilters = {
        payment_status: '<%= filters.payment_status || 'ALL' %>',
        from: '<%= filters.from || '' %>',
        to: '<%= filters.to || '' %>',
        search: '<%= filters.search || '' %>',
        pageSize: <%= filters.pageSize || 25 %>,
      };

      function buildOrdersUrl(page) {
        var params = new URLSearchParams();
        params.set('payment_status', modalFilters.payment_status || 'ALL');
        if (modalFilters.from) params.set('from', modalFilters.from);
        if (modalFilters.to) params.set('to', modalFilters.to);
        if (modalFilters.search) params.set('search', modalFilters.search);
        params.set('page', String(page));
        params.set('pageSize', String(modalFilters.pageSize));
        return '/admin/financas/orders?' + params.toString();
      }

      function renderOrdersRows(orders) {
        modalTbody.innerHTML = '';
        if (!orders || !orders.length) {
          var tr = document.createElement('tr');
          tr.innerHTML = '<td colspan="6" class="text-muted">Nenhum pedido encontrado.</td>';
          modalTbody.appendChild(tr);
          return;
        }

        orders.forEach(function (o) {
          var tr = document.createElement('tr');

          var createdStr = o.created_at ? new Date(o.created_at).toLocaleString('pt-BR') : '';
          var pay = String(o.payment_status || '');
          var badgeClass = getPaymentBadgeClass(pay);

          var actionsHtml = '';
          if (pay === 'PENDING') {
            actionsHtml = '\
              <div class="d-flex justify-content-end gap-2 flex-wrap">\
                <button class="btn btn-sm btn-success btn-mark-paid" data-order-id="' + String(o.id) + '" type="button">Marcar pago</button>\
                <button class="btn btn-sm btn-danger btn-mark-failed" data-order-id="' + String(o.id) + '" type="button">Marcar falhou</button>\
              </div>';
          } else {
            actionsHtml = '<span class="text-muted small">Ação indisponível</span>';
          }

          tr.innerHTML = '\
            <td class="fw-bold">#' + String(o.id) + '<div class="text-muted small">' + createdStr + '</div></td>\
            <td>\
              <div class="fw-bold">' + (o.full_name ? String(o.full_name) : 'Cliente') + '</div>\
              <div class="text-muted small text-break">' + (o.email ? String(o.email) : '') + '</div>\
            </td>\
            <td><span class="badge bg-light text-dark border">' + String(o.payment_method || '') + '</span></td>\
            <td>\
              <span class="badge bg-' + badgeClass + '">' + (pay || '-') + '</span>\
              <div class="text-muted small mt-1">' + (o.order_status || '') + '</div>\
            </td>\
            <td class="text-end fw-semibold">R$ ' + formatMoney(o.total) + '</td>\
            <td class="text-end">' + actionsHtml + '</td>';

          modalTbody.appendChild(tr);
        });
      }

      function renderPagination(pagination) {
        if (!pagination) return;
        var totalPages = Number(pagination.totalPages || 1);
        var page = Number(pagination.page || 1);
        var total = Number(pagination.total || 0);

        modalPaginationSummary.textContent = 'Página ' + page + ' de ' + totalPages + ' (total: ' + total + ')';

        var startPage = Math.max(1, page - 2);
        var endPage = Math.min(totalPages, page + 2);

        modalPagination.innerHTML = '';

        function addPageItem(p, active) {
          var li = document.createElement('li');
          li.className = 'page-item' + (active ? ' active' : '');
          var a = document.createElement('a');
          a.className = 'page-link';
          a.href = '#';
          a.dataset.page = String(p);
          a.textContent = String(p);
          li.appendChild(a);
          modalPagination.appendChild(li);
        }

        if (startPage > 1) addPageItem(1, page === 1);
        for (var x = startPage; x <= endPage; x += 1) addPageItem(x, x === page);
        if (endPage < totalPages) addPageItem(totalPages, page === totalPages);
      }

      var currentModalPage = <%= typeof pagination !== 'undefined' && pagination && pagination.page ? pagination.page : 1 %>;

      async function refreshModalPage(page) {
        try {
          var res = await fetch(buildOrdersUrl(page), { headers: { 'Accept': 'application/json' } });
          var data = await res.json();
          if (!data || !data.ok) {
            if (window.neofarmaToast) window.neofarmaToast(data && data.message ? data.message : 'Falha ao carregar dados.', 'danger');
            return;
          }
          renderOrdersRows(data.orders);
          renderPagination(data.pagination);
          currentModalPage = data.pagination && data.pagination.page ? data.pagination.page : page;
        } catch (e) {
          if (window.neofarmaToast) window.neofarmaToast('Erro de conexão.', 'danger');
        }
      }

      modalPagination.addEventListener('click', function (e) {
        var a = e.target && e.target.closest && e.target.closest('a[data-page]');
        if (!a) return;
        e.preventDefault();
        var page = parseInt(a.dataset.page, 10);
        if (!page || page === currentModalPage) return;
        refreshModalPage(page);
      });
    }

    // UX: fallback no clique (caso Bootstrap ainda não esteja pronto)
    var openBtn = document.getElementById('btnOpenFinanceOrdersModal');
    var modalEl = document.getElementById('modalFinanceOrders');
    if (openBtn && modalEl) {
      openBtn.addEventListener('click', function () {
        var bs = window.bootstrap;
        if (bs && bs.Modal) {
          var modal = bs.Modal.getOrCreateInstance(modalEl, { keyboard: true });
          modal.show();
        }
      });
    }
  })();
</script>

<%- include('partials/footer') %>

