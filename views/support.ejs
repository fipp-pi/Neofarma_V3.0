<%- include('partials/header') %>

<main class="main">

  <!-- Page Title -->
  <div class="page-title light-background">
    <div class="container d-lg-flex justify-content-between align-items-center">
      <h1 class="mb-2 mb-lg-0">Suporte</h1>
      <nav class="breadcrumbs">
        <ol>
          <li><a href="/">Início</a></li>
          <li class="current">Suporte</li>
        </ol>
      </nav>
    </div>
  </div><!-- End Page Title -->

  <!-- Support Section -->
  <section id="support" class="support section">

    <div class="container" data-aos="fade-up">

      <!-- Support Header -->
      <div class="support-header" data-aos="fade-up">
        <div class="header-content">
          <h2>Suporte &amp; Central de Ajuda</h2>
          <p>Encontre respostas, tutoriais e ajuda da nossa equipe de suporte.</p>
        </div>
      </div>

      <!-- Quick Support Actions -->
      <div class="quick-support" data-aos="fade-up" data-aos-delay="100">
        <div class="action-item live-chat">
          <div class="action-content">
            <i class="bi bi-chat-text"></i>
            <h4>Chat</h4>
            <p>Converse com a nossa equipe</p>
            <a href="#" class="action-button">Comece uma conversa</a>
          </div>
        </div>

        <div class="action-item phone">
          <div class="action-content">
            <i class="bi bi-telephone"></i>
            <h4>Telefone</h4>
            <p>Linha de Suporte 24/7</p>
            <a href="tel:1234567890" class="action-button">+55 (18) 9998-9999</a>
          </div>
        </div>

        <div class="action-item email">
          <div class="action-content">
            <i class="bi bi-envelope"></i>
            <h4>Email</h4>
            <p>Envie um Email para receber suporte</p>
            <a href="#" class="action-button">Enviar Email</a>
          </div>
        </div>
      </div>

      <!-- Help Topics -->
      <div class="help-categories" data-aos="fade-up" data-aos-delay="200">
        <h3>Tópicos de Ajuda Populares</h3>
        <div class="category-cards">
          <a href="#" class="category-card" data-aos="zoom-in" data-aos-delay="100">
            <span class="icon"><i class="bi bi-box-seam"></i></span>
            <h5>Pedidos &amp; Entrega</h5>
            <ul>
              <li>Rastreamento do Pedido</li>
              <li>Métodos de Envio</li>
              <li>Devolução &amp; Troca</li>
            </ul>
            <span class="arrow"><i class="bi bi-arrow-right"></i></span>
          </a>

          <a href="#" class="category-card" data-aos="zoom-in" data-aos-delay="200">
            <span class="icon"><i class="bi bi-wallet2"></i></span>
            <h5>Cobrança &amp; Pagamento</h5>
            <ul>
              <li>Métodos de Pagamento</li>
              <li>Faturas</li>
              <li>Status de Reembolso</li>
            </ul>
            <span class="arrow"><i class="bi bi-arrow-right"></i></span>
          </a>

          <a href="#" class="category-card" data-aos="zoom-in" data-aos-delay="300">
            <span class="icon"><i class="bi bi-person-gear"></i></span>
            <h5>Configurações de Conta</h5>
            <ul>
              <li>Gerenciamento do Perfil</li>
              <li>Troca de Senha</li>
              <li>Configurações de Privacidade</li>
            </ul>
            <span class="arrow"><i class="bi bi-arrow-right"></i></span>
          </a>

          <a href="#" class="category-card" data-aos="zoom-in" data-aos-delay="400">
            <span class="icon"><i class="bi bi-shield-check"></i></span>
            <h5>Segurança</h5>
            <ul>
              <li>Segurança de Conta</li>
              <li>Verificação de Duas Etapas</li>
              <li>Políticas de Privacidade</li>
            </ul>
            <span class="arrow"><i class="bi bi-arrow-right"></i></span>
          </a>
        </div>
      </div>

      <!-- Self Help -->
      <div class="self-help" data-aos="fade-up" data-aos-delay="300">
        <div class="row align-items-center">
          <div class="col-lg-6">
            <div class="content-box">
              <h3>Recursos de Autoajuda</h3>
              <p class="subtitle">Encontre respostas rapidamente com nossos recursos abrangentes</p>
              <div class="resource-links">
                <a href="#" class="resource-link">
                  <i class="bi bi-play-circle"></i>
                  <div class="link-content">
                    <h6>Vídeo Tutoriais</h6>
                    <p>Guias de vídeo passo a passo</p>
                  </div>
                </a>
                <a href="#" class="resource-link">
                  <i class="bi bi-file-text"></i>
                  <div class="link-content">
                    <h6>Guias de Usuário</h6>
                    <p>Documentação detalhada</p>
                  </div>
                </a>
                <a href="#" class="resource-link">
                  <i class="bi bi-book"></i>
                  <div class="link-content">
                    <h6>Base de Conhecimento</h6>
                    <p>Artigos e tutoriais</p>
                  </div>
                </a>
                <a href="#" class="resource-link">
                  <i class="bi bi-tools"></i>
                  <div class="link-content">
                    <h6>Solução de problemas</h6>
                    <p>Problemas comuns e correções</p>
                  </div>
                </a>
              </div>
            </div>
          </div>
          <div class="col-lg-6">
            <div class="faq-section">
              <h4>Perguntas Frequentes</h4>
              <div class="faq-list">
                <div class="faq-item">
                  <h3>
                    Como posso rastrear meu pedido?
                    <i class="bi bi-plus faq-toggle"></i>
                  </h3>
                  <div class="faq-answer">
                    <p>Você pode rastrear seu pedido acessando a área 'Meus Pedidos' no site e clicando em 'Rastrear'. Também enviamos o código de rastreio por e-mail assim que seu pedido é enviado.</p>
                  </div>
                </div>

                <div class="faq-item">
                  <h3>
                    Posso alterar meu endereço de entrega?
                    <i class="bi bi-plus faq-toggle"></i>
                  </h3>
                  <div class="faq-answer">
                    <p>Você pode alterar seu endereço de entrega antes da finalização da compra. Após o pedido ser confirmado, não é possível modificar o endereço.</p>
                  </div>
                </div>

                <div class="faq-item">
                  <h3>
                    Quais métodos de pagamento vocês aceitam? Somente cartão?
                    <i class="bi bi-plus faq-toggle"></i>
                  </h3>
                  <div class="faq-answer">
                    <p>Aceitamos todos os cartões de crédito, débito, Pix e boleto bancário.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>

  </section><!-- /Support Section -->

</main>

<%- include('partials/footer') %>
