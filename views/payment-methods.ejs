<%- include('partials/header') %>

<main class="main">

  <!-- Page Title -->
  <div class="page-title light-background">
    <div class="container d-lg-flex justify-content-between align-items-center">
      <h1 class="mb-2 mb-lg-0">Métodos de pagamento</h1>
      <nav class="breadcrumbs">
        <ol>
          <li><a href="/">Início</a></li>
          <li class="current">Métodos de pagamento</li>
        </ol>
      </nav>
    </div>
  </div><!-- End Page Title -->

  <!-- Paymnt Methods Section -->
  <section id="paymnt-methods" class="paymnt-methods section">

    <div class="container" data-aos="fade-up">
      <!-- Header -->
      <div class="payment-header text-center" data-aos="fade-up">
        <h2>Métodos de pagamento</h2>
        <p>Escolha entre nossas opções de pagamento seguras e convenientes</p>
      </div>

      <!-- Payment Options Grid -->
      <div class="payment-options" data-aos="fade-up" data-aos-delay="100">
        <div class="row g-4">
          <div class="col-md-6 col-lg-4">
            <div class="payment-card credit-card">
              <div class="card-content">
                <div class="icon-box">
                  <i class="bi bi-credit-card"></i>
                </div>
                <h4>Cartões de Crédito/Débito</h4>
                <p>Visa, Mastercard, PayPal</p>
                <div class="accepted-cards">
                  <span class="card-icon visa">Visa</span>
                  <span class="card-icon mastercard">Mastercard</span>
                  <span class="card-icon amex">Pix</span>
                </div>
              </div>
            </div>
          </div>

          <div class="col-md-6 col-lg-4">
            <div class="payment-card paypal">
              <div class="card-content">
                <div class="icon-box">
                  <i class="bi bi-paypal"></i>
                </div>
                <h4>PayPal</h4>
                <p>Pagamentos online rápidos e seguros</p>
                <div class="accepted-cards">
                  <span class="card-icon paypal">PayPal</span>
                </div>
              </div>
            </div>
          </div>

          <div class="col-md-6 col-lg-4">
            <div class="payment-card bank-transfer">
              <div class="card-content">
                <div class="icon-box">
                  <i class="bi bi-bank"></i>
                </div>
                <h4>Boleto Bancário</h4>
                <p>Transferências diretas de banco para banco</p>
                <div class="accepted-cards">
                  <span class="card-icon bank">Banco</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Security Features -->
      <div class="security-features" data-aos="fade-up" data-aos-delay="200">
        <div class="row align-items-center">
          <div class="col-lg-6">
            <div class="security-content">
              <h3>Pagamentos Seguros</h3>
              <p class="subtitle">Sua segurança é nossa maior prioridade</p>
              <ul class="security-list">
                <li>
                  <i class="bi bi-shield-check"></i>
                  <div class="feature-text">
                    <h5>Criptografia SSL</h5>
                    <p>Todas as transações são protegidas com criptografia SSL de 256 bits</p>
                  </div>
                </li>
                <li>
                  <i class="bi bi-lock"></i>
                  <div class="feature-text">
                    <h5>Compatível com PCI</h5>
                    <p>Seguimos rigorosos padrões de segurança PCI DSS</p>
                  </div>
                </li>
                <li>
                  <i class="bi bi-shield-lock"></i>
                  <div class="feature-text">
                    <h5>Proteção contra fraude</h5>
                    <p>Sistemas avançados de detecção e prevenção de fraudes</p>
                  </div>
                </li>
              </ul>
            </div>
          </div>
          <div class="col-lg-6">
            <div class="process-steps">
              <h4>Processo de pagamento</h4>
              <div class="steps-list">
                <div class="step">
                  <div class="step-number">1</div>
                  <div class="step-content">
                    <h5>Escolha a forma de pagamento</h5>
                    <p>Selecione sua opção de pagamento preferida na finalização da compra</p>
                  </div>
                </div>
                <div class="step">
                  <div class="step-number">2</div>
                  <div class="step-content">
                    <h5>Insira os detalhes</h5>
                    <p>Forneça suas informações de pagamento com segurança</p>
                  </div>
                </div>
                <div class="step">
                  <div class="step-number">3</div>
                  <div class="step-content">
                    <h5>Confirmar pagamento</h5>
                    <p>Revise e confirme seus detalhes de pagamento</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="payment-faqs" data-aos="fade-up" data-aos-delay="300">
        <h3>Perguntas frequentes sobre pagamento</h3>
        <div class="faq-grid">
          <div class="faq-item">
            <h3>
              Quando serei cobrado?
              <i class="bi bi-chevron-down faq-toggle"></i>
            </h3>
            <div class="faq-answer">
              <p>Seu pagamento será processado imediatamente após a realização do pedido. A cobrança aparecerá no seu extrato em até 1 a 2 dias úteis.</p>
            </div>
          </div>

          <div class="faq-item">
            <h3>
             É seguro registrar meu cartão?
              <i class="bi bi-chevron-down faq-toggle"></i>
            </h3>
            <div class="faq-answer">
              <p>Sim, usamos criptografia padrão do setor para proteger suas informações de pagamento. Os dados do seu cartão nunca são armazenados em nossos servidores.</p>
            </div>
          </div>

          <div class="faq-item">
            <h3>
              Quais moedas vocês aceitam?
              <i class="bi bi-chevron-down faq-toggle"></i>
            </h3>
            <div class="faq-answer">
              <p>Aceitamos pagamentos em BRL (Real) e em diversas outras moedas internacionais, como USD, EUR e GBP. As opções disponíveis serão exibidas durante a finalização da compra.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Support Section -->
      <div class="payment-support" data-aos="fade-up" data-aos-delay="400">
        <div class="support-content">
          <i class="bi bi-headset"></i>
          <h4>Precisar de ajuda?</h4>
          <p>Nossa equipe de suporte de pagamento está disponível 24 horas por dia, 7 dias por semana para ajudá-lo</p>
          <div class="support-actions">
            <a href="/support" class="btn-primary">
              <i class="bi bi-chat-dots"></i>
             Converse agora
            </a>
            <span class="divider">or</span>
            <a href="#" class="contact-email">
              <i class="bi bi-envelope"></i>
              neofarmasupport@gmail.com
            </a>
          </div>
        </div>
      </div>

    </div>

  </section><!-- /Paymnt Methods Section -->

</main>

<%- include('partials/footer') %>
