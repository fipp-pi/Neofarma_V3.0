    color: #6c757d;
  }

  .register-wizard__hint {
    font-size: 0.82rem;
    color: #495057;
    background: #f8f9fa;
    border: 1px solid #e9ecef;
    border-radius: 10px;
    padding: 0.65rem 0.85rem;
  }

  .register-wizard__password-wrap {
    position: relative;
  }

  .register-wizard__password-wrap .form-control {
    padding-right: 2.75rem;
  }

  .register-wizard__toggle-pw {
    position: absolute;
    right: 0.35rem;
    top: 50%;
    transform: translateY(-50%);
    border: 0;
    background: transparent;
    color: #6c757d;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
  }

  .register-wizard__toggle-pw:hover { color: var(--accent-color); }

  .register-wizard__pw-bar {
    height: 5px;
