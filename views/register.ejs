<%- include('partials/header') %>

<main class="main">

  <div class="page-title light-background">
    <div class="container d-lg-flex justify-content-between align-items-center">
      <h1 class="mb-2 mb-lg-0">Registrar</h1>
      <nav class="breadcrumbs">
        <ol>
          <li><a href="/">Início</a></li>
          <li class="current">Registrar</li>
        </ol>
      </nav>
    </div>
  </div>

  <section id="register" class="register section">
    <div class="container" data-aos="fade-up" data-aos-delay="100">
      <div class="row justify-content-center">
        <div class="col-lg-10">
          <div class="registration-form-wrapper register-wizard">
            <div class="form-header text-center">
              <h2>Crie a sua conta</h2>
              <p class="mb-0">Cadastro rápido em etapas — seus dados ficam protegidos e você acompanha cada passo.</p>
            </div>

            <ol class="register-wizard__steps" id="wizardSteps" aria-label="Etapas do cadastro">
              <li class="register-wizard__step-item is-active" data-step="1">
                <span class="register-wizard__step-num">1</span>
                <span class="register-wizard__step-label">Identificação</span>
              </li>
              <li class="register-wizard__step-item" data-step="2">
                <span class="register-wizard__step-num">2</span>
                <span class="register-wizard__step-label">Segurança</span>
              </li>
              <li class="register-wizard__step-item" data-step="3">
                <span class="register-wizard__step-num">3</span>
                <span class="register-wizard__step-label">Endereço</span>
              </li>
              <li class="register-wizard__step-item" data-step="4">
                <span class="register-wizard__step-num">4</span>
                <span class="register-wizard__step-label">Confirmação</span>
              </li>
            </ol>

            <div class="row">
              <div class="col-lg-10 mx-auto">
                <div id="registerFormAlert" class="alert alert-danger py-2 px-3 small mb-3" role="alert" style="display:none;"></div>

                <form id="formRegister" novalidate autocomplete="off">

                  <!-- Etapa 1 -->
                  <div class="register-wizard__panel" data-step-panel="1">
                    <div class="register-wizard__panel-head">
                      <i class="bi bi-person-vcard"></i>
                      <div>
                        <h3>Dados pessoais</h3>
                        <p>Informe como podemos identificar e contatar você.</p>
                      </div>
                    </div>
                    <div class="row g-3">
                      <div class="col-12">
                        <label for="full_name" class="form-label field-required">Nome completo</label>
                        <input type="text" class="form-control" id="full_name" name="full_name" placeholder="Ex.: Ana Beatriz Ferreira" autocomplete="name">
                        <div class="invalid-feedback" id="full_name_error">Informe o nome completo.</div>
                      </div>
                      <div class="col-md-6">
                        <label for="email" class="form-label field-required">E-mail</label>
                        <input type="email" class="form-control" id="email" name="email" placeholder="seu@email.com" autocomplete="email">
                        <div class="invalid-feedback" id="email_error">Informe um e-mail válido.</div>
                      </div>
                      <div class="col-md-6">
                        <label for="register_phone" class="form-label field-required">Telefone / WhatsApp</label>
                        <input type="tel" class="form-control" id="register_phone" name="phone" placeholder="(00) 00000-0000" maxlength="16" autocomplete="tel" inputmode="numeric">
                        <div class="invalid-feedback" id="register_phone_error">Informe um telefone válido.</div>
                      </div>
                      <div class="col-md-6">
                        <label for="document" class="form-label field-required">CPF</label>
                        <input type="text" class="form-control" id="document" name="document" placeholder="000.000.000-00" maxlength="14" inputmode="numeric" autocomplete="off" required>
                        <div class="invalid-feedback" id="document_error">Informe um CPF válido.</div>
                      </div>
                      <div class="col-md-6">
                        <label for="birth_date" class="form-label">Data de nascimento</label>
                        <input type="date" class="form-control" id="birth_date" name="birth_date" autocomplete="bday">
                        <div class="invalid-feedback" id="birth_date_error">Data inválida.</div>
                      </div>
                    </div>
                    <div class="register-wizard__hint mt-3">
                      <i class="bi bi-shield-check me-1"></i>
                      Seus dados são utilizados apenas para identificação da conta e entrega de pedidos.
                    </div>
                  </div>

                  <!-- Etapa 2 -->
                  <div class="register-wizard__panel d-none" data-step-panel="2">
                    <div class="register-wizard__panel-head">
                      <i class="bi bi-lock"></i>
                      <div>
                        <h3>Segurança da conta</h3>
                        <p>Defina uma senha forte para proteger seu acesso.</p>
                      </div>
                    </div>
                    <div class="row g-3">
                      <div class="col-md-6">
                        <label for="password" class="form-label field-required">Senha</label>
                        <div class="register-wizard__password-wrap">
                          <input type="password" class="form-control" id="password" name="password" placeholder="Mínimo 6 caracteres" autocomplete="new-password">
                          <button type="button" class="register-wizard__toggle-pw" data-target="password" aria-label="Mostrar senha"><i class="bi bi-eye"></i></button>
                        </div>
                        <div class="invalid-feedback" id="password_error">Informe uma senha válida.</div>
                        <div class="register-wizard__pw-strength mt-2">
                          <div class="register-wizard__pw-bar"><span id="pwStrengthBar"></span></div>
                          <small id="pwStrengthLabel" class="text-muted">Use letras, números e símbolos para maior segurança.</small>
                        </div>
                      </div>
                      <div class="col-md-6">
                        <label for="confirmPassword" class="form-label field-required">Confirmar senha</label>
                        <div class="register-wizard__password-wrap">
                          <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" placeholder="Repita a senha" autocomplete="new-password">
                          <button type="button" class="register-wizard__toggle-pw" data-target="confirmPassword" aria-label="Mostrar confirmação"><i class="bi bi-eye"></i></button>
                        </div>
                        <div class="invalid-feedback" id="confirmPassword_error">As senhas devem coincidir.</div>
                      </div>
                    </div>
                    <ul class="register-wizard__pw-rules mt-3" id="pwRules">
                      <li data-rule="len"><i class="bi bi-circle"></i> Mínimo 6 caracteres</li>
                      <li data-rule="letter"><i class="bi bi-circle"></i> Pelo menos uma letra</li>
                      <li data-rule="number"><i class="bi bi-circle"></i> Pelo menos um número</li>
                    </ul>
                  </div>

                  <!-- Etapa 3 -->
                  <div class="register-wizard__panel d-none" data-step-panel="3">
                    <div class="register-wizard__panel-head">
                      <i class="bi bi-geo-alt"></i>
                      <div>
                        <h3>Endereço de entrega</h3>
                        <p>Informe o CEP para preenchermos logradouro, bairro, cidade e UF automaticamente.</p>
                      </div>
                    </div>
                    <div class="row g-3">
                      <div class="col-md-4">
                        <label for="country" class="form-label">País</label>
                        <select class="form-select" id="country" name="country">
                          <option value="Brasil" selected>Brasil</option>
                          <option value="Portugal">Portugal</option>
                          <option value="Estados Unidos">Estados Unidos</option>
                          <option value="Outro">Outro</option>
                        </select>
                      </div>
                      <div class="col-md-4">
                        <label for="cep" class="form-label field-required">CEP</label>
                        <div class="register-wizard__cep-wrap">
                          <input type="text" class="form-control" id="cep" name="cep" placeholder="00000-000" maxlength="9" autocomplete="postal-code" inputmode="numeric">
                          <span class="register-wizard__cep-spinner d-none" id="cepSpinner"><span class="spinner-border spinner-border-sm"></span></span>
                        </div>
                        <div class="invalid-feedback" id="cep_error">Informe um CEP válido.</div>
                      </div>
                      <div class="col-md-4 d-flex align-items-end">
                        <a href="https://buscacepinter.correios.com.br/app/endereco/index.php" class="small text-decoration-none" target="_blank" rel="noopener">Não sei meu CEP</a>
                      </div>
                      <div class="col-12">
                        <label for="street" class="form-label field-required">Rua / Logradouro</label>
                        <input type="text" class="form-control" id="street" name="street" placeholder="Preenchido automaticamente pelo CEP" autocomplete="address-line1">
                        <div class="invalid-feedback" id="street_error">Informe o logradouro.</div>
                      </div>
                      <div class="col-md-3">
                        <label for="number" class="form-label field-required">Número</label>
                        <input type="text" class="form-control" id="number" name="number" placeholder="Nº" autocomplete="off">
                        <div class="invalid-feedback" id="number_error">Informe o número.</div>
                      </div>
                      <div class="col-md-4">
                        <label for="complement" class="form-label">Complemento</label>
                        <input type="text" class="form-control" id="complement" name="complement" placeholder="Apto, bloco, etc." autocomplete="off">
                      </div>
                      <div class="col-md-5">
                        <label for="district" class="form-label field-required">Bairro</label>
                        <input type="text" class="form-control" id="district" name="district" placeholder="Preenchido pelo CEP" autocomplete="address-level2">
                        <div class="invalid-feedback" id="district_error">Informe o bairro.</div>
                      </div>
                      <div class="col-md-8">
                        <label for="city" class="form-label field-required">Cidade</label>
                        <input type="text" class="form-control" id="city" name="city" placeholder="Preenchido pelo CEP" autocomplete="address-level2">
                        <div class="invalid-feedback" id="city_error">Informe a cidade.</div>
                      </div>
                      <div class="col-md-4">
                        <label for="state" class="form-label field-required">UF</label>
                        <input type="text" class="form-control" id="state" name="state" placeholder="SP" maxlength="2" autocomplete="address-level1">
                        <div class="invalid-feedback" id="state_error">Informe a UF.</div>
                      </div>
                    </div>
                  </div>

                  <!-- Etapa 4 -->
                  <div class="register-wizard__panel d-none" data-step-panel="4">
                    <div class="register-wizard__panel-head">
                      <i class="bi bi-check2-circle"></i>
                      <div>
                        <h3>Revise e confirme</h3>
                        <p>Confira os dados antes de finalizar o cadastro.</p>
                      </div>
                    </div>

                    <div class="register-wizard__review" id="reviewSummary"></div>

                    <div class="register-wizard__terms mt-4">
                      <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="termsCheck" name="termsCheck">
                        <label class="form-check-label" for="termsCheck">
                          Li e concordo com os <a href="/tos" target="_blank">Termos de Serviço</a> e a <a href="/privacy" target="_blank">Política de Privacidade</a> <span class="text-danger">*</span>
                        </label>
                        <div class="invalid-feedback" id="termsCheck_error">Você precisa aceitar os termos para continuar.</div>
                      </div>
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="marketingCheck" name="marketingCheck">
                        <label class="form-check-label" for="marketingCheck">
                          Quero receber ofertas e novidades por e-mail
                        </label>
                      </div>
                    </div>
                  </div>

                  <div class="register-wizard__nav">
                    <button type="button" class="btn btn-outline-secondary" id="btnWizardPrev" disabled>
                      <i class="bi bi-arrow-left me-1"></i> Voltar
                    </button>
                    <button type="button" class="btn btn-register" id="btnWizardNext">
                      Continuar <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                    <button type="button" class="btn btn-register d-none" id="btnCriarConta">
                      <i class="bi bi-check-lg me-1"></i> Criar conta
                    </button>
                  </div>

                  <div class="login-link text-center mt-4">
                    <p class="mb-0">Já possui uma conta? <a href="/login">Entrar</a></p>
                  </div>
                </form>
              </div>
            </div>

            <div class="decorative-elements">
              <div class="circle circle-1"></div>
              <div class="circle circle-2"></div>
              <div class="circle circle-3"></div>
              <div class="square square-1"></div>
              <div class="square square-2"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</main>

<style>
  .register-wizard .form-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: #495057;
    margin-bottom: 0.35rem;
  }

  .register-wizard .form-control,
  .register-wizard .form-select {
    border-radius: 10px;
    border-color: #dee2e6;
    font-size: 0.92rem;
    padding: 0.65rem 0.85rem;
  }

  .register-wizard .form-control:focus,
  .register-wizard .form-select:focus {
    border-color: var(--accent-color);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-color), transparent 88%);
  }

  .field-required::after { content: ' *'; color: #dc3545; font-weight: 600; }

  .register-wizard .form-control.is-invalid,
  .register-wizard .form-select.is-invalid,
  .register-wizard .form-check-input.is-invalid {
    border-color: #dc3545;
    box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.12);
  }

  .register-wizard .invalid-feedback { display: none; font-size: 0.8rem; }
  .register-wizard .form-control.is-invalid ~ .invalid-feedback,
  .register-wizard .form-select.is-invalid ~ .invalid-feedback { display: block; }

  .register-wizard__steps {
    list-style: none;
    display: flex;
    gap: 0.5rem;
    padding: 0;
    margin: 1.75rem 0 1.5rem;
    counter-reset: wizard;
  }

  .register-wizard__step-item {
    flex: 1;
    text-align: center;
    position: relative;
    opacity: 0.55;
    transition: opacity 0.2s ease;
  }

  .register-wizard__step-item.is-active,
  .register-wizard__step-item.is-done {
    opacity: 1;
  }

  .register-wizard__step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #e9ecef;
    color: #6c757d;
    font-weight: 700;
    font-size: 0.9rem;
    margin-bottom: 0.35rem;
    transition: all 0.2s ease;
  }

  .register-wizard__step-item.is-active .register-wizard__step-num,
  .register-wizard__step-item.is-done .register-wizard__step-num {
    background: var(--accent-color);
    color: var(--contrast-color);
  }

  .register-wizard__step-label {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #6c757d;
  }

  .register-wizard__step-item.is-active .register-wizard__step-label {
    color: var(--heading-color);
  }

  .register-wizard__panel {
