  }

  .register-wizard__review-card h4 {
    margin: 0 0 0.5rem;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--accent-color);
  }

  .register-wizard__review-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.88rem;
    padding: 0.2rem 0;
  }

  .register-wizard__review-row span:first-child { color: #6c757d; }
  .register-wizard__review-row span:last-child { font-weight: 500; text-align: right; word-break: break-word; }

  .register-wizard__nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .register-wizard__nav .btn-register {
    min-width: 150px;
  }

  #registerFormAlert:empty { display: none !important; }

  @media (max-width: 767.98px) {
    .register-wizard__steps {
      flex-wrap: wrap;
    }
    .register-wizard__step-item {
      flex: 1 1 45%;
    }
    .register-wizard__step-label {
      font-size: 0.65rem;
    }
    .register-wizard__nav {
      flex-wrap: wrap;
    }
    .register-wizard__nav .btn {
      flex: 1 1 auto;
    }
  }
</style>

<script>
(function () {
  var TOTAL_STEPS = 4;
  var currentStep = 1;
  var cepLoading = false;
  var isSubmitting = false;
  var registerSucceeded = false;

  var FIELD_IDS = [
    'full_name', 'email', 'register_phone', 'document', 'birth_date',
    'password', 'confirmPassword',
    'cep', 'street', 'number', 'district', 'city', 'state', 'termsCheck'
  ];

  var FIELD_STEPS = {
    full_name: 1, email: 1, register_phone: 1, phone: 1, document: 1, birth_date: 1,
    password: 2, confirmPassword: 2,
    cep: 3, street: 3, number: 3, district: 3, city: 3, state: 3,
    termsCheck: 4
  };

  function $(id) { return document.getElementById(id); }

  function stripDigits(v) { return String(v || '').replace(/\D/g, ''); }

  function formatCpf(v) {
    var d = stripDigits(v).slice(0, 11);
    if (d.length <= 3) return d;
    if (d.length <= 6) return d.slice(0, 3) + '.' + d.slice(3);
    if (d.length <= 9) return d.slice(0, 3) + '.' + d.slice(3, 6) + '.' + d.slice(6);
    return d.slice(0, 3) + '.' + d.slice(3, 6) + '.' + d.slice(6, 9) + '-' + d.slice(9);
  }

  function formatPhone(v) {
    var d = stripDigits(v).slice(0, 11);
    if (d.length <= 2) return d.length ? '(' + d : '';
    if (d.length <= 6) return '(' + d.slice(0, 2) + ') ' + d.slice(2);
    if (d.length <= 10) return '(' + d.slice(0, 2) + ') ' + d.slice(2, 6) + '-' + d.slice(6);
    return '(' + d.slice(0, 2) + ') ' + d.slice(2, 7) + '-' + d.slice(7);
  }

  function formatCep(v) {
    var d = stripDigits(v).slice(0, 8);
    if (d.length <= 5) return d;
    return d.slice(0, 5) + '-' + d.slice(5);
  }

  function validarCpf(digits) {
    if (digits.length !== 11) return false;
    if (/^(\d)\1+$/.test(digits)) return false;
    var sum = 0, i, d1, d2;
    for (i = 0; i < 9; i++) sum += parseInt(digits[i], 10) * (10 - i);
    d1 = (sum * 10) % 11;
    if (d1 === 10) d1 = 0;
    if (d1 !== parseInt(digits[9], 10)) return false;
    sum = 0;
    for (i = 0; i < 10; i++) sum += parseInt(digits[i], 10) * (11 - i);
    d2 = (sum * 10) % 11;
    if (d2 === 10) d2 = 0;
    return d2 === parseInt(digits[10], 10);
  }

  function setFormAlert(message) {
    var el = $('registerFormAlert');
    if (!el) return;
    if (!message) { el.style.display = 'none'; el.textContent = ''; return; }
    el.style.display = 'block';
    el.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> ' + message;
  }

  function setFieldError(fieldId, message) {
    var input = $(fieldId);
    var err = $(fieldId + '_error');
    if (input) input.classList.add('is-invalid');
    if (err && message) {
      err.textContent = message;
      err.style.display = 'block';
    }
  }

  function clearFieldError(fieldId) {
    var input = $(fieldId);
    var err = $(fieldId + '_error');
    if (input) input.classList.remove('is-invalid');
    if (err) err.style.display = 'none';
  }

  function clearAllErrors() {
    setFormAlert('');
    FIELD_IDS.forEach(clearFieldError);
  }

  function applyFieldErrors(fields) {
    if (!fields) return;
    Object.keys(fields).forEach(function (key) {
      setFieldError(key, fields[key]);
    });
  }

  function validateStep(step) {
    var errors = {};

    if (step === 1) {
      var nome = $('full_name').value.trim();
      var email = $('email').value.trim();
      var phoneDigits = stripDigits($('register_phone').value);
      var cpfDigits = stripDigits($('document').value);
      var birthDate = $('birth_date').value;

      if (!nome) errors.full_name = 'Informe o nome completo.';
      else if (nome.length < 3) errors.full_name = 'O nome deve ter pelo menos 3 caracteres.';
      else if (!/\s/.test(nome)) errors.full_name = 'Informe nome e sobrenome.';

      if (!email) errors.email = 'Informe o e-mail.';
      else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) errors.email = 'Informe um e-mail válido.';

      if (!phoneDigits) errors.register_phone = 'Informe o telefone.';
      else if (phoneDigits.length < 10) errors.register_phone = 'Informe um telefone válido (mínimo 10 dígitos).';

      if (!cpfDigits) errors.document = 'Informe o CPF.';
      else if (cpfDigits.length !== 11) errors.document = 'O CPF deve conter 11 dígitos.';
      else if (!validarCpf(cpfDigits)) errors.document = 'CPF inválido — verifique os dígitos verificadores.';

      if (birthDate) {
        var today = new Date();
        today.setHours(0, 0, 0, 0);
        var bd = new Date(birthDate + 'T00:00:00');
        if (bd > today) errors.birth_date = 'A data de nascimento não pode ser futura.';
      }
    }

    if (step === 2) {
      var senha = $('password').value;
      var confirmar = $('confirmPassword').value;
      if (!senha) errors.password = 'Informe a senha de acesso.';
      else if (senha.length < 6) errors.password = 'A senha deve ter no mínimo 6 caracteres.';
      if (!confirmar) errors.confirmPassword = 'Confirme a senha de acesso.';
      else if (senha !== confirmar) errors.confirmPassword = 'As senhas não coincidem.';
    }

    if (step === 3) {
      var cepDigits = stripDigits($('cep').value);
      var rua = $('street').value.trim();
      var numero = $('number').value.trim();
      var bairro = $('district').value.trim();
      var cidade = $('city').value.trim();
      var estado = $('state').value.trim().toUpperCase();
      $('state').value = estado;

      if (!cepDigits) errors.cep = 'Informe o CEP do endereço.';
      else if (cepDigits.length !== 8) errors.cep = 'Informe um CEP válido (8 dígitos).';
      if (!rua) errors.street = 'Informe o logradouro.';
      if (!numero) errors.number = 'Informe o número do endereço.';
      if (!bairro) errors.district = 'Informe o bairro.';
      if (!cidade) errors.city = 'Informe a cidade.';
      if (!estado || estado.length !== 2) errors.state = 'Informe a UF com 2 letras.';
    }

    if (step === 4) {
      if (!$('termsCheck').checked) {
        errors.termsCheck = 'Você precisa aceitar os termos para continuar.';
      }
    }

    var keys = Object.keys(errors);
    if (keys.length) {
      applyFieldErrors(errors);
      setFormAlert('Revise os campos destacados antes de continuar.');
      var first = $(keys[0]);
      if (first) {
        first.focus();
        first.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      if (window.neofarmaToast) window.neofarmaToast('Preencha os campos obrigatórios corretamente.', 'warning');
      return false;
    }
    return true;
  }

  function updatePasswordStrength() {
    var pwd = $('password').value || '';
    var bar = $('pwStrengthBar');
    var label = $('pwStrengthLabel');
    var rules = document.querySelectorAll('#pwRules li');
    var score = 0;
    var hasLen = pwd.length >= 6;
    var hasLetter = /[A-Za-z]/.test(pwd);
    var hasNumber = /\d/.test(pwd);
    var hasSpecial = /[^A-Za-z0-9]/.test(pwd);

    if (hasLen) score++;
    if (hasLetter) score++;
    if (hasNumber) score++;
    if (hasSpecial) score++;
    if (pwd.length >= 10) score++;

    rules.forEach(function (li) {
      var rule = li.getAttribute('data-rule');
      var ok = (rule === 'len' && hasLen) || (rule === 'letter' && hasLetter) || (rule === 'number' && hasNumber);
      li.classList.toggle('is-ok', ok);
    });

    var pct = Math.min(100, score * 20);
    var color = '#dc3545';
    var text = 'Senha fraca';
    if (score >= 4) { color = '#198754'; text = 'Senha forte'; }
    else if (score >= 3) { color = '#fd7e14'; text = 'Senha boa'; }
    else if (score >= 2) { color = '#ffc107'; text = 'Senha razoável'; }

    if (bar) {
      bar.style.width = pwd ? pct + '%' : '0%';
      bar.style.background = color;
    }
    if (label) label.textContent = pwd ? text : 'Use letras, números e símbolos para maior segurança.';
  }

  function buildReview() {
    var cpf = $('document').value.trim();
    var birth = $('birth_date').value;
    var birthLabel = birth
      ? (window.NeoDates && NeoDates.formatDate ? NeoDates.formatDate(birth) : birth.split('-').reverse().join('/'))
      : '—';

    var html = '';
    html += '<div class="register-wizard__review-card"><h4>Identificação</h4>';
    html += reviewRow('Nome', $('full_name').value.trim());
    html += reviewRow('E-mail', $('email').value.trim());
    html += reviewRow('Telefone', $('register_phone').value.trim());
    html += reviewRow('CPF', cpf);
    html += reviewRow('Nascimento', birthLabel);
    html += '</div>';

    html += '<div class="register-wizard__review-card"><h4>Endereço</h4>';
    html += reviewRow('CEP', $('cep').value.trim());
    html += reviewRow('Logradouro', $('street').value.trim() + ', ' + $('number').value.trim());
    html += reviewRow('Complemento', $('complement').value.trim() || '—');
    html += reviewRow('Bairro', $('district').value.trim());
    html += reviewRow('Cidade/UF', $('city').value.trim() + ' / ' + $('state').value.trim().toUpperCase());
    html += reviewRow('País', $('country').value);
    html += '</div>';

    $('reviewSummary').innerHTML = html;
  }

  function reviewRow(label, value) {
    return '<div class="register-wizard__review-row"><span>' + label + '</span><span>' + escapeHtml(value) + '</span></div>';
  }

  function escapeHtml(v) {
    return String(v || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function goToStep(step) {
    currentStep = step;
    document.querySelectorAll('[data-step-panel]').forEach(function (panel) {
      panel.classList.toggle('d-none', Number(panel.getAttribute('data-step-panel')) !== step);
    });
    document.querySelectorAll('.register-wizard__step-item').forEach(function (item) {
      var n = Number(item.getAttribute('data-step'));
      item.classList.toggle('is-active', n === step);
      item.classList.toggle('is-done', n < step);
    });
    var prev = $('btnWizardPrev');
    var next = $('btnWizardNext');
    var submit = $('btnCriarConta');
    if (prev) prev.disabled = step === 1;
    if (next) next.classList.toggle('d-none', step === TOTAL_STEPS);
    if (submit) submit.classList.toggle('d-none', step !== TOTAL_STEPS);
    setFormAlert('');
    if (step === TOTAL_STEPS) buildReview();
    var formEl = document.getElementById('formRegister');
    if (formEl) {
      window.scrollTo({ top: Math.max(0, formEl.offsetTop - 80), behavior: 'smooth' });
    }
  }

  function firstStepForField(fieldKey) {
    return FIELD_STEPS[fieldKey] || 1;
  }

  function buscarCep() {
    var cep = stripDigits($('cep').value);
    if (cep.length !== 8 || cepLoading) return;
    cepLoading = true;
    $('cepSpinner').classList.remove('d-none');
    clearFieldError('cep');
    $('street').placeholder = 'Buscando endereço...';

    fetch('https://viacep.com.br/ws/' + cep + '/json/')
      .then(function (r) { return r.json(); })
      .then(function (data) {
        cepLoading = false;
        $('cepSpinner').classList.add('d-none');
        $('street').placeholder = 'Preenchido automaticamente pelo CEP';
        if (data.erro) {
          setFieldError('cep', 'CEP não encontrado. Verifique o número informado.');
          return;
        }
        if (data.logradouro) $('street').value = data.logradouro;
        if (data.bairro) $('district').value = data.bairro;
        if (data.localidade) $('city').value = data.localidade;
        if (data.uf) $('state').value = data.uf;
        ['street', 'district', 'city', 'state'].forEach(clearFieldError);
        $('number').focus();
      })
      .catch(function () {
        cepLoading = false;
        $('cepSpinner').classList.add('d-none');
        $('street').placeholder = 'Preenchido automaticamente pelo CEP';
        setFieldError('cep', 'Não foi possível consultar o CEP. Tente novamente.');
      });
  }

  function handleRegisterSuccess(result) {
    if (registerSucceeded) return;
    registerSucceeded = true;

    var message = (result.data && result.data.message) || 'Conta criada com sucesso! Faça login com seu e-mail e senha.';
    var redirect = (result.data && result.data.redirect) || '/login';
    var emailEl = document.getElementById('email');
    var emailValue = emailEl ? emailEl.value.trim().toLowerCase() : '';

    try {
      sessionStorage.setItem('loginFlash', JSON.stringify({
        type: 'success',
        message: message,
        email: emailValue
      }));
    } catch (storageErr) { /* ignore */ }

    try {
      if (typeof window.neofarmaToast === 'function') {
        window.neofarmaToast(message, 'success');
      }
    } catch (toastErr) { /* ignore */ }

    try {
      window.location.replace(redirect);
    } catch (navErr) {
      window.location.href = redirect;
    }
  }

  function handleRegisterFailure(result) {
    if (registerSucceeded) return;
    isSubmitting = false;
    var btn = $('btnCriarConta');
    if (btn) {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-check-lg me-1"></i> Criar conta';
    }

    try {
      if (result.data && result.data.fields) {
        applyFieldErrors(result.data.fields);
        var firstKey = Object.keys(result.data.fields)[0];
        goToStep(firstStepForField(firstKey));
        setFormAlert(result.data.message || 'Revise os campos destacados.');
      } else if (result.status === 409) {
        setFormAlert(result.data && result.data.message
          ? result.data.message
          : 'Esta conta já foi criada. Faça login com seu e-mail e senha.');
        goToStep(1);
        if (result.data && result.data.fields) applyFieldErrors(result.data.fields);
      } else {
        setFormAlert((result.data && result.data.message) || 'Não foi possível concluir o cadastro.');
      }

      if (typeof window.neofarmaToast === 'function') {
        window.neofarmaToast(
          (result.data && result.data.message) || 'Erro ao cadastrar.',
          result.status === 409 ? 'warning' : 'danger'
        );
      }
    } catch (uiErr) {
      if (typeof console !== 'undefined' && console.error) console.error('Erro ao exibir falha de cadastro:', uiErr);
      setFormAlert((result.data && result.data.message) || 'Não foi possível concluir o cadastro.');
    }
  }

  function readRegisterResponse(response) {
    if (response.status === 201) {
      return response.json().catch(function () {
        return { ok: true, redirect: '/login', message: 'Conta criada com sucesso! Você já pode fazer login.' };
      }).then(function (data) {
        return { status: response.status, okHttp: true, data: data };
      });
    }

    return response.text().then(function (raw) {
      var data = null;
      if (raw) {
        try { data = JSON.parse(raw); } catch (_) { data = null; }
      }
      return {
        status: response.status,
        okHttp: response.ok,
        data: data,
        raw: raw || ''
      };
    });
  }

  function submitRegistration() {
    if (isSubmitting || registerSucceeded) return;

    for (var s = 1; s <= TOTAL_STEPS; s++) {
      if (!validateStep(s)) {
        goToStep(s);
        return;
      }
    }

    isSubmitting = true;
    var btn = $('btnCriarConta');
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Criando conta...';
    }
    setFormAlert('');

    fetch('/register', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(buildPayload())
    })
      .then(readRegisterResponse)
      .then(function (result) {
        if (result.status === 201 || (result.data && result.data.ok === true)) {
          handleRegisterSuccess(result);
          return;
        }
        handleRegisterFailure(result);
      })
      .catch(function (err) {
        if (registerSucceeded) return;
        isSubmitting = false;
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = '<i class="bi bi-check-lg me-1"></i> Criar conta';
        }

        if (typeof console !== 'undefined' && console.error) {
          console.error('Falha no cadastro (register fetch):', err);
        }

        setFormAlert('Não foi possível confirmar o cadastro agora. Se a conta foi criada, acesse a página de login. Caso contrário, tente novamente.');
        if (typeof window.neofarmaToast === 'function') {
          window.neofarmaToast('Falha na confirmação. Verifique se consegue fazer login.', 'warning');
        }
      });
  }

  function buildPayload() {
    var cpfRaw = stripDigits($('document').value);
    return {
      full_name: $('full_name').value.trim(),
      email: $('email').value.trim().toLowerCase(),
      password: $('password').value,
      confirmPassword: $('confirmPassword').value,
      document: cpfRaw,
      phone: $('register_phone').value.trim(),
      birth_date: ($('birth_date').value || '').trim() || null,
      country: $('country').value,
      cep: stripDigits($('cep').value),
      street: $('street').value.trim(),
      number: $('number').value.trim(),
      complement: ($('complement').value || '').trim() || null,
      district: $('district').value.trim(),
      city: $('city').value.trim(),
      state: $('state').value.trim().toUpperCase()
    };
  }

  $('btnWizardNext').addEventListener('click', function () {
    if (!validateStep(currentStep)) return;
    goToStep(Math.min(TOTAL_STEPS, currentStep + 1));
  });

  $('btnWizardPrev').addEventListener('click', function () {
    goToStep(Math.max(1, currentStep - 1));
  });

  $('document').addEventListener('input', function () {
    this.value = formatCpf(this.value);
    clearFieldError('document');
    setFormAlert('');
  });

  $('register_phone').addEventListener('input', function () {
    this.value = formatPhone(this.value);
    clearFieldError('register_phone');
    setFormAlert('');
  });

  $('cep').addEventListener('input', function () {
    this.value = formatCep(this.value);
    clearFieldError('cep');
    setFormAlert('');
    if (stripDigits(this.value).length === 8) buscarCep();
  });

  $('state').addEventListener('input', function () {
    this.value = this.value.replace(/[^a-zA-Z]/g, '').toUpperCase().slice(0, 2);
    clearFieldError('state');
  });

  $('password').addEventListener('input', function () {
    updatePasswordStrength();
    clearFieldError('password');
    clearFieldError('confirmPassword');
    setFormAlert('');
  });

  $('confirmPassword').addEventListener('input', function () {
    clearFieldError('confirmPassword');
    setFormAlert('');
  });

  $('termsCheck').addEventListener('change', function () {
    this.classList.remove('is-invalid');
    var termsErr = $('termsCheck_error');
    if (termsErr) termsErr.style.display = 'none';
    setFormAlert('');
  });

  FIELD_IDS.forEach(function (id) {
    var el = $(id);
    if (!el || id === 'termsCheck') return;
    el.addEventListener('input', function () { clearFieldError(id); setFormAlert(''); });
    el.addEventListener('change', function () { clearFieldError(id); setFormAlert(''); });
  });

  document.querySelectorAll('.register-wizard__toggle-pw').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var target = $(btn.getAttribute('data-target'));
      if (!target) return;
      var isText = target.type === 'text';
      target.type = isText ? 'password' : 'text';
      btn.innerHTML = isText ? '<i class="bi bi-eye"></i>' : '<i class="bi bi-eye-slash"></i>';
    });
  });

  $('btnCriarConta').addEventListener('click', submitRegistration);

  $('formRegister').addEventListener('submit', function (e) {
    e.preventDefault();
    if (currentStep === TOTAL_STEPS) submitRegistration();
  });

  updatePasswordStrength();
})();
</script>

<%- include('partials/footer') %>
