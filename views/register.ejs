  }

  .register-wizard__panel-head {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    margin-bottom: 1.25rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .register-wizard__panel-head > i {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--accent-color), transparent 88%);
    color: var(--accent-color);
    font-size: 1.15rem;
    flex-shrink: 0;
  }

  .register-wizard__panel-head h3 {
    margin: 0 0 0.15rem;
    font-size: 1.05rem;
